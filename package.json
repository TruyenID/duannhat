{
  "name": "tempo-monorepo",
  "private": true,
  "description": "TempoFast umbrella — docker stack + omnify codegen for backend/admin-web submodules",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "omnify": "omnify",
    "omnify:gen": "npm run omnify:check && omnify generate",
    "omnify:reset": "npm run omnify:check && omnify reset -y",
    "omnify:diff": "npm run omnify:check && omnify diff",
    "omnify:drift": "node scripts/check-omnify-drift.mjs",
    "install:all": "pnpm install && cd web/admin && pnpm install && cd ../customer && pnpm install && cd ../pos && pnpm install",
    "lint": "pnpm lint:admin && pnpm lint:customer && pnpm lint:pos",
    "lint:admin": "cd web/admin && pnpm lint",
    "lint:customer": "cd web/customer && pnpm lint",
    "lint:pos": "cd web/pos && pnpm lint",
    "typecheck": "pnpm typecheck:admin && pnpm typecheck:customer && pnpm typecheck:pos",
    "typecheck:admin": "cd web/admin && pnpm typecheck",
    "typecheck:customer": "cd web/customer && npx tsc --noEmit",
    "typecheck:pos": "cd web/pos && npx tsc --noEmit",
    "build": "pnpm build:admin && pnpm build:customer && pnpm build:pos",
    "build:admin": "cd web/admin && pnpm build",
    "build:customer": "cd web/customer && pnpm build",
    "build:pos": "cd web/pos && pnpm build",
    "dev": "concurrently -n admin,customer,pos -c blue,green,magenta \"pnpm dev:admin\" \"pnpm dev:customer\" \"pnpm dev:pos\"",
    "dev:admin": "cd web/admin && pnpm install && pnpm dev",
    "dev:customer": "cd web/customer && pnpm install && pnpm dev",
    "dev:pos": "cd web/pos && pnpm install && pnpm dev",
    "omnify:check": "node scripts/check-omnify-version.mjs",
    "test:omnify-check": "node --test scripts/check-omnify-version.test.mjs",
    "test:omnify-drift": "node --test scripts/check-omnify-drift.test.mjs",
    "test:omnify-ci": "node --test scripts/check-omnify-ci-workflow.test.mjs",
    "test:backend-tests-ci": "node --test scripts/check-backend-tests-workflow.test.mjs",
    "test:version": "node --test scripts/version-single-source.test.mjs",
    "test:version-fleet": "node --test scripts/version-tracks-workstation.test.mjs",
    "test:ws-exempt-not-in-binary": "node --test scripts/workstation-exempt-files-are-not-in-the-binary.test.mjs",
    "test:gate-paths": "node --test scripts/gate-paths-cover-its-guards.test.mjs",
    "test:release-gate": "node --test scripts/release-publish-gate.test.mjs",
    "test:version-drift": "python3 .github/scripts/warn-workstation-version-drift.py --self-test",
    "test:fonts": "node --test scripts/fonts-are-self-hosted.test.mjs",
    "test:parallel-gate": "node --test scripts/backend-tests-run-in-parallel.test.mjs",
    "test:ws-manifest": "node --test scripts/workstation-manifest-keeps-history.test.mjs",
    "test:ws-manifest-restore": "node --test scripts/workstation-manifest-restore.test.mjs",
    "test:ws-publish": "node --test scripts/workstation-publish-script-runs.test.mjs",
    "test:workflows-parse": "node --test scripts/workflows-parse.test.mjs",
    "test:buildspecs-uploaded": "node --test scripts/buildspecs-are-uploaded.test.mjs",
    "test:deploy-smoke": "node --test scripts/deploy-smoke-checks-the-bundle.test.mjs",
    "test:deploy-ssh": "node --test scripts/deploy-ssh-steps-carry-credentials.test.mjs",
    "test:ws-expected": "node --test scripts/workstation-expected-version-reaches-deploy.test.mjs",
    "test:deploy-hours": "node --test scripts/deploy-service-hours-guard.test.mjs",
    "test:self-hosted": "node --test scripts/workflows-use-self-hosted.test.mjs",
    "test:pnpm-setup": "node --test scripts/pnpm-setup-is-job-local.test.mjs",
    "test:app-gates": "node --test scripts/every-app-has-a-gate.test.mjs",
    "test:ws-feed-caps": "node --test scripts/workstation-feeds-declare-their-cap.test.mjs",
    "test:hooks": "bash .githooks/commit-msg_test.sh .githooks/commit-msg && bash .githooks/pre-push_test.sh .githooks/pre-push",
    "test:no-pinned-symlinks": "node --test scripts/no-machine-pinned-symlinks.test.mjs",
    "test:version-forward": "node --test scripts/version-never-goes-backwards.test.mjs",
    "test:promote-gate": "node --test scripts/promote-no-silent-deletions.test.mjs",
    "test:ws-frontend-ui": "node --test scripts/workstation-frontend-godx-ui-only.test.mjs"
  },
  "devDependencies": {
    "@omnifyjp/omnify": "^6.0.5",
    "concurrently": "^9.1.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "version": "0.8.35"
}
