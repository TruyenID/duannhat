# Backend API base URL (godx-tempo Laravel, Docker → localhost:5400)
VITE_API_URL=http://localhost:5400

# SSO — shares config with admin-web. "tempo-dev" is the dev console service
# INSTANCE whose credentials the platform DevSeeder fixes; reusing it means a
# cashier with a tempo account logs into the POS without separate provisioning.
VITE_CONSOLE_URL=https://dev-console.godx.jp
VITE_SSO_SERVICE_SLUG=tempo-dev

# Default locale (ja | en | vi)
VITE_DEFAULT_LOCALE=vi

# Shop slug for /api/v1/shops/{shopSlug}/... endpoints
VITE_SHOP_SLUG=sjk

# =========================================================================
# Workstation LAN (plan-030 print + plan-038 bill / KDS / debt / VAT)
# =========================================================================
# LAN address of the workstation-app (Go + Wails) running on the shop's
# local PC. `VITE_WORKSTATION_API_URL` is the canonical and only variable
# read by `src/services/workstation/base-url-resolver.ts`.
#
# In development, an empty value falls back to http://localhost:8080. Set
# `none` for a cloud deployment with no workstation; then
# `workstationPrintService.enabled === false` and print UI gracefully hides.
#
# Plan-038 endpoints reachable via this URL once set:
#   POST /api/lan/print/kitchen-ticket   — fire kitchen tickets
#   POST /api/lan/print/payment-receipt  — PAID + remaining slip
#   POST /api/lan/print/debt-slip        — PHIEU GHI NO
#   POST /api/lan/print/red-invoice      — HOA DON DO (paid slip + named buyer)
#   GET  /api/lan/print/status           — printer-role probe
#   WS   /ws?since=<RFC3339>             — KDS realtime backfill
#
# REMOVED: POST /api/lan/print/vat-invoice — deleted in workstation-app
# a7c0655 (#1779, 2026-08-04) together with the customer_invoices mirror. The
# red invoice is PRINTED, never stored, so there is nothing left to "issue then
# print" — use /api/lan/print/red-invoice. Full list of the nine live LAN print
# routes: pos-web CLAUDE.md § Bill printing (plan-038).
#
# Example: http://192.168.1.50:8080  or  http://workstation.local:8080
VITE_WORKSTATION_API_URL=

# Hard-pin the POS API target: auto | workstation | cloud. When set, this
# overrides the in-app Settings toggle (localStorage `pos_api_mode`). Cloud
# does NOT serve /pos/* for device tokens (401 UNAUTHENTICATED), so a single
# workstation blip flipping auto-mode to Cloud becomes a wall of 401s — pin
# `workstation` on shop terminals to keep POS on the LAN gateway. Leave unset
# in dev/CI so the interactive toggle stays live.
VITE_POS_API_MODE=

# =========================================================================
# Sentry — error tracking + performance
# =========================================================================
# DSN identifies the Sentry project. NOT a server secret (it just lets
# anyone write to the project; standard public client identifier per
# Sentry docs). Unset = SDK is a no-op + no events ship.
#
# Recommend one DSN per environment (dev / staging / prod) so triage
# doesn't conflate environments. The init reads `import.meta.env.MODE`
# into the `environment` tag automatically.
VITE_SENTRY_DSN=

# Release identifier — set at CI build time (e.g. git SHA) so Sentry
# groups errors by build version + supports source-map upload.
VITE_RELEASE=
