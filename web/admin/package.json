{
  "name": "@tempo/admin-web",
  "version": "0.8.35",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5430 -H 0.0.0.0",
    "build": "NODE_OPTIONS=--max-old-space-size=2048 next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:browser:install": "playwright install --with-deps chromium",
    "test:seeded": "playwright test --config=playwright.seeded.config.ts",
    "test:production": "playwright test --config=playwright.production.config.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'eslint --fix \"$@\" || true' --",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
