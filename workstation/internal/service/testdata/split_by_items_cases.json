    {
      "name": "toppings-are-per-unit-not-per-line",
      "_why": "REGRESSION (shop-reported, 2026-08-13). `topping_subtotal` is PER UNIT — the column comment says so and every writer stores subtotal = quantity x (unit_price + topping_subtotal). All three calculators used to divide it by the line quantity, so a 1000 bowl x3 with a 100 extra priced each unit at 1033 instead of 1100: every guest but the last under-paid and the last absorbed the whole 200 gap through the reconcile step, which is why the totals still added up and nothing looked wrong. Not one case in this file carried a non-zero topping_subtotal — that is how three implementations agreed on the same wrong rule.",
      "order": {
        "subtotal": 3300,
        "discount_amount": 0,
        "total_amount": 3300,
        "items": [
          { "id": "i-1", "unit_price": 1000, "quantity": 3, "topping_subtotal": 100, "status": "preparing" }
        ]
      },
      "allocations": [
        { "item_id": "i-1", "units": 1, "bill_index": 0 },
        { "item_id": "i-1", "units": 1, "bill_index": 1 },
        { "item_id": "i-1", "units": 1, "bill_index": 2 }
      ],
      "rounding_mode": "auto",
      "currency_code": "VND",
      "tax_rate": 0,
      "service_charge_rate": 0,
      "people_count": 3,
      "expected": {
        "total_check": 3300,
        "bills": [
          { "index": 0, "subtotal": 1100, "discount": 0, "tax": 0, "service": 0, "total": 1100, "is_empty": false },
          { "index": 1, "subtotal": 1100, "discount": 0, "tax": 0, "service": 0, "total": 1100, "is_empty": false },
          { "index": 2, "subtotal": 1100, "discount": 0, "tax": 0, "service": 0, "total": 1100, "is_empty": false }
        ]
      }
    },
