{
    "receipt": {
        "schema": "tempo.print.v1",
        "paper": {
            "columns_58mm": 32,
            "columns_80mm": 48
        },
        "kind": "receipt",
        "blocks": [
            {
                "id": "logo",
                "type": "image",
                "enabled": false,
                "source": "brand_logo",
                "align": "center"
            },
            {
                "id": "store_info",
                "type": "params",
                "enabled": true,
                "align": "left",
                "fields": [
                    "store_organization",
                    "store_sub_name",
                    "store_name",
                    "store_address",
                    "store_phone"
                ]
            },
            {
                "id": "title",
                "type": "text",
                "enabled": false,
                "align": "right",
                "bold": true,
                "i18n": {
                    "ja": "支払済",
                    "en": "PAID",
                    "vi": "DA THANH TOAN"
                }
            },
            {
                "id": "issued_at",
                "type": "locked"
            },
            {
                "id": "split_banner",
                "type": "locked"
            },
            {
                "id": "order_meta",
                "type": "params",
                "enabled": true,
                "fields": [
                    "order_no",
                    "table"
                ]
            },
            {
                "id": "customer_header",
                "type": "params",
                "enabled": true,
                "fields": [
                    "customer_name",
                    "customer_phone",
                    "pickup_time"
                ]
            },
            {
                "id": "order_note",
                "type": "params",
                "enabled": true
            },
            {
                "id": "header_text",
                "type": "text",
                "enabled": false,
                "align": "center",
                "fallback": true
            },
            {
                "id": "column_header",
                "type": "text",
                "enabled": true,
                "i18n": {
                    "ja": "商品                          合計",
                    "en": "Item                        Total",
                    "vi": "San pham                      Tong"
                }
            },
            {
                "id": "items",
                "type": "line_items",
                "columns": [
                    "name",
                    "qty",
                    "amount"
                ]
            },
            {
                "id": "subtotal",
                "type": "locked"
            },
            {
                "id": "discounts",
                "type": "locked"
            },
            {
                "id": "service_charge",
                "type": "locked"
            },
            {
                "id": "grand_total",
                "type": "locked"
            },
            {
                "id": "tax_breakdown",
                "type": "locked"
            },
            {
                "id": "tax_legend",
                "type": "locked"
            },
            {
                "id": "registration_number",
                "type": "locked",
                "enabled": true
            },
            {
                "id": "payments",
                "type": "locked"
            },
            {
                "id": "change_due",
                "type": "locked"
            },
            {
                "id": "remaining",
                "type": "locked"
            },
            {
                "id": "invoice_number",
                "type": "locked"
            },
            {
                "id": "reprint_marker",
                "type": "locked"
            },
            {
                "id": "qr_block",
                "type": "qr",
                "enabled": false,
                "source": "order_url",
                "align": "center"
            },
            {
                "id": "footer_text",
                "type": "text",
                "enabled": false,
                "align": "center",
                "fallback": true
            },
            {
                "id": "greeting",
