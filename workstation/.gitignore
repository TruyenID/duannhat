# Build
bin/
build/bin/
.task/

# Frontend
frontend/node_modules/
frontend/node_modules
frontend/dist/
# frontend/bindings/ is NO LONGER ignored (#1197). vite.config.ts loads
# wails("./bindings") and the plugin aborts the build when the directory is
# missing, so a fresh clone — and CI — could not build the frontend at all. CI
# cannot regenerate them either: that needs the wails3 CLI and the Linux runner
# has no GTK. Two files, 8 KB. See frontend/bindings/README.md.
frontend/.vite/

# Go
*.exe
*.test
*.out

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Playwright
.playwright-mcp/
workstation-app.db
workstation-app.db-shm
workstation-app.db-wal

# Release artifacts assembled by the packaging step (see docs/RELEASE.md)
dist/

# pos-web/dist — the embedded pos-web SPA bundle (#1169), same treatment as
# frontend/dist: produced by the build pipeline (make posweb / the CI
# pos-web-dist artifact) and embedded via posweb.go. Only .gitkeep is tracked
# (so `//go:embed` always compiles); the real bundle is gitignored, so a build
# never dirties the working tree.
# NOTE: must come AFTER the generic `dist/` rule above (which would otherwise
# re-exclude this whole directory) — re-include the dir, then keep only .gitkeep.
!pos-web/dist/
pos-web/dist/*
!pos-web/dist/.gitkeep

# Generated by `wails3 task linux:generate:dotdesktop` during a Linux build
build/linux/ws-app.desktop

# Runtime config — may hold per-shop cloud URLs / DSNs. .env.example is tracked.
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Written at startup by StartEndpointExporter (machine-specific LAN address)
endpoint.json
