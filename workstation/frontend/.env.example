# Workstation App — Frontend Environment Variables
# Copy to .env and fill in values:
#   cp .env.example .env
#
# These are read at Wails build time + baked into the embedded
# frontend bundle. Empty / missing values are safe — the corresponding
# feature is silently disabled.

# =========================================================================
# Sentry — error tracking for the Wails operator UI
# =========================================================================
# DSN identifies the Sentry project. NOT a server secret. Unset = SDK
# is a no-op + no events ship.
#
# Each restaurant deploys workstation independently — use one DSN per
# environment tier (dev / staging / prod), NOT per restaurant, so the
# Sentry dashboard stays manageable. The init reads `import.meta.env.MODE`
# into the `environment` tag automatically.
#
# CSP NOTE: when you set this, ALSO ensure `frontend/index.html`'s
# CSP `connect-src` lists `https://*.sentry.io https://*.ingest.sentry.io`
# (already in this commit) — otherwise events are blocked silently
# by CSP and Sentry stays empty.
VITE_SENTRY_DSN=

# Release identifier — set at CI build time (git SHA) so Sentry groups
# errors by build version + supports source-map upload.
VITE_RELEASE=
