# TempoFast Kitchen Display System (KDS) — Environment Variables
# Copy to .env and fill in values:
#   cp .env.example .env

# Cloud API base URL — defaults to the staging cluster. resolveBaseUrl()
# tries workstation LAN first (mDNS) and falls back to this URL when
# the LAN isn't reachable.
VITE_CLOUD_URL=https://dev-tempo-api.godx.jp

# Default locale (ja | en | vi). KDS defaults to ja for kitchen staff.
VITE_DEFAULT_LOCALE=ja

# =========================================================================
# Sentry — error tracking
# =========================================================================
# DSN identifies the Sentry project. NOT a server secret (it just lets
# anyone write to the project; standard public client identifier per
# Sentry docs). Unset = SDK is a no-op + no events ship.
#
# Recommend one DSN per environment tier (dev / staging / prod). The
# init reads `import.meta.env.MODE` into the `environment` tag
# automatically.
VITE_SENTRY_DSN=

# Release identifier — set at CI build time (git SHA) so Sentry groups
# errors by build version + supports source-map upload.
VITE_RELEASE=
