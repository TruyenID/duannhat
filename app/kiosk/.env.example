# TempoFast Kiosk App — Environment Variables
# Copy to .env and fill in values:
#   cp .env.example .env

# =========================================================================
# API base URL (backend server) — ORIGIN ONLY, no trailing path.
# =========================================================================
# The client appends `/api/v1/...` itself (see src/lib/api.ts), so put only
# the scheme + host here. Trailing slashes are NOT stripped for this var.
#   production : https://tempo.godx.jp
#   local dev  : http://localhost:5400
#
# IMPORTANT: EXPO_PUBLIC_* is inlined into the JS bundle AT BUILD TIME.
# Editing .env after a build has no effect — you must rebuild the APK/IPA.
# Unset falls back to http://localhost:5400, which is dead on a real tablet.
EXPO_PUBLIC_API_URL=https://tempo.godx.jp

# =========================================================================
# Workstation LAN URL — build-time default (OPTIONAL, usually leave EMPTY)
# =========================================================================
# The kiosk is CLOUD-FIRST (issue #44): Cloud is the source of truth and the
# workstation is a standby that only serves traffic while Cloud is failing.
# The LAN address is resolved as: mDNS discovery (only scans once an operator
# turns on "LAN standby mode" in Settings) → manual URL from Settings → this
# value. See src/services/workstation/base-url-resolver.ts.
#
# It is ALSO the print target: receipt printing is LAN-only, because the
# ESC/POS printer sits behind the restaurant's router and Cloud has no print
# endpoint at all. A kiosk that prints but has neither mDNS nor a manual URL
# needs this set, or every print reports "no workstation on this network".
#
# The workstation app listens on port 8080, so the value looks like:
#   http://192.168.1.249:8080      <- the workstation's LAN IP
#   http://localhost:8080          <- ONLY valid when the app runs on the
#                                     same machine as the workstation
#                                     (dev/emulator). On a real tablet
#                                     `localhost` means the tablet itself.
#
# WARNING: setting this to localhost on a tablet build makes every LAN
# fallback (and every print) die locally. Leave empty unless you ship kiosks
# pre-pointed at a known fixed workstation IP.
EXPO_PUBLIC_WORKSTATION_URL=

# =========================================================================
# Sentry — error tracking + lifecycle audit (PCI Req 10.2)
# =========================================================================
# DSN identifies the Sentry project. NOT a server secret (it just lets
# anyone write to the project; standard public client identifier per
# Sentry docs). Unset = SDK is a no-op + no events ship.
#
# Each restaurant deploys the kiosk independently — one DSN per
# environment tier (dev / staging / prod), NOT per restaurant, so the
# Sentry dashboard stays manageable. Use the `environment` tag below
# to separate.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry environment tag (dev / staging / prod). Falls back to
# NODE_ENV when unset.
EXPO_PUBLIC_SENTRY_ENV=

# Release identifier — set at CI build time (e.g. git SHA + Expo build
# number) so Sentry can attach the right source map.
EXPO_PUBLIC_RELEASE=
