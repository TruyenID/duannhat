<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ws-app"
        Arguments=""
        InstallLocation="C:\Program Files\DXS Platform\WS App">
    </Installer>
    <PackageInformation
        PackageName="WS App"
        PackageDisplayName="WS App"
        PublisherName="CN=DXS Platform"
        PublisherDisplayName="DXS Platform"
        Version="0.1.0.0"
        PackageDescription="Workstation Desktop Application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.dxs-platform.ws-app"
                Description="Workstation Desktop Application"
                DisplayName="WS App"
                ExecutableName="ws-app"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WS App</DisplayName>
            <PublisherDisplayName>DXS Platform</PublisherDisplayName>
            <Description>Workstation Desktop Application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ws-app.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
