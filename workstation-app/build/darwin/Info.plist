<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
            <string>APPL</string>
        <key>CFBundleName</key>
            <string>WS App</string>
        <key>CFBundleExecutable</key>
            <string>ws-app</string>
        <key>CFBundleIdentifier</key>
            <string>com.dxs-platform.ws-app</string>
        <key>CFBundleVersion</key>
            <string>0.2.0</string>
        <key>CFBundleGetInfoString</key>
            <string>TempoFast Workstation — LAN gateway for POS, kiosk and KDS clients</string>
        <key>CFBundleShortVersionString</key>
            <string>0.2.0</string>
        <key>CFBundleIconFile</key>
            <string>icons</string>
        <key>CFBundleIconName</key>
            <string>appicon</string>
        <key>LSMinimumSystemVersion</key>
            <string>10.15.0</string>
        <key>NSHighResolutionCapable</key>
            <string>true</string>
        <key>NSHumanReadableCopyright</key>
            <string>© 2026 GODX</string>
        <!-- macOS 15 (Sequoia) gates local-network access behind an explicit
             user grant. Without NSLocalNetworkUsageDescription the system
             prompt has no rationale and, once denied, POS/kiosk/KDS tablets
             silently fail to reach this workstation on :8080 — the app's
             entire reason to exist. NSBonjourServices must list every mDNS
             service type the app touches (see internal/discovery/mdns.go)
             or advertisement/browsing is blocked. -->
        <key>NSLocalNetworkUsageDescription</key>
            <string>TempoFast Workstation serves the POS, kiosk and kitchen-display terminals on this restaurant's local network, and announces itself so they can find it automatically.</string>
        <key>NSBonjourServices</key>
            <array>
                <string>_ws-app._tcp</string>
            </array>
    </dict>
</plist>