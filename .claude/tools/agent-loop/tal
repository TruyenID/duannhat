def cmd_config(a):
    """#2348 — in ra bề mặt CHÍNH SÁCH đã giải, kèm NGUỒN của từng giá trị.

    Bước 0 của cả `issue-work` lẫn `issue-review` bảo chạy `tal config` trước khi
    sửa dòng đầu tiên — mà lệnh này chưa bao giờ tồn tại: nó trả
    `argparse: invalid choice`. Mọi session làm theo hướng dẫn đều nhận lỗi rồi tự
    bịa tiếp phần chính sách.

    Cột "nguồn" là phần quan trọng nhất, không phải giá trị: `env` / `config` /
    `mặc định` cho biết khoá bạn vừa sửa trong `agent-loop.json` có thật sự có tác
    dụng hay không. Trước #2348 tám khoá được khai mà không khoá nào được đọc, và
    không có cách nào nhìn ra điều đó ngoài việc đọc mã nguồn `tal`.
    """
    cfgfile = None
    try:
        d = Path.cwd().resolve()
        for cand in [d, *d.parents]:
            f = cand / ".claude" / "agent-loop.json"
            if f.is_file():
                cfgfile = f
                break
    except OSError:
        pass

    def src(envname: str | None, key: str) -> str:
        if envname and os.environ.get(envname):
            return f"env {envname}"
        return "config" if _CFG.get(key) not in (None, "", [], {}) else "mặc định"

    rows = [
        ("baseBranch", BASE_BRANCH, src("TAL_BASE", "baseBranch")),
        ("promotionBranch", PROMOTION_BRANCH, src("TAL_PROMOTION", "promotionBranch")),
        ("ttlSeconds", TTL, src("TAL_TTL", "ttlSeconds")),
        ("maxAttempts", MAX_ATTEMPTS, src("TAL_MAX_ATTEMPTS", "maxAttempts")),
        ("refNamespace", REF_NS, src(None, "refNamespace")),
        ("severityOrder", ",".join(sorted(SEVERITY_RANK, key=SEVERITY_RANK.get)),
         src(None, "severityOrder")),
        ("formatCmd", _CFG.get("formatCmd") or "(chưa khai)", src(None, "formatCmd")),
    ]
    labels = {
        "ready": L_READY, "working": L_WORKING, "reviewing": L_REVIEWING,
        "awaitingReview": L_AWAIT, "changesRequested": L_CHANGES,
        "reviewPassed": L_PASSED, "deadLetter": L_DEAD,
        "blocked": L_BLOCKED, "shipped": L_SHIPPED,
    }
    docs = {}
    for role, rel in (_CFG.get("policyDocs") or {}).items():
        f = (C.main_worktree / rel) if rel else None
        docs[role] = {"path": rel, "exists": bool(f and f.is_file())}
    risk = _CFG.get("riskDomains") or []

    if a.json:
        print(json.dumps({
            "configFile": str(cfgfile) if cfgfile else None,
            "values": {k: v for k, v, _ in rows},
            "sources": {k: sc for k, _, sc in rows},
            "labels": labels,
            "policyDocs": docs,
            "riskDomains": risk,
            "agentLogins": sorted(AGENT_LOGINS),
            "fullSuite": full_suite_cmds(),
            "setup": setup_cmds(),
            "docsRules": len(docs_rules()),
        }, ensure_ascii=False, indent=2))
        return

    print(f"config: {cfgfile or '(không tìm thấy .claude/agent-loop.json)'}")
    print()
    for k, v, sc in rows:
        print(f"  {k:<18} {str(v):<28} ← {sc}")
    print()
    print("  nhãn:")
    for k, v in labels.items():
        mark = "config" if (_CFG.get("labels") or {}).get(k) else "mặc định"
        print(f"    {k:<18} {v:<30} ← {mark}")
    print()
    print("  policyDocs — ĐỌC HẾT trước khi sửa dòng đầu tiên:")
    if not docs:
        print("    (chưa khai — làm theo luật chung của skill, và đề nghị người viết)")
    for role, info in docs.items():
        print(f"    {role:<8} {info['path']}  {'✓' if info['exists'] else '✘ THIẾU FILE'}")
    print()
    print(f"  riskDomains ({len(risk)}) — diff chạm các vùng này thì REVIEW phải ở tier cao nhất:")
    print("    " + (", ".join(risk) if risk else "(chưa khai — mặc định coi mọi diff là thường)"))
    print()
    print(f"  agentLogins ({len(AGENT_LOGINS)}) — tác giả PR được coi là AGENT; "
          f"`review-queue` xếp phần còn lại vào rổ `humans` (đừng claim, đừng ghi verdict):")
    print("    " + (", ".join(sorted(AGENT_LOGINS)) if AGENT_LOGINS
                    else "(chưa khai — KHÔNG lọc theo tác giả, mọi PR mồ côi vào rổ `orphans`)"))
    print()
    print(f"  fullSuite: {len(full_suite_cmds())} lệnh · setup: {len(setup_cmds())} lệnh "
          f"· docsRules: {len(docs_rules())} luật")
    print()
    print(f"  Cổng full suite là cổng {BASE_BRANCH} → {PROMOTION_BRANCH}, "
          f"KHÔNG phải cổng của từng PR.")


def cmd_status(a):
    rows = []
    for ref in refs_all_full():
        key = ref["key"]
        if key == BATCH_KEY:
            rows.append({"key": key, "state": "cổng merge đang chạy"})
            continue
        m = re.match(r"^(issue|pr)-(\d+)$", key)
        if not m:
            rows.append({"key": key, "state": "ref lạ"})
            continue
        kind, num = m.group(1), int(m.group(2))
        issue = num if kind == "issue" else pr_issue(num)
        led, _, upd = ledger_read(issue)
        lease = led.get("lease") or {}
        # #2172 — lease review CỐ Ý không ghi vào sổ, nên `lease` ở trên là lease CODE
        # của issue (session khác!) hoặc rỗng. Chủ thật của lease review nằm trong
        # payload của chính cái ref; đọc từ đó, để `?` chỉ còn nghĩa "không đọc được
        # chủ" chứ không phải "mọi lease review".
        pay = (ref_payload(ref["sha"]) if kind == "pr" and ref.get("type") == "tag" else None)
        if pay:
            try:
                left = (parse_iso(pay["expires_at"]) - now()).total_seconds()
            except (KeyError, ValueError):
                left = -1
            rows.append({
                "key": key, "issue": issue, "state": led.get("state"),
                "session": (pay.get("session") or "?")[:8], "host": pay.get("host"),
                "addr": agent_addr(pay),
                "epoch": led.get("epoch"), "expires_in": human_delta(left),
                "expired": left <= 0, "regions": [], "orphan_ref": False,
            })
            continue
        if kind == "pr":
            # Ref không mang payload: KHÔNG đọc được chủ. Sau #2172 mọi lease review
            # mới đều mang payload, nên `?` ở đây nghĩa là ref cũ hoặc mồ côi (#1616).
            # Vẫn KHÔNG khuyên `tal unlock` (#1406 — xoá nhầm lease sống là hai session
            # cùng review một PR); `tal gc` có ân hạn, để nó phân xử.
            rows.append({
                "key": key, "issue": issue, "state": led.get("state"),
                "session": "?", "host": None, "addr": "—", "epoch": led.get("epoch"),
                "expires_in": human_delta(((upd + timedelta(seconds=TTL)) - now()).total_seconds()) if upd else "?",
                "expired": lease_expired(led, upd),
                "regions": [], "orphan_ref": False, "no_payload": True,
            })
            continue
        left = ((upd + timedelta(seconds=lease.get("ttl", TTL))) - now()).total_seconds() if upd else -1
        rows.append({
            "key": key, "issue": issue, "state": led.get("state"),
            "session": (lease.get("session") or "?")[:8], "host": lease.get("host"),
            "addr": agent_addr(lease),
            "epoch": led.get("epoch"), "expires_in": human_delta(left),
            "expired": lease_expired(led, upd),
            # Lease review (`pr-`) đọc sổ của ISSUE, nên nếu in `regions` ở đó thì
            # cùng một vùng hiện hai dòng và trông như hai người đang giữ (#2270).
            "regions": (lease.get("regions") or []) if kind == "issue" else [],
            # Ref là nguồn CAS, sổ là nơi ghi chủ sở hữu. Ref còn mà sổ đã `lease: null`
            # nghĩa là có ai đó dọn sổ mà không xoá ref — trạng thái lệch, và trước #1385
            # nó chỉ hiện ra thành một dấu `?` vô nghĩa ở cột session.
            #
            # CHỈ áp cho key `issue-`. Lease REVIEW (`pr-`) **cố ý** không ghi vào sổ:
            # `cmd_review_claim` chỉ đặt `state="reviewing"` + một dòng history, quyền sở
            # hữu nằm trọn ở ref. Chấm chung một luật thì mọi lease review khoẻ mạnh đều
            # bị gắn cờ — và cờ đó khuyên chạy `tal unlock`, tức là cướp lease của người
            # đang review (#1406).
            "orphan_ref": kind == "issue" and not led.get("lease"),
        })
    issues = open_issues()

    def with_label(lb: str) -> list[int]:
        return [i["number"] for i in issues if lb in {l["name"] for l in i["labels"]}]

    board = {
        "repo": C.repo, "me": session_id()[:8], "ttl": TTL, "leases": rows,
        "ready": with_label(L_READY), "dead_letters": with_label(L_DEAD),
        "awaiting_review": with_label(L_AWAIT), "awaiting_merge": with_label(L_PASSED),
        "changes_requested": with_label(L_CHANGES),
    }
    open_labels_map = {i["number"]: {l["name"] for l in i["labels"]} for i in issues}
    open_pr_rows = gh_json(
        ["pr", "list", "-R", C.repo, "--state", "open", "--limit", "100",
         "--json", "number,headRefName"],
        default=[],
    ) or []
    board["stranded_reviews"] = stranded_review_candidates(
        open_pr_rows, open_labels_map, live_lease_issues())
    if a.json:
        return emit(board, True)
    print(f"repo {C.repo} · session này {board['me']}… · TTL {human_delta(TTL)}\n")
    print(f"{'key':<14}{'issue':<8}{'state':<18}{'session':<10}{'addr':<30}"
          f"{'epoch':<7}{'còn':<10}regions")
    for r in rows:
        flag = "  ⟵ QUÁ HẠN, chạy tal gc" if r.get("expired") else ""
        if r.get("orphan_ref") and not r.get("expired"):
            flag = "  ⟵ LỆCH: ref còn nhưng sổ không ghi ai giữ (`tal unlock <key>` nếu chắc không ai làm)"
        if r.get("no_payload") and not r.get("expired"):
            flag = "  ⟵ KHÔNG ĐỌC ĐƯỢC CHỦ: ref không mang payload (#2172) — mồ côi #1616? để `tal gc` phân xử, ĐỪNG unlock tay"
        regions = ", ".join(r.get("regions") or []) or "—"
        print(f"{r['key']:<14}{str(r.get('issue','')):<8}{str(r.get('state','')):<18}"
              f"{r.get('session',''):<10}{str(r.get('addr','—')):<30}"
              f"{str(r.get('epoch','')):<7}"
              f"{str(r.get('expires_in','')):<10}{regions}{flag}")
    if not rows:
        print("(không có lease nào)")
    print(f"\ncần sửa theo review (ưu tiên): {board['changes_requested']}"
          f"\nchờ review: {board['awaiting_review']}"
          f"\nchờ NGƯỜI merge: {board['awaiting_merge']}"
          f"\ndead-letter (cần người): {board['dead_letters']}")
    stranded = board.get("stranded_reviews") or []
    if stranded:
        bits = ", ".join(f"#{s['issue']}/PR #{s['pr']}" for s in stranded)
        print(f"PR mở mồ côi (không nhãn review) — `tal gc` sẽ nhặt: {bits} (#2788)")
    return board


def cmd_requeue(a):
    """#2300 — đường CHÍNH DANH cho NGƯỜI mở khoá dead-letter.

    Trước đây không có: gỡ nhãn tay bị resync dán lại (ledger là nguồn sự thật),
    `tal unlock` reset state nhưng GIỮ counter nên claim kế tiếp tái dead-letter,
    còn TAL_MAX_ATTEMPTS + --force là cửa ngầm không để lại dấu vết. Requeue:
    reset `review_rounds`/`reaps` (chuỗi thất bại làm lại từ đầu), GIỮ `attempts`
    và history (sử liệu), ghi ai-mở-vì-sao vào sổ."""
    issue = a.issue
    if not (getattr(a, "note", "") or "").strip():
        raise Fail('`tal requeue` bắt buộc --note "<vì sao lần này sẽ khác>" — người mở khoá '
                   "phải nói được điều gì đã đổi: root cause đã rõ, scope thu hẹp, quyết định mới.", 2)
    d0 = issue_data(issue)
    if d0["state"] != "open":
        raise Fail(f"#{issue} đang {d0['state']} — mở lại issue trước rồi hẵng requeue", 2)
    key = f"issue-{issue}"
    if ref_exists(key):
        raise Fail(f"{key}: đang có lease sống — requeue chỉ dành cho issue KHÔNG ai giữ. "
                   "Lease chết thật thì chờ `tal gc` hoặc `tal unlock` trước.", BUSY)
    led, cid, _ = ledger_read(issue)
    if led.get("state") != "dead_letter" and L_DEAD not in set(d0.get("labels") or []):
        warn(f"#{issue} không ở dead-letter (state={led.get('state')!r}) — vẫn reset counter theo yêu cầu")
    led["state"] = "queued"
    led["lease"] = None
    led["review_rounds"] = 0
    led["reaps"] = 0
    cid = ledger_write(led, cid, f"requeue bởi {session_id()[:8]}… — {a.note.strip()}")
    for n in led.get("group", [issue]):
        set_state_labels(n, {L_READY})
    out = {"issue": issue, "state": "queued", "review_rounds": 0, "reaps": 0,
           "attempts": led.get("attempts", 0)}
    if a.json:
        return emit(out, True)
    print(f"#{issue} → queued (review_rounds/reaps reset, attempts giữ nguyên "
          f"{led.get('attempts', 0)}) — nhãn {L_READY} đã gắn, {L_DEAD}/{L_BLOCKED} đã gỡ")
    return out


def cmd_unlock(a):
    key = a.key if a.key.startswith(("issue-", "pr-")) or a.key == BATCH_KEY else f"issue-{a.key}"
    if not a.force:
        raise Fail("cần --force: đây là can thiệp tay, chỉ dùng khi chắc session giữ lease đã chết", 2)
    if key.startswith("pr-") and not (getattr(a, "note", "") or "").strip():
        raise Fail('`tal unlock` trên lease review (`pr-*`) bắt buộc `--note "<lý do>"` '
                   "— mở khoá lease của session khác phải để lại dấu vết (#2261).", 2)
    ref_delete(key)
    local_unlock(key)
    m = re.match(r"^issue-(\d+)$", key)
    if m:
        issue = int(m.group(1))
        led, cid, _ = ledger_read(issue)
        led["lease"] = None
        led["state"] = "queued"
        ledger_write(led, cid, f"mở khoá tay bởi {session_id()[:8]}… ({a.note or 'không nêu lý do'})")
        set_state_labels(issue, set(), preserve={L_CHANGES})
        # #2300 — unlock KHÔNG reset counter (nó là lệnh gỡ khoá, không phải ân xá):
        # nói to để người khỏi ngạc nhiên khi claim kế tiếp tái dead-letter.
        if led.get("review_rounds", 0) >= MAX_ATTEMPTS or led.get("reaps", 0) >= MAX_ATTEMPTS:
            warn(f"counter còn nguyên (review_rounds={led.get('review_rounds', 0)}, "
                 f"reaps={led.get('reaps', 0)}) — claim kế tiếp sẽ TÁI dead-letter. "
                 f"Muốn chạy lại thật: `tal requeue {issue} --note \"…\"`.")
    if key.startswith("pr-"):
        try:
            pr_num = int(key[3:])
            gh(["pr", "comment", str(pr_num), "-R", C.repo, "-b",
                f"**MỞ KHOÁ LEASE REVIEW TAY.** Session `{session_id()[:8]}…` vừa `tal unlock {key} --force`.\n\n"
                f"> {(a.note or '').strip()}"], check=False)
        except ValueError:
            pass
    print(f"đã mở khoá {key}")


def dangling_pointers() -> list[str]:
    """Con trỏ submodule trên `dev` có với tới được từ `dev` của repo con không.

    Nhánh tạm (`issue-N`) rồi sẽ bị xoá; nhánh tích hợp riêng cũng có thể bị xoá.
    Nên phép kiểm đúng KHÔNG phải "commit này có trên origin/issue-N" mà là "sau
    khi mọi nhánh tạm biến mất, commit này còn với tới được từ `dev` không".

    Đã bắt được thật (#1465): umbrella `dev` trỏ customer-web vào một commit chỉ
    tồn tại trên `origin/info-customer`, vì PR con nhắm sai base.
    """
    out = []
    root = str(C.main_worktree)
    run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=root, check=False)
    for s in submodules().values():
        path = s["path"]
        sub = C.main_worktree / path
        if not (sub / ".git").exists():
            continue
        r = run(["git", "rev-parse", f"origin/{BASE_BRANCH}:{path}"], cwd=root, check=False)
        if r.returncode != 0:
            continue
        ptr = r.stdout.strip()
        run(["git", "fetch", "-q", "origin", "--prune"], cwd=str(sub), check=False)
        if run(["git", "cat-file", "-e", ptr + "^{commit}"], cwd=str(sub),
               check=False).returncode != 0:
            out.append(f"{path}: {ptr[:12]} KHÔNG TỒN TẠI trong repo con")
            continue
        if run(["git", "merge-base", "--is-ancestor", ptr, f"origin/{BASE_BRANCH}"],
               cwd=str(sub), check=False).returncode != 0:
            br = run(["git", "branch", "-r", "--contains", ptr], cwd=str(sub),
                     check=False).stdout.split()
            out.append(f"{path}: {ptr[:12]} không nằm trên origin/{BASE_BRANCH}; "
                       f"chỉ sống nhờ {', '.join(br) if br else 'KHÔNG NHÁNH NÀO'} — "
                       f"xoá nhánh đó là mọi clone mới chết")
    return out


def cmd_doctor(a):
    ok = True

    def check(name: str, good: bool, detail: str = ""):
        nonlocal ok
        ok = ok and good
        print(f"  {'✔' if good else '✘'} {name}{(' — ' + detail) if detail else ''}")

    print("con trỏ submodule trên " + BASE_BRANCH)
    dang = dangling_pointers()
    check("mọi con trỏ với tới được từ dev của repo con", not dang)
    for d in dang:
        print(f"      {d}")

    print("môi trường")
    check("gh đã đăng nhập", gh(["auth", "status"], check=False).returncode == 0)
