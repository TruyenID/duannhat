        """Cây làm việc của repo ĐIỀU PHỐI — leo ra khỏi mọi submodule trước khi hỏi git.

        `tal` điều phối issue của UMBRELLA. Trước #1751 cả `repo` lẫn `main_worktree`
        hỏi git ngay tại cwd, nên chạy từ trong một submodule là hỏi nhầm repo:
        `remote.origin.url` ở `<wt>/pos-web` là `godx-tempo-pos-web`, và
        `git worktree list` ở đó liệt kê cây của `.git/modules/pos-web`.

        Hậu quả không phải là một lỗi ồn ào mà là một lời NÓI DỐI: `ledger_read` đi
        đọc sổ ở repo con, `gh` lỗi, `gh_json(default=[])` nuốt lỗi thành sổ trắng,
        `lease.get("session")` là None ⇒ `tal renew` báo "lease không còn thuộc
        session này" trong khi lease vẫn sống. Đó đúng là điều kiện mà skill
        `issue-work` bảo phải DỪNG ngay — thông điệp sai theo hướng nguy hiểm nhất.
        Tệ hơn nữa nếu repo con TÌNH CỜ có issue trùng số: khi ấy sổ đọc được là sổ
        thật của một issue KHÁC, và lease bị so với dữ liệu của người lạ.

        `--show-superproject-working-tree` trả về rỗng khi đã ở ngoài cùng, nên vòng
        lặp dừng ở đó; lặp lại để chịu được submodule lồng submodule.
        """
        if Ctx._root is None:
            d = Path.cwd().resolve()
            for _ in range(10):
                out = run(["git", "-C", str(d), "rev-parse",
                           "--show-superproject-working-tree"], check=False).stdout.strip()
                if not out:
                    break
                nxt = Path(out).resolve()
                if nxt == d:
                    break
                d = nxt
            Ctx._root = d
        return Ctx._root

    @property
    def repo(self) -> str:
        if Ctx._repo is None:
            url = run(["git", "-C", str(self.root), "config", "--get",
                       "remote.origin.url"]).stdout.strip()
            m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
            if not m:
                raise Fail(f"không suy ra được owner/repo từ remote: {url}")
            Ctx._repo = m.group(1)
        return Ctx._repo

    @property
    def login(self) -> str:
        if Ctx._login is None:
            Ctx._login = gh(["api", "user", "-q", ".login"]).stdout.strip()
        return Ctx._login

    @property
    def main_worktree(self) -> Path:
        """Worktree gốc — nơi chứa .claude/worktrees/ và nơi chạy mọi lệnh git chung."""
        if Ctx._main is None:
            out = run(["git", "-C", str(self.root), "worktree", "list", "--porcelain"]).stdout
            first = out.splitlines()[0]
            Ctx._main = Path(first.split(" ", 1)[1].strip())
        return Ctx._main

    @property
    def worktrees_dir(self) -> Path:
        return self.main_worktree / ".claude" / "worktrees"

    @property
    def state_dir(self) -> Path:
        d = Path.home() / ".tal" / self.repo.replace("/", "__") / "locks"
        d.mkdir(parents=True, exist_ok=True)
        return d


