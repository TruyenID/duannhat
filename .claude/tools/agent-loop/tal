# ─────────────────────────────────────────────────────────────────────────────


def main() -> int:
    ap = argparse.ArgumentParser(prog="tal", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help_):
        p = sub.add_parser(name, help=help_)
        p.set_defaults(fn=fn)
        p.add_argument("--json", action="store_true", help="in JSON")
        return p

    add("config", cmd_config, "in chính sách repo đã giải (giá trị + NGUỒN của nó)")

    p = add("doctor", cmd_doctor, "kiểm tra điều kiện chạy")
    p.add_argument("--fix", action="store_true", help="tạo nhãn thiếu, bật delete_branch_on_merge")

    p = add("queue", cmd_queue, "hàng đợi issue cho vai code")
    p.add_argument("--limit", type=int, default=10)
    p.add_argument("-v", "--verbose", action="store_true", help="kèm lý do bỏ qua")

    p = add("claim", cmd_claim, "giành issue (nguyên tử) + dựng worktree/branch")
    p.add_argument("issue", type=int)
    p.add_argument("--force", action="store_true",
                   help="bỏ qua cổng agent:ready / nhãn dead-letter (KHÔNG kèm rào vùng — xem --force-region)")
    p.add_argument("--force-region", action="store_true",
                   help="#2270/#2300: vượt rào vùng file đang bị lease khác giữ — quyết định riêng, nói to")
    p.add_argument("--force-root", action="store_true", help="không cảnh báo khi leo lên parent")
    p.add_argument("--region", action="append", default=[], metavar="PATH",
                   help="vùng file giữ trong lease này (lặp được, ví dụ "
                        "`--region backend/app/Services --region docs/guide`). "
                        "Chồng lấn với lease sống khác ⇒ từ chối. Không khai = không giữ vùng nào.")
    p.add_argument("--split", action="store_true",
                   help="cho sub-issue này branch riêng issue-<số của nó> thay vì làm chung với parent")

    add("renew", cmd_renew, "gia hạn lease (heartbeat) — gọi sau mỗi bước dài")
    add("assert", cmd_assert, "fencing check: còn quyền ghi hay không")

    p = add("adopt", cmd_adopt,
            "dựng lại .tal-lease.json từ sổ khi thẻ mất mà lease vẫn sống (KHÔNG bump epoch)")
    p.add_argument("issue", type=int, nargs="?",
                   help="bỏ trống = suy từ worktree đang đứng, không được thì hỏi sổ")

    p = add("release", cmd_release, "nhả lease")
    p.add_argument("--state", choices=["review", "blocked", "abandon", "no-op", "shipped"],
                   required=True,
                   help="no-op = đã kiểm, không có việc → tháo nhãn cổng, không nhặt lại")
    p.add_argument("--issue", type=int)
    p.add_argument("--note")

    p = add("requeue", cmd_requeue,
            "NGƯỜI mở khoá dead-letter: reset review_rounds/reaps, gắn lại agent:ready (#2300)")
    p.add_argument("issue", type=int)
    p.add_argument("--note", help="BẮT BUỘC: vì sao lần này sẽ khác")

    p = add("pr", cmd_pr, "push + mở/cập nhật PR vào dev + bàn giao review")
    p.add_argument("--title")
    p.add_argument("--body")
    p.add_argument("--body-file")
    p.add_argument("--allow-dirty", action="store_true")
    p.add_argument("--skip-submodule-check", action="store_true",
                   help="bỏ cổng kiểm pointer submodule (chỉ khi người yêu cầu)")
    p.add_argument("--docs-ok", action="store_true",
                   help="#1639: đã xem khoảng trống tài liệu và khẳng định thay đổi này "
                        "KHÔNG cần doc — nhả lease luôn, lời khẳng định ghi vào PR")

    add("submodule-check", cmd_submodule_check, "soi pointer/branch/PR của mọi submodule đã chạm")

    p = add("submodule", cmd_submodule, "init submodule trong worktree + tạo branch issue-N")
    p.add_argument("path")

    p = add("submodule-pr", cmd_submodule_pr, "push + mở PR trong repo con (base = .gitmodules branch)")
    p.add_argument("path")
    p.add_argument("--title")
    p.add_argument("--body-file")

    add("review-queue", cmd_review_queue, "PR đang chờ review")

    p = add("review-claim", cmd_review_claim, "giành quyền review một PR")
    p.add_argument("pr", type=int)
    p.add_argument("--allow-self", action="store_true", help="bỏ rào tách vai (cần người yêu cầu)")

    p = add("review-verdict", cmd_review_verdict, "kết luận review: pass | changes")
    p.add_argument("pr", type=int)
    p.add_argument("verdict", choices=["pass", "changes"])
    p.add_argument("--body")
    p.add_argument("--body-file")

    p.add_argument("--allow-self", action="store_true",
                   help="tự kết luận review PR mình đã code — PHÁ tách vai")
    p = add("docs-check", cmd_docs_check, "PR có cập nhật tài liệu đáng lẽ phải cập nhật chưa")
    p.add_argument("pr", type=int)

    p = add("merge-queue", cmd_merge_queue, "PR đủ điều kiện merge (review đạt + CI xanh)")
    p.add_argument("-v", "--verbose", action="store_true", help="kèm lý do chưa đủ điều kiện")
    p.add_argument("--batch", action="store_true",
                   help="xét theo đường gom lô: không đòi CI xanh từng PR")

    p = add("merge-batch", cmd_merge_batch,
            "GOM LÔ: trộn mọi PR đã review đạt, chạy full suite MỘT lần, xanh thì merge cả lô")
    p.add_argument("--dry-run", action="store_true", help="chỉ in lô, không trộn không chạy")
    p.add_argument("--limit", type=int, help="chỉ lấy N PR đầu")
    p.add_argument("--suite", action="store_true",
                   help="CHẠY full suite cho cả lô (mặc định KHÔNG chạy — #1454)")
    p.add_argument("--skip-suite", action="store_true",
                   help="bỏ full suite (chỉ khi người yêu cầu rõ)")
    p.add_argument("--gate-only", action="store_true",
                   help="dựng cây tạm + chạy cổng rồi DỪNG, không merge (dùng để kiểm chính cổng)")

    p = add("merge", cmd_merge, "merge MỘT PR — đòi review đạt và CI xanh của chính PR đó")
    p.add_argument("pr", type=int)
    p.add_argument("--force", action="store_true",
                   help="bỏ qua điều kiện (chỉ khi người yêu cầu rõ)")
    p.add_argument("--require-ci", action="store_true",
                   help="đòi CI xanh trước khi merge (mặc định KHÔNG — #1454)")
    p.add_argument("--batch-verified", action="store_true",
                   help="(nội bộ) đã chứng minh xanh ở tầng lô — bỏ đòi CI từng PR")
    p.add_argument("--no-subs", action="store_true",
                   help="KHÔNG merge PR con của cụm trước (chỉ khi người yêu cầu rõ)")
    p.add_argument("--self", dest="self_merge", action="store_true",
                   help="tự merge PR mình đã code — PHÁ tách vai, bắt buộc kèm --note")
    p.add_argument("--note", help="lý do tự merge, ghi thẳng lên PR")
    p.add_argument("--promote", action="store_true",
                   help=f"PR này CỐ Ý nhắm `{PROMOTION_BRANCH}` — phát hành lên production. "
                        "Không có cờ này thì base khác `%s` bị TỪ CHỐI (#2573); `--force` "
                        "KHÔNG mở được rào đó." % BASE_BRANCH)
    p.add_argument("--ci-red", dest="ci_red", action="store_true",
                   help="CI của PR này ĐỎ (và bạn đã xác minh cái đỏ đó không đến từ nó) "
                        "HOẶC CHƯA XONG mà bạn vẫn merge — bắt buộc kèm --note, ghi thẳng "
                        "lên PR. `--force` KHÔNG mở rào CI (#2639/#2669).")

    p = add("pr-merge", cmd_pr_merge,
            "CẢ CHUỖI merge trong một lệnh: con trước → chờ CI → kiểm con trỏ → umbrella")
    p.add_argument("pr", type=int)
    p.add_argument("--no-wait", action="store_true",
                   help="không chờ CI (khi đã biết chắc)")
    p.add_argument("--timeout", type=int, default=1800,
                   help="giây tối đa cho mỗi chặng chờ CI (mặc định 1800)")
    p.add_argument("--force", action="store_true",
                   help="bỏ qua điều kiện (chỉ khi người yêu cầu rõ)")
    p.add_argument("--require-ci", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--batch-verified", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--no-subs", action="store_true",
                   help="KHÔNG merge PR con của cụm trước (chỉ khi người yêu cầu rõ)")
    p.add_argument("--self", dest="self_merge", action="store_true",
                   help="tự merge PR mình đã code — PHÁ tách vai, bắt buộc kèm --note")
    p.add_argument("--note", help="lý do tự merge, ghi thẳng lên PR")

    p = add("gc", cmd_gc, "thu hồi lease chết + xoá branch/worktree sau merge")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-submodules", action="store_true")
    p.add_argument("--no-close", action="store_true",
                   help="chỉ gắn nhãn, KHÔNG đóng issue (mặc định là đóng)")
    p.add_argument("--close", action="store_true",
                   help=argparse.SUPPRESS)  # tương thích ngược: đóng đã là mặc định
    p.add_argument("--include-abandoned", action="store_true",
                   help="xoá cả branch/worktree của PR đóng mà không merge (mất code, cân nhắc)")

    add("status", cmd_status, "bảng điều phối")

    p = add("unlock", cmd_unlock, "mở khoá tay (chỉ khi session giữ lease đã chết)")
    p.add_argument("key")
    p.add_argument("--force", action="store_true")
    p.add_argument("--note")

    add("hook-guard", cmd_hook_guard, "(nội bộ) hook PreToolUse")

    a = ap.parse_args()
    try:
        r = a.fn(a)
        return r if isinstance(r, int) else 0
    except Fail as e:
        print(f"[tal] {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
