def lease_is_mine(issue: int) -> bool:
    """Lease đang tồn tại của issue này có phải của CHÍNH session đang chạy không.

    `local_lock` đã re-entrant cho cùng session, nhưng `ref_create` chỉ biết "ref
    có tồn tại hay không", không biết AI giữ — hai tầng bất đối xứng, nên một
    session quay lại issue của chính nó bị báo "session khác đang giữ" (#1476).

    Thông điệp sai đó đẩy người vận hành về phía nguy hiểm: phản ứng đúng (làm
    tiếp) trông như phạm luật, còn phản ứng sai (`tal unlock` để cướp lease) thì
    lại được chính thông điệp gợi ý.

    Hết hạn thì KHÔNG tính là của mình — lease quá TTL là lease đã mất, dù trước
    đó mình giữ; phải đi qua đường thu hồi bình thường.
    """
    led, _, upd = ledger_read(issue)
    lease = led.get("lease") or {}
    if lease.get("session") != session_id():
        return False
    return not lease_expired(led, upd)


def cmd_claim(a):
    if a.split:
        # Nhánh riêng cho một sub-issue: hợp lệ, vì tên vẫn là `issue-<số issue thật>`.
        root, group = a.issue, [a.issue]
        if not parent_of(a.issue):
            warn(f"#{a.issue} không phải sub-issue của issue nào — --split ở đây chỉ là nhận lẻ")
    else:
        root, group = resolve_group(a.issue)
        if root != a.issue and not a.force_root:
            warn(f"#{a.issue} là sub-issue của #{root} — nhận cả nhóm theo parent #{root}. "
                 f"Muốn branch riêng cho #{a.issue} thì dùng --split.")

    d0 = issue_data(root)
    names = {x for x in d0["labels"]}
    if not gate_open(names) and not a.force:
        raise Fail(f"#{root} chưa có nhãn {L_READY} — vòng lặp không tự nhặt. Dùng --force nếu người yêu cầu.")
    if L_DEAD in names and not a.force:
        raise Fail(f"#{root} đang ở dead-letter, cần người xử lý trước", 2)

    # Rào vùng file chạy TRƯỚC khi tạo ref: từ chối ở đây thì chưa có gì phải
    # rollback, và session bị chặn không để lại dấu vết nào cho `gc` phải dọn.
    # Loại chính nhóm mình ra — nhận lại lease của mình không được tự chặn mình.
    # #2300 A19 — vượt rào VÙNG là một quyết định riêng, không đi kèm miễn phí với
    # `--force` (vốn chỉ nói "nhặt issue chưa-ready/dead-letter hộ người").
    regions = guard_regions(a.region, exclude=set(group) | {root},
                            force=getattr(a, "force_region", False))

    keys = [f"issue-{n}" for n in group]
    sha = head_sha()
    # #2300 — quyền "nhận lại" đo MỘT lần trước vòng, và đo theo TỪNG KEY: sổ của
    # root chỉ chứng minh được các key mà CHÍNH lease root liệt kê. Trước đây
    # `lease_is_mine(root)` trả lời cho MỌI ref đã-tồn-tại trong nhóm, nên một ref
    # `issue-<con>` do session khác `--split` giữ bị "adopt" nhầm — và lần release
    # sau xoá luôn lease sống của họ.
    led0, _, upd0 = ledger_read(root)
    lease0 = led0.get("lease") or {}
    mine0 = lease0.get("session") == session_id() and not lease_expired(led0, upd0)
    my_keys0 = set(lease0.get("keys") or [])
    created: list[str] = []          # ref do CHÍNH LẦN CHẠY NÀY tạo — rollback được
    adopted: list[str] = []          # ref đã có sẵn và là của mình — KHÔNG được xoá
    try:
        for k in keys:
            if not local_lock(k):
                raise Fail(f"{k}: session khác trên máy này đang giữ", BUSY)
            if not ref_create(k, sha):
                # Ref đã có — nhưng của AI? Chỉ nhận lại khi sổ root ghi ĐÚNG key
                # này trong lease còn hạn của chính mình.
                if mine0 and k in my_keys0:
                    adopted.append(k)
                    continue
                local_unlock(k)
                raise Fail(f"{k}: session khác đang giữ lease (ref đã tồn tại)", BUSY)
            created.append(k)
    except Fail:
        # Nhận nhóm là all-or-nothing, nhưng chỉ trả lại thứ MÌNH VỪA TẠO. Xoá cả
        # ref chỉ nhận lại là tự tay vứt một lease đang giữ — biến một lần claim
        # hỏng thành mất quyền ghi trên việc đang làm dở.
        for k in created:
            ref_delete(k)
            local_unlock(k)
        raise

    # #2300 — mọi bước sau khi đã cầm ref nằm trong MỘT vùng rollback: trước đây
    # `ledger_write` hỏng (POST comment fail) nổ SAU khi ref + worktree đã dựng,
    # NGOÀI try, để lại ref sống không sổ trôi về đường orphan-grace. Rollback chỉ
    # trả thứ mình vừa tạo; ref adopted giữ nguyên (lease cũ vẫn của mình).
    def _rollback_created():
        for k in created:
            ref_delete(k)
            local_unlock(k)

    try:
        led, cid, _ = ledger_read(root)
    except Fail:
        _rollback_created()
        raise
    led["group"] = group
    led["branch"] = f"issue-{root}"
    led["epoch"] = led.get("epoch", 0) + 1        # fencing token, đơn điệu tăng
    led["attempts"] = led.get("attempts", 0) + 1
    led["state"] = "executing"
    led["lease"] = {
        "key": f"issue-{root}",
        "keys": keys,
        "epoch": led["epoch"],
        "session": session_id(),
        "host": socket.gethostname(),
        "pid": os.getpid(),
        # #2704 — PID của agent CHA, thứ ánh xạ được sang địa chỉ nhắn tin.
        # KHÁC `pid` ngay trên: cái đó là tiến trình `tal`, chết ngay sau lệnh.
        "agent_pid": agent_pid(),
        "ttl": TTL,
        "regions": regions,               # #2270 — rỗng = không giữ vùng nào
        "acquired_at": iso(now()),
        "expires_at": iso(now() + timedelta(seconds=TTL)),
    }

    # Dead-letter đếm THẤT BẠI, không đếm lần claim. `attempts` tăng ở MỌI lần
    # giành issue — kể cả khi chỉ claim để đọc rồi nhả ngay, kể cả khi vòng trước
    # đã ship và issue được claim lại cho phần còn dở (ca `Refs #N`). Đếm nhầm cái
    # đó thì một issue lành bị dán `dead-letter` và ra khỏi hàng đợi vĩnh viễn —
    # đã xảy ra thật với #1323 và #1353.
    #
    # `review_rounds` chỉ tăng khi review kết luận `changes` (#1354), tức đúng
    # nghĩa "đã thử và CHƯA ĐẠT". Đó mới là con số ngưỡng nên đứng trên.
    failures = led.get("review_rounds", 0)
    if failures >= MAX_ATTEMPTS:
        led["state"] = "dead_letter"
        led["lease"] = None
        ledger_write(led, cid, f"dead-letter: {failures} vòng review chưa đạt, "
                               f"quá MAX_ATTEMPTS={MAX_ATTEMPTS} (claim: {led['attempts']} lần)")
        for k in keys:
            ref_delete(k)
            local_unlock(k)
        for n in group:
            set_state_labels(n, {L_DEAD, L_BLOCKED})
        raise Fail(
            f"#{root} vượt {MAX_ATTEMPTS} lần thử → dead-letter, cần người.\n"
            f"Đường chính danh cho NGƯỜI mở khoá: `tal requeue {root} --note \"<vì sao lần này sẽ khác>\"` "
            "(#2300 — đừng gỡ nhãn tay: ledger là nguồn sự thật, nhãn sẽ bị đồng bộ lại).", 2)

    try:
        wt = ensure_worktree(root, led["branch"])
        led["lease"]["worktree"] = str(wt)
        cid = ledger_write(led, cid, f"claim epoch={led['epoch']} session={session_id()[:8]} wt={wt.name}")
    except Fail:
        _rollback_created()
        raise

    for n in group:
        # #2300 — GIỮ trạng thái review đang gắn: claim (kể cả --force để đọc)
        # từng quét `agent:review-passed`/`awaiting-review`, làm PR đã-pass thành
        # chưa-review trong mắt cổng merge. Chỗ duy nhất được tháo chúng là
        # `tal pr` khi push BẢN MỚI — vì chỉ lúc đó "đã review" mới hết đúng.
        set_state_labels(n, {L_WORKING},
                         preserve={L_PASSED, L_AWAIT, L_REVIEWING, L_CHANGES})

    (wt / LEASE_FILE).write_text(json.dumps({
        "repo": C.repo, "issue": root, "group": group, "branch": led["branch"],
        "epoch": led["epoch"], "session": session_id(), "keys": keys,
        "regions": regions,
        "comment_id": cid, "acquired_at": led["lease"]["acquired_at"],
    }, indent=2))

    out = {"issue": root, "group": group, "branch": led["branch"], "worktree": str(wt),
           "epoch": led["epoch"], "attempts": led["attempts"], "ttl": TTL,
           "regions": regions, "base": BASE_BRANCH, "session": session_id()}
    if a.json:
        return emit(out, True)
    print(f"đã giành #{root} (nhóm {group}) epoch={led['epoch']} attempt={led['attempts']}")
    print(f"worktree: {wt}\nbranch:   {led['branch']} (từ origin/{BASE_BRANCH})")
    if regions:
        print(f"vùng giữ: {', '.join(regions)}")
    return out


def lease_file(start: Path | None = None, search: bool = True) -> tuple[Path, dict]:
    """Tìm thẻ lease: leo từ cwd lên trước; không có thì dò các worktree của CHÍNH session này."""
    p = (start or Path.cwd()).resolve()
    for cand in [p] + list(p.parents):
        f = cand / LEASE_FILE
        if f.is_file():
            return cand, json.loads(f.read_text())

    if search:  # tiện dụng: gọi tal từ gốc repo vẫn nhận ra worktree của mình
        mine = []
        for f in sorted(C.worktrees_dir.glob(f"*/{LEASE_FILE}")):
            try:
                d = json.loads(f.read_text())
            except Exception:
                continue
            if d.get("released"):
                continue          # thẻ đã nhả: giữ để hook canh, nhưng không phải lease sống
            if d.get("session") == session_id():
                mine.append((f.parent, d))
        if len(mine) == 1:
            return mine[0]
        if len(mine) > 1:
            raise Fail(
                "session này đang giữ nhiều worktree: "
                + ", ".join(f"#{d['issue']}" for _, d in mine)
                + " — hãy `cd` vào worktree cần dùng rồi chạy lại", 3)

    # #2238 — thông điệp cũ dừng ở "không thấy", và người đọc suy ra lối thoát gần nhất
    # là `claim` lại: đúng cái BUMP EPOCH mà fencing token sinh ra để ngăn. Thẻ mất
    # KHÔNG đồng nghĩa lease mất — sổ trên GitHub mới giữ trạng thái có thẩm quyền —
    # nên phải nói ra đường phục hồi không phá gì.
    raise Fail(
        f"không thấy {LEASE_FILE} — bạn không ở trong worktree của một issue đã nhận.\n"
        f"       Nếu lease VẪN CÒN mà chỉ mất thẻ (worktree bị prune/dời): "
        f"`tal adopt [<issue>]` dựng lại thẻ từ sổ, GIỮ NGUYÊN epoch.\n"
        f"       Chưa nhận issue nào thì `tal queue` rồi `tal claim <issue>`.", 3)


def do_assert(quiet: bool = False) -> dict:
    wt, lf = lease_file()
    if lf.get("released"):
        raise Fail(
            f"LEASE ĐÃ NHẢ: worktree này thuộc issue #{lf['issue']} nhưng lease đã trả lại "
            f"(lúc {lf.get('released_at','?')}). Nhận lại bằng `tal claim {lf['issue']}` "
            "trước khi ghi hay push.", 4)
    key = f"issue-{lf['issue']}"
    if not ref_exists(key):
        raise Fail(f"HẾT LEASE: ref {key} không còn. DỪNG mọi thao tác ghi, đừng push.", 4)
    led, _, upd = ledger_read(lf["issue"])
    lease = led.get("lease") or {}
    if lease.get("session") != lf["session"]:
        raise Fail(f"MẤT LEASE: sổ ghi chủ hiện tại là {lease.get('session','(trống)')[:8]}…, không phải bạn. DỪNG.", 4)
    if lease.get("epoch") != lf["epoch"]:
        raise Fail(f"FENCED: epoch của bạn={lf['epoch']} nhưng sổ={lease.get('epoch')}. Lease đã bị cấp lại. DỪNG.", 4)
    if lease_expired(led, upd):
        raise Fail("LEASE QUÁ HẠN (theo đồng hồ server): chạy `tal renew` sớm hơn, hoặc nhận lại issue.", 4)
    # #2177 — `assert` là cổng của MỌI thao tác ghi, nên trước khi trả về OK phải
    # chắc thư mục này còn THẬT là một worktree git; mồ côi thì mọi lệnh git chạy
    # từ đây sẽ im lặng ghi vào repo cha. Đặt SAU các kiểm tra lease để thông điệp
    # lỗi lease (released/hết hạn/fenced) — vốn đúng và đủ để dừng tay — không bị
    # che mất bởi lỗi mồ côi.
    assert_worktree_attached(wt)
    left = (upd + timedelta(seconds=lease.get("ttl", TTL))) - now()
    if not quiet:
        print(f"lease OK — #{lf['issue']} epoch={lf['epoch']} còn {human_delta(left.total_seconds())}")
    return {"issue": lf["issue"], "epoch": lf["epoch"], "worktree": str(wt),
            "expires_in_sec": int(left.total_seconds()), "group": lf["group"]}


def cmd_assert(a):
    return emit(do_assert(quiet=a.json), a.json)


def cmd_renew(a):
    _, lf = lease_file()
    led, cid, _ = ledger_read(lf["issue"])
    lease = led.get("lease") or {}
    if lease.get("session") != lf["session"] or lease.get("epoch") != lf["epoch"]:
        raise Fail("không gia hạn được: lease không còn thuộc session này", 4)
    # `lease` LÀ chính `led["lease"]` (không phải bản sao), nên sửa tại chỗ rồi ghi
    # cả sổ: `regions` và mọi field khác đi theo nguyên vẹn. Dựng lại dict lease ở
    # đây sẽ ÂM THẦM nhả vùng đang giữ ngay giữa lúc đang sửa file — heartbeat mà
    # làm mất quyền thì tệ hơn không heartbeat.
    lease["expires_at"] = iso(now() + timedelta(seconds=lease.get("ttl", TTL)))
    ledger_write(led, cid, None)
    regions = lease.get("regions") or []
    print(f"gia hạn #{lf['issue']} thêm {human_delta(lease.get('ttl', TTL))}"
          + (f" · giữ nguyên vùng: {', '.join(regions)}" if regions else ""))


def adopt_target_issue(explicit: int | None) -> int:
    """Thẻ mất rồi thì `lease_file()` không nói được đây là issue nào — hỏi chỗ khác.

    Thứ tự: người nói > tên thư mục worktree > sổ trên GitHub. Hai nguồn đầu chỉ là
    MANH MỐI để biết hỏi sổ nào; quyền quyết định ai giữ lease nằm trọn ở bước sau
    (`cmd_adopt`), nên đoán sai ở đây cũng không cấp thêm quyền cho ai.
    """
    if explicit:
        return explicit

    p = Path.cwd().resolve()
    try:
        wtdir = C.worktrees_dir.resolve()
    except OSError:
        wtdir = C.worktrees_dir
    for cand in [p] + list(p.parents):
        if cand.parent == wtdir:
            m = re.fullmatch(r"issue-(\d+)", cand.name)
            if m:
                return int(m.group(1))

    # Không đứng trong worktree nào (đúng ca đã xảy ra: thư mục bị dời/prune). Hỏi
    # NGUỒN CÓ THẨM QUYỀN — ref nào đang sống, và sổ của nó ghi ai giữ. Lease review
    # (`pr-<n>`) không tính: nó cố ý không ghi chủ vào sổ, và cũng không có thẻ.
    mine: list[int] = []
    for key in refs_all():
        m = re.fullmatch(r"issue-(\d+)", key)
        if not m:
            continue
        n = int(m.group(1))
        led, _, _ = ledger_read(n)
        if (led.get("lease") or {}).get("session") == session_id():
            mine.append(n)
    if len(mine) == 1:
        return mine[0]
    if len(mine) > 1:
        raise Fail("session này đang giữ nhiều lease: "
                   + ", ".join(f"#{n}" for n in sorted(mine))
                   + " — nói rõ issue nào: `tal adopt <issue>`", 3)
    raise Fail("không thấy lease nào của session này trên sổ — không có gì để dựng lại. "
               "`tal status` xem ai đang giữ gì; `tal claim <issue>` nếu muốn nhận mới.", 3)


def cmd_adopt(a):
    """Dựng lại `.tal-lease.json` từ sổ — KHÔNG bump epoch, KHÔNG giành thêm gì (#2238).

    Thẻ trên đĩa là *cache* của một trạng thái sống trên GitHub, nhưng trước #2238 nó
    là đường DUY NHẤT để `renew|assert|pr|release` biết mình đang giữ issue nào. Mất
    thẻ trong khi lease vẫn sống ⇒ cả bốn lệnh rơi vào `Fail(..., 3)`, và hai lối
    thoát còn lại đều phá thứ khác: `claim` lại thì **bump epoch** (đúng cái fencing
    token sinh ra để ngăn), `unlock --force` thì **vứt một lease đang sống**. Đã xảy
    ra thật khi làm #2197 — người làm phải chép tay thẻ từ ledger đọc trên GitHub.

    Lệnh này KHÔNG phải cửa sau, và chỗ giữ cho nó không thành cửa sau là hai điều
    kiện dưới đây — nó chỉ **khôi phục** thứ mà ref + sổ đã công nhận là của mình:

    1. sổ phải ghi `lease.session == session_id()`;
    2. ref CAS `refs/tempo/leases/issue-<n>` phải còn sống.

    Thiếu một trong hai ⇒ TỪ CHỐI. Lease của session khác là ca cần người, không
    phải ca để công cụ tự xử.

    Cố ý KHÔNG ghi gì lên sổ: `ledger_write` luôn đặt lại `heartbeat`, mà TTL đo theo
    `updated_at` của chính comment ấy — một dòng history vô hại sẽ lặng lẽ GIA HẠN
    lease. Adopt phải là thao tác chỉ-đọc phía GitHub, nếu không nó cấp thêm thời
    gian mà người gọi không hề xin.
    """
    issue = adopt_target_issue(a.issue)
    led, cid, upd = ledger_read(issue)
    lease = led.get("lease") or {}

    if not lease:
        raise Fail(
            f"#{issue}: sổ ghi KHÔNG session nào đang giữ (state={led.get('state')!r}). "
            f"Không có lease để dựng lại thẻ — `tal claim {issue}` nếu muốn nhận.", 3)

    owner = lease.get("session") or ""
    if owner != session_id():
        raise Fail(
            f"#{issue}: lease thuộc session {owner[:8] or '(trống)'}…, KHÔNG phải bạn "
            f"({session_id()[:8]}…). `adopt` chỉ dựng lại thẻ cho lease của CHÍNH mình — "
            f"nó không giành được gì. Đây là ca cần người: `tal status` xem ai giữ, và "
            f"chỉ khi chắc chắn session đó đã chết mới `tal unlock issue-{issue} --force`.", 5)

    key = f"issue-{issue}"
    if not ref_exists(key):
        raise Fail(
            f"#{issue}: sổ ghi lease là của bạn nhưng ref {key} KHÔNG còn — lease đã bị "
            f"thu hồi (gc/unlock) và sổ chưa kịp dọn. Không dựng lại thẻ cho một lease đã "
            f"chết; nhận lại bằng `tal claim {issue}` (epoch sẽ tăng, đúng như phải thế).", 3)

    keys = lease.get("keys") or [f"issue-{n}" for n in led.get("group", [issue])]
    branch = led.get("branch") or f"issue-{issue}"
    epoch = lease.get("epoch", led.get("epoch"))

    expired = lease_expired(led, upd)
    for k in keys:
        if k != key and not ref_exists(k):
            warn(f"{k}: ref của issue cùng nhóm đã mất — nhóm không còn nguyên vẹn, "
                 f"kiểm `tal status` trước khi ghi")
        if not local_lock(k):
            warn(f"{k}: khoá cục bộ đang do session khác trên máy này giữ, dù sổ + ref "
                 f"nói lease là của bạn — kiểm `tal status` trước khi ghi")

    # `ensure_worktree` là chỗ duy nhất biết ba ca: thư mục còn và gắn đúng (dùng lại),
    # thư mục mất (dựng lại từ branch), thư mục còn mà đăng ký git đã prune (MỒ CÔI ⇒
    # từ chối, #2177). Ca thứ ba chính là cái đã làm mất thẻ — và nó vẫn phải cần người.
    wt = ensure_worktree(issue, branch)

    (wt / LEASE_FILE).write_text(json.dumps({
        "repo": C.repo, "issue": issue, "group": led.get("group", [issue]), "branch": branch,
        "epoch": epoch, "session": session_id(), "keys": keys,
        "regions": list(lease.get("regions") or []),   # #2270 — sổ là nguồn, thẻ chỉ chép lại
        "comment_id": cid, "acquired_at": lease.get("acquired_at"),
    }, indent=2))

    out = {"issue": issue, "group": led.get("group", [issue]), "branch": branch,
           "worktree": str(wt), "epoch": epoch, "session": session_id(),
           "expired": expired, "adopted": True}
    if expired:
        warn(f"#{issue}: lease đã QUÁ HẠN theo đồng hồ server — thẻ đã dựng lại nhưng "
             f"`tal assert` sẽ vẫn từ chối. Chạy `tal renew` NGAY, và biết rằng `tal gc` "
             f"có thể đã cấp issue này cho người khác.")
    if a.json:
        return emit(out, True)
    print(f"đã dựng lại thẻ lease #{issue} epoch={epoch} (GIỮ NGUYÊN, không bump)")
    print(f"worktree: {wt}\nbranch:   {branch}")
    return out


def mark_lease_released(wt: Path) -> None:
    """Nhả lease = ĐÁNH DẤU thẻ, không xoá nó.

    Worktree được giữ lại cho vòng sửa sau, nhưng `hook-guard` lấy căn cứ từ chính
    thẻ này — xoá thẻ đi thì worktree ấy KHÔNG còn ai bảo vệ, và WIP của session khác
    trôi vào đó (đã xảy ra ở `.claude/worktrees/issue-1306`: 5 file WIP không phải của
    session tạo ra nó, giống hệt từng byte với WIP ở worktree gốc).

    `epoch` bị bỏ vì nó là fencing token của một lease đã hết hiệu lực; giữ lại chỉ tạo
    ảo giác còn quyền ghi. Lần `tal claim` sau ghi đè thẻ mới.
    """
    f = wt / LEASE_FILE
    if not f.is_file():
        return
    try:
        d = json.loads(f.read_text())
    except Exception:
        # #2300 — thẻ hỏng thì GHI ĐÈ bằng thẻ released tối thiểu, không unlink:
        # unlink là tháo hook-guard khỏi worktree (#1342 lỗi 4).
        d = {"note": "thẻ cũ hỏng, ghi đè khi release (#2300)"}
    d["released"] = True
    d["released_at"] = iso(now())
    d.pop("epoch", None)
    # #2300 — ghi NGUYÊN TỬ: write_text bị kill giữa chừng để lại JSON hỏng, và
    # nhánh except phía trên sẽ UNLINK thẻ hỏng ở lần sau — worktree mất hook-guard,
    # đúng hiểm hoạ #1342 mà thẻ sinh ra để chống. tmp + os.replace thì hoặc thẻ
    # cũ nguyên vẹn, hoặc thẻ mới trọn vẹn, không bao giờ nửa vời.
    tmp = f.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(d, indent=2))
    os.replace(tmp, f)


def release(issue: int, state: str, labels: set[str], note: str, keep_worktree: bool = True,
            drop: set[str] | None = None):
    led, cid, upd = ledger_read(issue)
    lease = led.get("lease") or {}
    # #2300 A3 — không nhả lease của NGƯỜI KHÁC: một thẻ cũ (session bị gc thu hồi
    # rồi issue được claim lại) từng release được lease sống của session mới —
    # sổ set lease=None + ref bị xoá, `tal assert` của họ chết giữa việc.
    if lease and lease.get("session") != session_id() and not lease_expired(led, upd):
        raise Fail(
            f"#{issue} đang được giữ bởi session `{str(lease.get('session', '?'))[:8]}…` "
            f"(hết hạn {lease.get('expires_at', '?')}) — KHÔNG nhả lease của người khác.\n"
            "Nếu chắc chắn session đó đã chết: chờ `tal gc` thu theo TTL, hoặc "
            "`tal unlock <key> --force --note \"…\"`.", BUSY)
    keys = lease.get("keys") or [f"issue-{issue}"]
    led["state"] = state
    led["lease"] = None
    ledger_write(led, cid, note)
    for k in keys:
        ref_delete(k)
        local_unlock(k)
    for n in led.get("group", [issue]):
        set_state_labels(n, labels, drop)
    # Thẻ được ĐÁNH DẤU released chứ không xoá: `lease_file(search=True)` bỏ qua thẻ
    # đã released nên không còn nhập nhằng "hai worktree của mình", còn `hook-guard`
    # vẫn thấy thẻ và tiếp tục canh worktree đó (#1342 lỗi 4).
    mark_lease_released(C.worktrees_dir / f"issue-{issue}")
    if not keep_worktree:
        remove_worktree(issue)


def cmd_release(a):
    try:
        _, lf = lease_file()
        card_issue = lf["issue"]
    except Fail:
        if not a.issue:
            raise
        card_issue = None
    # #2300 A1 — `--issue` TƯỜNG MINH không bao giờ bị CWD đè. Bug thật đã cắn:
    # đứng trong worktree issue-2050, chạy `tal release --issue 2162` → thẻ ở CWD
    # thắng, #2050 bị nhả, #2162 không đụng tới, exit 0. Lệch thì DỪNG, không đoán.
    if a.issue and card_issue and a.issue != card_issue:
        raise Fail(
            f"--issue {a.issue} nhưng thẻ lease ở CWD thuộc #{card_issue} — không đoán hộ.\n"
            f"Muốn nhả #{a.issue}: chạy từ GỐC repo (ngoài mọi worktree) hoặc từ chính "
            f"worktree issue-{a.issue}. Muốn nhả #{card_issue} (worktree đang đứng): bỏ --issue.", 2)
    issue = a.issue or card_issue
    # `abandon` trả issue VỀ hàng đợi (mình bỏ, ai lấy cũng được). `no-op` thì khác hẳn:
    # đã kiểm và KHÔNG có gì phải làm. Hai cái này từng dùng chung một đường, và hậu quả
    # là issue "không có gì làm" bị nhặt lại mỗi lượt vì nhãn cổng `ready` vẫn còn —
    # attempts leo dần rồi tới lần thứ MAX_ATTEMPTS+1 nó bị dán dead-letter như thể độc.
    # Nên `no-op` tháo luôn nhãn cổng: quyền quyết định (đóng issue, hay giữ làm ghi chú
    # về một mìn chưa nổ) trả về cho người.
    mapping = {
        "review":  ("review", {L_REVIEWING, L_AWAIT}, set()),
        "blocked": ("blocked", {L_BLOCKED}, set()),
        "abandon": ("queued", set(), set()),
        "no-op":   ("no_op", set(), {L_READY}),
        "shipped": ("shipped", {L_SHIPPED}, set()),
    }
    state, labels, drop = mapping[a.state]
    if a.state == "no-op" and not a.note:
        raise Fail("--state no-op bắt buộc có --note: nói rõ đã kiểm những gì mới kết luận "
                   "là không có việc", 2)
    release(issue, state, labels, a.note or f"release → {a.state}", drop=drop)
    if drop:
        print(f"đã nhả lease #{issue} → {a.state}, tháo nhãn {', '.join(sorted(drop))} "
              "(issue không còn tự vào hàng đợi; người quyết đóng hay giữ)")
    else:
        print(f"đã nhả lease #{issue} → {a.state}")


