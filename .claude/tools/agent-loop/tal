                           + "/".join((_SESSION_OVERRIDE_VAR,) + _AGENT_SESSION_VARS)
                           + ", rơi về băm hostname+ppid; tách vai sẽ yếu"))
    if sid_src == _SESSION_OVERRIDE_VAR:
