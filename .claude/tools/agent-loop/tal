def _env_int(name: str, default: int) -> int:
    """#2300 — env rác không được thành traceback lúc import: nói rõ rồi thoát 2."""
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        return int(raw)
    except ValueError:
        print(f"[tal] {name}={raw!r} không phải số nguyên — sửa hoặc bỏ biến này "
              f"(ví dụ TAL_TTL=2700, không phải '45m').", file=sys.stderr)
        sys.exit(2)


