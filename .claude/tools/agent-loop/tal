            check(f"{r} delete_branch_on_merge", True)
        elif a.fix:
            gh(["api", f"repos/{r}", "-X", "PATCH", "-F", "delete_branch_on_merge=true"], check=False)
            check(f"{r} delete_branch_on_merge", True, "đã bật")
        else:
            check(f"{r} delete_branch_on_merge", False, "đang tắt — `tal doctor --fix`")

    print("\n`tal` ở worktree chính có phải bản mới nhất")
    # Hook PreToolUse chạy `tal` của WORKTREE CHÍNH, không phải bản trên nhánh đang
    # làm. Nên một bản vá đã merge vào base VẪN VÔ HIỆU cho tới khi cây chính được
    # cập nhật — và không có gì báo. Đã trả giá: bản vá #1383 (rào lease thôi nhốt
    # session) merge xong nhưng cây chính giữ bản cũ ⇒ rào cũ nhốt session lần thứ
    # ba, và lần đó phải nhờ người chạy lệnh bên ngoài mới thoát.
    #
    # Đây là lớp lỗi tệ nhất của một công cụ tự động: bản sửa TỒN TẠI, ĐÃ MERGE,
    # mà vẫn không có tác dụng.
    # Đường dẫn CỐ ĐỊNH, không phải `__file__`: bản đang chạy có thể là bản trong
    # worktree của một issue, và khi đó `__file__` cho ra `.claude/worktrees/…/tal`
    # — soi nhầm file, rồi báo "đã cũ" cho một thứ không phải cái hook dùng.
    rel = Path(".claude") / "tools" / "agent-loop" / "tal"
    try:
        run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=str(C.main_worktree), check=False)
        local = run(["git", "hash-object", str(C.main_worktree / rel)],
                    cwd=str(C.main_worktree)).stdout.strip()
        remote = run(["git", "rev-parse", f"origin/{BASE_BRANCH}:{rel}"],
                     cwd=str(C.main_worktree), check=False).stdout.strip()
        if not remote:
            check("so được với origin", False, "không đọc được bản trên origin — bỏ qua")
        elif local == remote:
            check(f"khớp origin/{BASE_BRANCH}", True)
        else:
            check(f"khớp origin/{BASE_BRANCH}", False,
                  f"ĐÃ CŨ — hook đang chạy bản này, nên bản vá đã merge vẫn vô hiệu. "
                  f"Sửa: git -C {C.main_worktree} checkout origin/{BASE_BRANCH} -- {rel}")
    except Exception as e:                      # noqa: BLE001 — doctor không được chết vì một mục
        check("so với origin", False, f"không kiểm được: {e}")

    print("\ngitignore")
    gi = (C.main_worktree / ".gitignore").read_text() if (C.main_worktree / ".gitignore").exists() else ""
    for pat in (".claude/worktrees/", LEASE_FILE):
        check(f"bỏ qua {pat}", pat in gi, "" if pat in gi else "thêm vào .gitignore")

    print("\n" + ("mọi thứ ổn" if ok else "còn hạng mục chưa đạt — xem dấu ✘"))
    return 0 if ok else 1


