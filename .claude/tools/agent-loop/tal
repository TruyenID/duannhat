def pr_issue(pr: int) -> int:
    """#2300 — ba đường ra RÕ RÀNG: số issue / Gone (PR 404 thật) / Fail (không đo
    được). Trước đây gh fail vì quota cũng thành "không suy ra được" và reap xoá
    ref lease review sống. Fallback từ body chỉ nhận dòng `Closes #N` ĐỨNG RIÊNG
    (đúng format `tal pr` sinh) — một câu trích dẫn "fixes #123" giữa văn xuôi
    từng làm review/merge ghi sổ vào issue của NGƯỜI KHÁC."""
    p = gh(["pr", "view", str(pr), "-R", C.repo, "--json", "headRefName,body,number"], check=False)
    if p is None or p.returncode != 0:
        blob = ("" if p is None else (p.stderr or "") + (p.stdout or "")).lower()
        if "could not resolve" in blob or "not found" in blob or "no pull requests found" in blob:
            raise Gone(f"PR #{pr} không tồn tại")
        raise Fail(f"KHÔNG ĐO ĐƯỢC PR #{pr} — gh thất bại: "
                   f"{('' if p is None else (p.stderr or p.stdout)).strip()[:200]}")
    try:
        d = json.loads(p.stdout.strip() or "{}")
    except json.JSONDecodeError:
        raise Fail(f"KHÔNG ĐO ĐƯỢC PR #{pr} — JSON hỏng")
    m = re.match(r"^issue-(\d+)$", d.get("headRefName", ""))
    if m:
        return int(m.group(1))
    m = re.search(r"(?mi)^\s*(?:closes|fixes|resolves)\s+#(\d+)\s*$", d.get("body") or "")
    if m:
        return int(m.group(1))
    raise Fail(f"PR #{pr} không suy ra được issue (branch {d.get('headRefName')!r}) — "
               "chỉ định tường minh thay vì để tal đoán")


def cmd_review_queue(a):
    live = {r["key"]: r for r in refs_all_full()}
    # #2151 — hàng đợi REVIEW: cùng lý do như open_issues().
    prs = gh_json_required(
        ["pr", "list", "-R", C.repo, "--state", "open", "--limit", "100",
         "--json", "number,title,headRefName,isDraft,labels,updatedAt,author,headRefOid"]
    )
    out = []
    claimed = []          # #2172 — "rỗng vì bị giữ" phải đọc KHÁC "rỗng vì hết việc"
    orphans = []          # #2673 — PR chưa bao giờ VÀO vòng lặp: cũng không phải hết việc
    humans = []           # #2760 — PR của NGƯỜI: agent không đụng, chỉ hiển thị
    for p in prs:
        if p["isDraft"] or not re.match(r"^issue-\d+$", p["headRefName"]):
            continue
        issue = int(p["headRefName"].split("-")[1])
        names = set(issue_data(issue)["labels"])
        if L_AWAIT not in names and L_REVIEWING not in names:
            # #2673 — RỔ THỨ BA. Trước đây chỗ này `continue` im lặng, nên một PR
            # mở ngoài vòng lặp (không có sổ ledger ⇒ `tal claim` chưa từng chạy
            # ⇒ `tal pr` chưa từng chạy ⇒ không ai gắn nhãn chờ-review) vô hình
            # với CẢ HAI hàng đợi: `queue` lọc `agent:ready`, `review-queue` lọc
            # nhãn này. Đo được: PR #2662 nằm mở, mọi check xanh, `CLEAN`, suốt
            # 5h17 (mở 17:23:03Z, tới 22:39:53Z mới có sổ vì một session đi
            # claim issue) trong khi chín lượt gọi liên tiếp báo "hàng đợi rỗng".
            #
            # Cùng họ #2172 (rỗng-vì-bị-giữ) và #2669 (`pending` coi là xong):
            # một cổng im lặng vì nó đo NHÃN thay vì đo VIỆC.
            #
            # Chỉ những PR KHÔNG có sổ mới vào rổ này: có sổ mà thiếu nhãn là
            # trạng thái khác (vòng sửa đang chạy, hoặc nhãn vừa bị gỡ tay), và
            # gộp chung sẽ làm rổ kêu oan ở gần như mọi PR — rào kêu oan thì bị
            # tắt, và lúc đó mất luôn phần nó canh đúng.
            try:
                led_probe, cid_probe, _ = ledger_read(issue)
            except Exception:
                # Không đọc được sổ KHÁC không có sổ (#2300). API hỏng một nhịp
                # mà báo "mồ côi" là dựng ra một cảnh báo sai; bỏ qua lượt này.
                continue
            if cid_probe is None and not led_probe.get("history"):
                author = (p.get("author") or {}).get("login", "?")
                # #2760 — "không có sổ" KHÔNG đồng nghĩa "việc agent bị bỏ rơi".
                # Người mở PR cũng không có sổ. Rổ này được đọc là lời mời nhặt
                # việc, nên xếp PR của người vào đây là mời một session đi ghi
                # verdict tự động — hoặc claim đè — lên việc người ta đang làm.
                #
                # `AGENT_LOGINS` rỗng ⇒ không lọc, giữ nguyên hành vi trước đó.
                bucket = orphans if pr_is_agent_authored(author) else humans
                bucket.append({
                    "pr": p["number"], "issue": issue, "title": p["title"],
                    "updated": p["updatedAt"], "author": author,
                })
            continue
        r = live.get(f"pr-{p['number']}")
        if r is not None:
            # PR bị lọc vì session khác đang giữ lease — trước đây chỗ này `continue`
            # im lặng, và một session làm ĐÚNG LUẬT ("hàng đợi rỗng → kết thúc lượt")
            # báo hết việc trong khi ba PR đang được review ngay lúc đó (#2172).
            pay = ref_payload(r["sha"]) if r.get("type") == "tag" else None
            if pay:
                try:
                    left = (parse_iso(pay["expires_at"]) - now()).total_seconds()
                except (KeyError, ValueError):
                    left = None
                claimed.append({
                    "pr": p["number"], "issue": issue,
                    "by": (pay.get("session") or "?")[:8], "host": pay.get("host"),
                    "mine": pay.get("session") == session_id(),
                    "expires_in": human_delta(left) if left is not None else "?",
                    "orphan": False,
                })
            else:
                claimed.append({"pr": p["number"], "issue": issue, "by": "?", "host": None,
                                "mine": False, "expires_in": "?", "orphan": True})
            continue
        led, _, _ = ledger_read(issue)
        # Không có gì mới thì không review lại: bản đã có verdict được nhận ra bằng
        # SHA, không bằng nhãn (nhãn sống sót qua một lần push mới). Rào rẻ nhất
        # chống đốt tài nguyên vào cùng một bản hai lần.
        if led.get("reviewed_head_sha") and led["reviewed_head_sha"] == p.get("headRefOid"):
            continue
        worker = None
        for h in reversed(led.get("history", [])):
            m = re.search(r"worker session (\w+)", h) or re.search(r"session=(\w+)", h)
            if m:
                worker = m.group(1)
                break
        out.append({"pr": p["number"], "issue": issue, "title": p["title"],
                    "rounds": led.get("reviews_total", led.get("review_rounds", 0)),
                    "changes_rounds": led.get("review_rounds", 0), "worker": worker,
                    "updated": p["updatedAt"]})
    out.sort(key=lambda x: x["updated"])
    result = {"role": "review", "eligible": out, "claimed": claimed,
              "orphans": orphans, "humans": humans}
    if a.json:
        return emit(result, True)
    # "rỗng THẬT" chỉ được nói khi CẢ BA rổ rỗng (#2673).
    #
    # `humans` KHÔNG tính vào đây (#2760): PR của người không phải việc của vòng
    # lặp, nên còn nó mà nói "rỗng THẬT" là đúng — vòng lặp thật sự hết việc.
    # Vẫn in ra để người đọc biết nó tồn tại, chỉ là không mời nhặt.
    if not out and not claimed and not orphans:
        print("không có PR nào chờ review — hàng đợi rỗng THẬT")
    elif not out:
        parts = []
        if claimed:
            parts.append(f"{len(claimed)} PR đang bị session khác giữ (#2172)")
        if orphans:
            parts.append(f"{len(orphans)} PR mở NGOÀI vòng lặp (#2673)")
        print("không có PR nào NHẬN được — nhưng " + " và ".join(parts) + ", KHÔNG phải hết việc")
    for o in out:
        print(f"PR #{o['pr']:<5} ← #{o['issue']:<6} vòng {o['rounds']}  {o['title'][:60]}")
    for c in claimed:
        who = ("session NÀY" if c["mine"]
               else f"session {c['by']}… ({c['host']})" if not c["orphan"]
               else "KHÔNG RÕ AI — ref không mang payload; nghi mồ côi thì `tal gc` phân xử")
        print(f"PR #{c['pr']:<5} ← #{c['issue']:<6} ĐANG GIỮ bởi {who}, còn {c['expires_in']}")
    for o in orphans:
        print(f"PR #{o['pr']:<5} ← #{o['issue']:<6} MỒ CÔI (không có sổ ledger — mở ngoài vòng lặp, "
              f"tác giả {o['author']}). Review được ngay: `tal review-claim {o['pr']}` "
              f"(không đòi nhãn {L_AWAIT}); gắn nhãn đó nếu muốn nó vào rổ `eligible` bình thường.")
    for h in humans:
        print(f"PR #{h['pr']:<5} ← #{h['issue']:<6} của NGƯỜI ({h['author']}) — KHÔNG phải việc của "
              f"vòng lặp. Đừng claim, đừng ghi verdict tự động. Chỉ nêu ở đây để không ai "
              f"tưởng nó bị bỏ rơi.")
    return result


def coder_sessions(led: dict) -> set[str]:
    """Những session đã CODE issue này.

    #2300 — "đã CODE" nghĩa là đã BÀN GIAO PR (`tal pr`), không phải đã từng
    claim: claim-để-đọc rồi release no-op từng biến một session thành "tác giả"
    vĩnh viễn và mất quyền review (#2091 đã cắn). Nguồn chính là trường `coders`
    (append lúc `tal pr`, KHÔNG bị cắt 40 dòng như history — trước đây coder
    vòng đầu trôi khỏi cửa sổ là lọt cả ba cửa tách vai); fallback cho sổ cũ:
    dòng bàn giao "worker session …" còn trong history."""
    out = set(led.get("coders") or [])
    for h in led.get("history", []):
        m = re.search(r"worker session (\w+)", h)
        if m:
            out.add(m.group(1))
    return out


def assert_not_own_work(led: dict, pr: int, what: str, allow: bool, flag: str):
    """Tách vai — cưỡng chế ở CÔNG CỤ, không phải viết luật trong skill (#1397).

    Luật "session code ≠ session review/merge" từng chỉ sống trong skill. Kết quả đo
    được trong MỘT phiên: chín lần tự merge, bởi chính session viết ra luật đó. Không
    phải vì gian — mỗi lần đều có lý do hợp lý tại thời điểm đó. Đó đúng là thứ một
    cái rào phải chống mà một câu chữ thì không.

    Rào cũ chỉ đặt ở `review-claim`. Nhưng `review-verdict` mới là chỗ SINH RA hệ quả
    (nó gắn nhãn quyết định merge), và `merge` là chỗ hệ quả THÀNH THẬT. Chặn một
    trong ba cửa thì hai cửa kia vẫn mở — đã đi qua cả hai.

    Không cấm tuyệt đối: có ca chính đáng (bản vá cho chính công cụ đang hỏng). Nhưng
    phải ĐẮT và ĐỂ LẠI DẤU VẾT — cờ tường minh + `--note` bắt buộc.
    """
    mine = session_id()[:8]
    if mine not in coder_sessions(led):
        return
    if not allow:
        raise Fail(
            f"session này ({mine}…) là session đã CODE PR #{pr} — không được tự {what}.\n"
            f"  Tách vai là lý do tồn tại của cả vòng lặp: một agent tự chấm điểm mình\n"
            f"  thì chữ \"đạt\" không mang thông tin gì.\n"
            f"  Buộc phải làm (vd bản vá cho chính công cụ đang hỏng): `{flag} --note \"<vì sao>\"`.", 5
        )






def pr_was_merged(st: dict) -> bool:
    """PR đã merge thật — tách khỏi CLOSED-không-merge (#2289)."""
    return bool(st.get("mergedAt")) or st.get("state") == "MERGED"

def issue_resettle_blocked(n: int, led: dict | None) -> bool:
    """Không reset issue đã ship/đóng — tránh gỡ shipped vì PR cũ bị thay thế (#2289)."""
    if led is not None and led.get("state") == "shipped":
        return True
    d = issue_data(n)
    if d.get("state") == "CLOSED":
        return True
    if L_SHIPPED in set(d.get("labels") or []):
        return True
    return False


def return_issue_to_code_queue_after_abandoned_pr(issue: int, led: dict, cid: int | None, note: str):
    """PR CLOSED không merge — trả issue về hàng đợi code, đừng bỏ rơi ở awaiting-review (#2289)."""
    group = led.get("group", [issue])
    for n in group:
        if issue_resettle_blocked(n, led if n == issue else None):
            ledger_write(led, cid, f"{note} — bỏ qua reset: #{n} đã ship/đóng (#2289)")
            return
    led["state"] = "queued"
    led["lease"] = None
    ledger_write(led, cid, note)
    for n in group:
        set_state_labels(n, {L_READY}, drop={L_AWAIT, L_REVIEWING, L_PASSED, L_CHANGES})

def cmd_review_claim(a):
    pr = a.pr
    issue = pr_issue(pr)
    led, cid, _ = ledger_read(issue)

    assert_not_own_work(led, pr, "review", getattr(a, "allow_self", False), "--allow-self")

    # #2153 — chỉ claim review trên PR còn MỞ. PR đã merge/đóng thì verdict về sau
    # vô nghĩa (và `review-verdict` cũng sẽ từ chối) — chặn từ cửa vào cho đỡ phí lượt.
    st = gh_json(["pr", "view", str(pr), "-R", C.repo, "--json", "state,mergedAt,headRefOid"], default=None)
    if st is None:
        raise Fail(f"KHÔNG ĐO ĐƯỢC trạng thái PR #{pr} — không claim review khi không đo được (#2151).")
    if st.get("state") != "OPEN":
        if not pr_was_merged(st):
            return_issue_to_code_queue_after_abandoned_pr(
                issue, led, cid,
                f"PR #{pr} đóng không merge — trả issue về hàng đợi code (#2289)",
            )
            raise Fail(
                f"PR #{pr} đã CLOSED (không merge) — không còn gì để review.\n"
                f"  Issue #{issue} đã trả về hàng đợi (`{L_READY}`). Nhặt lại: `tal claim {issue}`.", 2)
        raise Fail(f"PR #{pr} đã {st.get('state')} — không còn gì để review (#2153). "
                   "Nếu vẫn thấy vấn đề trên bản đã merge, mở issue MỚI.", 2)

    key = f"pr-{pr}"
    if not local_lock(key):
        raise Fail(f"{key}: session khác trên máy này đang review", BUSY)
    # #2172 — chủ lease đi trong payload của ref: `tal status`/`review-queue` của
    # session khác đọc được AI đang giữ và còn bao lâu, thay vì in `?` như mồ côi.
    if not ref_create(key, head_sha(), {
        "kind": "review", "pr": pr, "issue": issue,
        # #2300 D2 — sha ĐANG ĐƯỢC REVIEW ghim ngay lúc claim: verdict sẽ so với
        # head sống, coder push bản mới giữa chừng thì verdict phải claim lại,
        # không được đóng dấu pass lên một bản chưa ai đọc.
        "head_sha": st.get("headRefOid") or "",
        "session": session_id(), "host": socket.gethostname(), "pid": os.getpid(),
        "agent_pid": agent_pid(),  # #2704 — xem `agent_addr()`
        "ttl": TTL, "acquired_at": iso(now()), "expires_at": iso(now() + timedelta(seconds=TTL)),
    }):
        local_unlock(key)
        raise Fail(f"PR #{pr} đang được session khác review", BUSY)

    # Từ đây trở đi KHOÁ ĐÃ GIÀNH ĐƯỢC. Mọi lối ra phải nhả nó — kể cả lối ra do
    # lỗi lập trình. #1616: một `NameError` ở dòng ngay dưới để lại `refs/tempo/
    # leases/pr-<N>` không có chủ, và `tal status` in session `?` cho tới hết TTL;
    # hai session sau đó nhận `BUSY` thay vì nhận lỗi thật. Bắt `BaseException`
    # chứ không phải `Exception`: Ctrl-C giữa chừng để lại đúng cái vết ấy.
    try:
        led["state"] = "reviewing"
        ledger_write(led, cid, f"review claim PR #{pr} bởi session {session_id()[:8]}… (vòng {led.get('review_rounds',0)+1})")
        diff_stat = gh(["pr", "diff", str(pr), "-R", C.repo, "--name-only"], check=False).stdout.strip().splitlines()
        out = {"pr": pr, "issue": issue, "round": led.get("review_rounds", 0) + 1,
               "files": diff_stat, "base": BASE_BRANCH,
               "sub_prs": led.get("sub_prs", {}), "key": key}
    except BaseException:
        ref_delete(key)
        local_unlock(key)
        raise
    if a.json:
        return emit(out, True)
    print(f"đã giành review PR #{pr} (issue #{issue}), vòng {out['round']}, {len(diff_stat)} file")
    return out


REVIEW_HEADER = {
    "pass": "## Review: ĐẠT\n\nKết luận: không có vấn đề chặn merge. Chờ người merge.",
    "changes": "## Review: YÊU CẦU SỬA\n\nCác điểm gắn `(blocking)` phải xử lý xong mới mở lại review.",
}


def cmd_review_verdict(a):
    pr = a.pr
    issue = pr_issue(pr)
    led, cid, _ = ledger_read(issue)
    # Cửa THỨ HAI. `review-claim` chặn, nhưng verdict mới là chỗ SINH RA hệ quả
    # (gắn nhãn quyết định merge) — và tôi đã bị chặn ở cửa trước rồi đi thẳng qua
    # cửa sau, ghi được `agent:review-passed` như thường (#1397).
    assert_not_own_work(led, pr, "kết luận review", getattr(a, "allow_self", False), "--allow-self")


    # #2153 — đọc LẠI trạng thái PR ngay trước khi ghi. `review-claim` và `merge-batch`
    # không loại trừ nhau: một lô có thể merge PR này TRONG lúc review đang diễn ra,
    # và verdict `changes` rơi sau merge thì không chặn được gì — nó chỉ dán
    # `agent:changes-requested` lên một issue đã đóng, kẹt vĩnh viễn (#2110 kẹt đúng
    # kiểu này, muộn 93 giây), còn điểm blocking thật thì nằm nguyên trên dev.
    pr_live = gh_json(["pr", "view", str(pr), "-R", C.repo,
                       "--json", "state,mergedAt,headRefOid"], default=None)
    if pr_live is None:
        raise Fail(f"KHÔNG ĐO ĐƯỢC trạng thái PR #{pr} — không kết luận review khi không đo "
                   "được (#2151). Lease vẫn giữ; thử lại khi GitHub trả lời.")
    if pr_live.get("state") != "OPEN":
        ref_delete(f"pr-{pr}")
        local_unlock(f"pr-{pr}")
        if not pr_was_merged(pr_live):
            return_issue_to_code_queue_after_abandoned_pr(
                issue, led, cid,
                f"PR #{pr} đóng không merge — trả issue về hàng đợi code (#2289)",
            )
            raise Fail(
                f"PR #{pr} đã CLOSED (không merge) — verdict vô nghĩa.\n"
                f"  Issue #{issue} đã trả về hàng đợi (`{L_READY}`). Nhặt lại: `tal claim {issue}`.", 2)
        raise Fail(
            f"PR #{pr} đã {pr_live.get('state')}"
            + (f" lúc {pr_live.get('mergedAt')}" if pr_live.get("mergedAt") else "")
            + " — verdict ghi lúc này VÔ NGHĨA và chỉ làm kẹt máy trạng thái (#2153).\n"
              "  Điểm blocking còn đúng thì nó đang nằm TRÊN dev: mở issue MỚI cho nó,\n"
              "  đừng ghi verdict lên một PR đã khép.", 2)

    # #2300 D1 — verdict phải là của NGƯỜI GIỮ LEASE review (chỉ xét khi PR còn
    # MỞ — PR đã đóng đi các đường phục hồi #2153/#2289 ở trên, không cần lease).
    # Trước đây bất kỳ session nào cũng verdict được (và cuối hàm xoá ref VÔ ĐIỀU
    # KIỆN): B verdict chen ngang là A mất lease giữa lúc đọc diff, hai verdict
    # cùng đổ vào một PR, review_rounds +2 → dead-letter sớm.
    _vkey = f"pr-{pr}"
    _vref = next((r for r in refs_all_full() if r["key"] == _vkey), None)
    if _vref is None:
        raise Fail(f"không giữ lease review {_vkey} — `tal review-claim {pr}` trước khi verdict "
                   "(#2300). Verdict không lease là verdict chen ngang.", BUSY)
    _vpay = ref_payload(_vref["sha"]) if _vref.get("type") == "tag" else None
    if _vpay and _vpay.get("session") and _vpay["session"] != session_id():
        raise Fail(f"lease review {_vkey} thuộc session `{str(_vpay['session'])[:8]}…` — "
                   "không kết luận hộ người khác (#2300).", BUSY)

    # #2300 D2 — bản được verdict phải LÀ bản đã claim để đọc: coder push bản
    # mới giữa claim và verdict thì marker sẽ mang sha MỚI chưa ai đọc, và cổng
    # merge (#2261) coi đó là bằng chứng. Lệch ⇒ nhả lease, bắt claim lại.
    _pinned = (_vpay or {}).get("head_sha") or ""
    _live_sha = pr_live.get("headRefOid") or ""
    if _pinned and _live_sha and _pinned != _live_sha:
        ref_delete(_vkey)
        local_unlock(_vkey)
        raise Fail(
            f"PR #{pr} đã ĐỔI BẢN giữa claim và verdict "
            f"(claim đọc {_pinned[:12]}, head hiện {_live_sha[:12]}) — verdict này sẽ đóng dấu "
            "lên một bản chưa ai đọc. Lease đã nhả; `tal review-claim` lại và đọc diff mới.", 2)

    # #2300 D13 — thu hẹp cửa sổ read-modify-write: `led` đọc ở đầu hàm đã đi qua
    # nhiều network call (own-work, refs, sha) — gc/reap ghi xen giữa là counter
    # bị hoàn tác im lặng khi PATCH đè. Đọc lại NGAY trước khi tính/ghi.
    led, cid, _ = ledger_read(issue)

    verdict = "pass" if a.verdict == "pass" else "changes"
    detail = Path(a.body_file).read_text() if a.body_file else (a.body or "")
    if verdict == "changes" and not detail.strip():
        raise Fail("verdict changes bắt buộc có nội dung: nêu rõ từng điểm theo Conventional Comments", 2)

    # HAI bộ đếm, cố ý tách:
    #   reviews_total  — tăng ở MỌI verdict; đây là "bản thứ mấy đã được review", và là
    #                    con số đi vào marker. Trước đây marker dùng chung bộ đếm changes,
    #                    nên ba verdict cho ba BẢN khác nhau của #1317 đều ghi `round=1`
    #                    và không ai đọc ra được rằng bản sau đã pass.
    #   review_rounds  — chỉ đếm `changes`; đây là ngưỡng dead-letter, giữ nguyên ý nghĩa.
    reviews_total = led.get("reviews_total", led.get("review_rounds", 0)) + 1
    round_no = led.get("review_rounds", 0) + (1 if verdict == "changes" else 0)
    # sha là thứ DUY NHẤT phân biệt các bản của cùng một PR — lấy từ CÙNG lần đọc
    # với cổng trạng thái ở trên, không hỏi lại (giữa hai lần hỏi PR có thể đã đổi).
    reviewed_sha = pr_live.get("headRefOid") or ""
    body = (
        f"<!-- {REVIEW_MARKER} verdict={verdict} round={reviews_total} "
        f"changes={round_no} sha={reviewed_sha[:12]} reviewer={session_id()[:8]} -->\n"
        f"{REVIEW_HEADER[verdict]}\n\n{detail.strip()}\n\n"
        "---\n<sub>Bình luận theo [Conventional Comments](https://conventionalcomments.org/): "
        "`label (blocking|non-blocking): subject`. Chỉ `(blocking)` mới chặn merge.</sub>"
    )
    gh(["pr", "comment", str(pr), "-R", C.repo, "-b", body])

    led["reviews_total"] = reviews_total
    if reviewed_sha:
        led["reviewed_head_sha"] = reviewed_sha

    if verdict == "pass":
        led["state"] = "review_passed"
        # #2300 D7 — `review_rounds` là CHUỖI thất bại liên tiếp, không phải tổng
        # đời issue: pass là chuỗi đứt. Không reset thì issue kiểu `Refs #N` (pha
        # 1 ăn 2 changes rồi pass+merge) sang pha 2 chỉ còn 1 changes là dead-letter
        # — một issue lành bị khai tử vì sử cũ.
        led["review_rounds"] = 0
        ledger_write(led, cid, f"review ĐẠT PR #{pr} bởi {session_id()[:8]}… — chờ người merge "
                               "(chuỗi review_rounds reset)")
        for n in led.get("group", [issue]):
            set_state_labels(n, {L_PASSED})
        gh(["pr", "edit", str(pr), "-R", C.repo, "--add-label", L_PASSED], check=False)
        print(f"PR #{pr} ĐẠT → #{issue} gắn {L_PASSED}, chờ người merge (bot không merge)")
    else:
        led["review_rounds"] = round_no
        if round_no >= MAX_ATTEMPTS:
            led["state"] = "dead_letter"
            ledger_write(led, cid, f"review vòng {round_no} vẫn chưa đạt → dead-letter")
            for n in led.get("group", [issue]):
                set_state_labels(n, {L_DEAD, L_BLOCKED})
            gh(["pr", "comment", str(pr), "-R", C.repo, "-b",
                f"<!-- {REVIEW_MARKER}:dead-letter -->\n**Dừng vòng lặp tự động** — đã {round_no} vòng review "
                f"chưa đạt (MAX_ATTEMPTS={MAX_ATTEMPTS}). Chuyển cho người."], check=False)
            print(f"PR #{pr} sang dead-letter sau {round_no} vòng — cần người")
        else:
            led["state"] = "changes_requested"
            ledger_write(led, cid, f"review yêu cầu sửa PR #{pr}, vòng {round_no}")
            for n in led.get("group", [issue]):
                set_state_labels(n, {L_CHANGES})
            print(f"PR #{pr} CHƯA ĐẠT → #{issue} gắn {L_CHANGES} (ưu tiên cao nhất hàng đợi)")

    ref_delete(f"pr-{pr}")
    local_unlock(f"pr-{pr}")
    return {"pr": pr, "issue": issue, "verdict": verdict, "round": round_no}


def docs_rules() -> list[dict]:
    """Bản đồ code→doc. Là CHÍNH SÁCH của repo nên nằm ở config, không nằm trong tool."""
    return (repo_cfg().get("docsRules") or [])


class DocsFilesUnavailable(Fail):
    """Không đọc được ĐẦY ĐỦ danh sách file PR, nên cổng docs không được kết luận."""


def pr_files(pr: int) -> list[str]:
    """Danh sách file ĐẦY ĐỦ của PR, có phân trang và đối chiếu tổng.

    `gh pr diff --name-only` dùng endpoint diff chung và GitHub từ chối diff quá
    lớn. Endpoint files có phân trang; `changed_files` là phép đo độc lập để bắt
    cả ca API trả thiếu trang / chạm trần 3.000 file mà vẫn exit 0.
    """
    pull_ep = f"repos/{C.repo}/pulls/{pr}"
    meta = gh(["api", pull_ep, "--jq", ".changed_files"], check=False)
    if meta is None or getattr(meta, "returncode", 0) != 0:
        detail = "" if meta is None else ((getattr(meta, "stderr", "") or "").strip()
                                           or (getattr(meta, "stdout", "") or "").strip())
        raise DocsFilesUnavailable(
            f"KHÔNG đọc được tổng số file của PR #{pr}: {detail or 'gh không chạy'}", 2
        )
    try:
        expected = int((meta.stdout or "").strip())
    except (TypeError, ValueError):
        raise DocsFilesUnavailable(
            f"KHÔNG đọc được tổng số file của PR #{pr}: changed_files không hợp lệ", 2
        )

    page = gh(["api", "--paginate", f"{pull_ep}/files?per_page=100",
               "--jq", ".[].filename"], check=False)
    if page is None or getattr(page, "returncode", 0) != 0:
        detail = "" if page is None else ((getattr(page, "stderr", "") or "").strip()
                                           or (getattr(page, "stdout", "") or "").strip())
        raise DocsFilesUnavailable(
            f"KHÔNG đọc được danh sách file của PR #{pr}: {detail or 'gh không chạy'}", 2
        )
    files = [line for line in (page.stdout or "").splitlines() if line]
    if len(files) != expected:
        raise DocsFilesUnavailable(
            f"KHÔNG đọc đủ danh sách file của PR #{pr}: GitHub báo {expected}, "
            f"nhận {len(files)}. Cổng docs không được bỏ qua.", 2
        )
    return files


def docs_gate(pr: int, files: list[str] | None = None) -> list[dict]:
    """#1639 — CHỈ những luật `docsRules` bị kích hoạt mà không có file doc nào đi kèm.

    Tách khỏi {@see cmd_docs_check} để `tal pr` và vai review dùng CHUNG một phép
    đo: hai bản riêng sẽ trôi lệch, và lúc đó câu "docs-check đã xanh" không còn
    nghĩa gì vì nó xanh ở phép đo nào không ai biết.

    KHÔNG trả hai kiểm chung. Chúng là gợi ý cho người đọc, không phải cổng — xem
    lý do ở chỗ gọi trong `cmd_pr`.
    """
    if files is None:
        files = pr_files(pr)
    if not files:
        return []

    gaps = []
    for r in docs_rules():
        pat, expect = r.get("when"), r.get("expect") or []
        if not pat or not expect:
            continue
        hit = [f for f in files if re.search(pat, f)]
        if not hit:
            continue
        if any(e in files for e in expect):
            continue
        gaps.append({"expect": expect, "why": r.get("why", ""), "triggered_by": hit[:4]})

    return gaps


def cmd_docs_check(a):
    """PR này có cập nhật tài liệu mà nó đáng lẽ phải cập nhật chưa.

    Là GỢI Ý cho người review, không phải rào chặn: có thay đổi thật sự không cần doc
    (refactor nội bộ, đổi tên biến). Nhưng thiếu doc cho một thay đổi QUY ƯỚC hay HÀNH VI
    thì reviewer phải chặn — vì cái mất không phải là văn bản, mà là người sau không còn
    đường nào biết quy ước đã đổi."""
    files = pr_files(a.pr)
    md = [f for f in files if f.endswith(".md")]
    code = [f for f in files if not f.endswith((".md", ".json", ".lock"))]

    # #1639 — phần LUẬT đi qua `docs_gate`, đúng hàm mà cổng của `tal pr` dùng.
    # Trước đây hai chỗ tự đếm riêng; hai bản đếm sẽ trôi lệch, và lúc đó câu
    # "docs-check đã xanh" mất nghĩa vì không ai biết nó xanh ở phép đo nào.
    gap_keys = {tuple(g["expect"]) for g in docs_gate(a.pr, files)}

    findings = []
    for r in docs_rules():
        pat, expect = r.get("when"), r.get("expect") or []
        if not pat:
            continue
        hit = [f for f in files if re.search(pat, f)]
        if not hit:
            continue
        done = [e for e in expect if e in files]
        findings.append({
            "rule": pat, "why": r.get("why", ""), "triggered_by": hit[:4],
            "expect": expect, "updated": done, "gap": tuple(expect) in gap_keys,
        })

    # Hai kiểm chung, không cần bản đồ
    generic = []
    if code and not md:
        generic.append(f"PR đổi {len(code)} file code và KHÔNG chạm file .md nào")
    api_touch = [f for f in files if re.search(r"backend/routes/|Controllers/", f)]
    if api_touch and not any(f.startswith("backend/storage/api-docs/") for f in files):
        generic.append("chạm route/controller nhưng không regen swagger "
                       "(backend/storage/api-docs/*.json)")

    if a.json:
        return emit({"pr": a.pr, "rules": findings, "generic": generic,
                     "md_changed": md, "has_rules": bool(docs_rules())}, True)

    if not docs_rules():
        print("chưa khai `docsRules` trong config — chỉ chạy được kiểm chung")
    gaps = [f for f in findings if f["gap"]]
    for f in findings:
        mark = "✘ THIẾU" if f["gap"] else "✔"
        print(f"  {mark} {' , '.join(f['expect'])}")
        print(f"      vì: {f['why']}")
        print(f"      kích hoạt bởi: {', '.join(f['triggered_by'])}")
    for g in generic:
        print(f"  ! {g}")
    if not findings and not generic:
        print("không thấy khoảng trống tài liệu nào")
    print(f"\nfile .md trong PR: {', '.join(md) if md else '(không có)'}")
    return {"gaps": len(gaps), "generic": generic}


# ─────────────────────────────────────────────────────────────────────────────
# Merge — CHỈ khi review đã đạt VÀ CI xanh. Hai điều kiện, cưỡng chế bằng máy.
# ─────────────────────────────────────────────────────────────────────────────


# Từ vựng bucket của `gh pr checks` — ĐO trên PR thật, không đoán (#2669).
#
#   pass · fail · cancel · skipping   ⇒ CI ĐÃ NÓI (kết luận cuối cùng)
#   pending                           ⇒ CI CHƯA NÓI (QUEUED / IN_PROGRESS / …)
#
# Đo 2026-08-13 JST, `gh 2.96.0`, TRÊN CHÍNH REPO NÀY
# (`gh pr checks <pr> -R godx-jp/godx-tempo --json name,bucket,state,startedAt`):
#   PR #2662 (đã xong)  → pass/SUCCESS ×9, skipping/SKIPPED ×2
#   PR #2670 lúc 18:24:44Z, ngay sau khi push
#                       → pending/IN_PROGRESS ×3 (`build · vet · gofmt · test`,
#                         `arch-gate`, `pos-web api manifest …`),
#                         skipping/SKIPPED ×3 (`pest`, `timezone-matrix`, `flake-hunt`)
#   cùng PR #2670 lúc 18:28:54Z → pass ×3 + skipping ×3, không còn pending
# Bucket `fail`/`cancel` là ca của #2639 (đo ở đó).
# `wait_checks()` ở trên xác nhận độc lập cùng từ vựng ở tầng `state`:
# IN_PROGRESS/QUEUED/PENDING/WAITING/REQUESTED là chưa xong, SKIPPED/NEUTRAL là xong.
#
# Danh sách này khai "ĐÃ XONG", không khai "CHƯA XONG", và chiều đó là cố ý: một
# bucket lạ (gh đổi từ vựng, GitHub thêm trạng thái) rơi về phía CHƯA XONG. Chặn
# nhầm thì người vận hành thấy ngay và gõ lại một lệnh; cho qua nhầm thì không ai
# thấy gì cho tới lúc `dev` đỏ — mà đó chính là ca #2639/#2669 đang tính tiền.
#
# `skipping` NẰM TRONG danh sách đã xong: một job có `paths`/`if` không khớp sẽ ở
# SKIPPED VĨNH VIỄN (repo này skip `pest`/`timezone-matrix`/`flake-hunt` trên gần
# như mọi PR). Coi nó là chưa xong là chặn gần như MỌI PR, và một cái rào chặn tất
# cả thì bị gỡ trong ngày.
CI_DONE_BUCKETS = {"pass", "fail", "cancel", "skipping"}


def pr_check_rows(pr: int) -> list[dict]:
    """Bảng check thô của PR: `[{name, bucket, startedAt}, …]`. Một chỗ gọi `gh` duy nhất."""
    return gh_json(["pr", "checks", str(pr), "-R", C.repo, "--json",
                    "name,bucket,startedAt"], default=None) or []


def pr_checks(pr: int) -> tuple[str, list[str]]:
    """→ (trạng thái tổng, chi tiết). Trạng thái: pass | pending | fail | none.

    `skipping` không tính là chặn (job có điều kiện không chạy là bình thường), nhưng
    `pending` thì CHẶN: merge khi CI chưa xong là đúng cái đã làm dev đỏ (#1147 ghi
    lại một PR self-merge sau 9 phút với test của chính nó đang đỏ)."""
    rows = pr_check_rows(pr)
    if not rows:
        return "none", []
    detail = [f"{r.get('name')}={r.get('bucket')}" for r in rows]
    buckets = {r.get("bucket") for r in rows}
    if buckets & {"fail", "cancel"}:
        return "fail", detail
    if buckets - CI_DONE_BUCKETS:      # #2669 — kể cả bucket LẠ: chưa nói ≠ đã xanh
        return "pending", detail
    if "pass" in buckets:
        return "pass", detail
    return "none", detail


# ─────────────────────────────────────────────────────────────────────────────
# #2639 — CI ĐỎ là rào CỨNG trong `tal`, và nó KHÔNG phải branch protection
# ─────────────────────────────────────────────────────────────────────────────
#
# Repo này KHÔNG bật được required status checks: private trên gói hiện tại ⇒
# `gh api repos/godx-jp/godx-tempo/branches/dev/protection` trả
# `403: Upgrade to GitHub Pro or make this repository public`. Nên GitHub không
# chặn gì cả, và `gh pr merge` / nút merge trên web vẫn đi thẳng qua. Rào ở đây
# chỉ phủ ĐƯỜNG `tal` — đường phổ biến nhất, không phải mọi đường.

CI_RED = "CI ĐỎ: "   # tiền tố blocker do `merge_blockers` ghi ra
# Một hằng số chứ không phải chuỗi lặp: `cmd_merge` dò đúng tiền tố này để tách
# blocker CI ra khỏi các blocker khác và biến nó thành rào `--force` không mở
# được. Sửa lời văn ở một chỗ mà quên chỗ kia ⇒ rào im lặng ngừng chặn.

# #2669 — cùng một câu hỏi, sắc thái thứ hai: "CI đã nói chưa?".
# #2639 chỉ bắt ca CI nói ĐỎ. Ca CI CHƯA NÓI đo được hai lần trong một phiên, cả
# hai đều merge lúc check còn chạy: PR #2653 (16:31:58Z — `arch-gate` và
# `build · vet · gofmt · test` còn pending) và PR #2663 (17:55:03Z — `arch-gate`
# còn pending; nó xanh lúc 17:55:42Z, tức 39 giây SAU khi merge). Không cái nào
# đỏ, nên rào #2639 im lặng đúng thiết kế — nhưng "chưa biết" không phải "đã xanh",
# và hậu quả thì y hệt: CI chạy trên commit TRỘN, một PR đỏ vào base làm mọi PR
# sau đó đỏ theo.
CI_PENDING = "CI CHƯA XONG: "   # tiền tố blocker do `merge_blockers` ghi ra
# Cùng khuôn với `CI_RED`: `cmd_merge` dò đúng tiền tố này để biến blocker thành
# rào `--force` không mở được. Hai tiền tố tách rời nhau, không cái nào là tiền tố
# của cái kia — đổi lời văn một chỗ mà quên chỗ kia ⇒ rào im lặng ngừng chặn.

BASE_RED_MARK = "tal:base-red"


def red_check_names(detail: list[str]) -> list[str]:
    """Tên các check ĐỎ, lọc từ danh sách `name=bucket` mà `pr_checks()` trả về.

    Thông điệp từ chối phải gọi TÊN check đã đỏ. Bản trước in cả bảng (mọi check,
    kể cả xanh) nên người đọc phải tự dò `=fail` giữa mười dòng — đúng cái đã làm
    tác giả #2636 mất ba lượt mới biết mình không có lỗi."""
    out = []
    for d in detail:
        name, sep, bucket = d.rpartition("=")
        if sep and bucket in ("fail", "cancel"):
            out.append(name)
    return out


def ci_red_verdict(why: list[str], acknowledged: bool) -> list[str]:
    """→ phần mô tả của các blocker CI ĐỎ; danh sách RỖNG = cho qua. Thuần tuý, test được.

    `acknowledged` (`--ci-red`) là lời khẳng định về Ý ĐỊNH — "tôi đã xem, đỏ này
    không đến từ PR này" — chứ không phải `--force`. Tách hai cờ là cả điểm của
    rào: `--force` là thứ mọi session gõ hằng ngày để bỏ cổng review, nên nếu nó
    mở luôn cửa CI thì rào chết ngay ngày đầu (đúng bài học #2573).

    KHÔNG tách payload theo `" · "` để lấy tên check: repo này CÓ check tên
    `build · vet · gofmt · test` và `version · drift · guard tests`, nên tách ra
    là bịa ra bốn cái tên không tồn tại rồi đi hỏi GitHub về chúng. Tên check
    thật lấy từ `pr_checks()` + `red_check_names()`, không suy từ chuỗi."""
    if acknowledged:
        return []
    return [w[len(CI_RED):] for w in why if w.startswith(CI_RED)]


def pending_check_names(detail: list[str]) -> list[str]:
    """Tên các check CHƯA XONG, lọc từ danh sách `name=bucket` của `pr_checks()`.

    Cùng lý do với `red_check_names`: thông điệp từ chối phải gọi TÊN check còn
    chạy, không đổ cả bảng mười một dòng để người đọc tự dò.

    Cắt bằng `rpartition` chứ không `split("=")`, và KHÔNG tách theo `" · "`: repo
    này có check tên thật là `build · vet · gofmt · test` và
    `version · drift · guard tests`.

    Trùng tên thì gộp (một check chạy lại để lại nhiều dòng cùng tên) — `arch-gate
    · arch-gate` không nói thêm được gì."""
    out = []
    for d in detail:
        name, sep, bucket = d.rpartition("=")
        if sep and bucket not in CI_DONE_BUCKETS and name not in out:
            out.append(name)
    return out


def ci_pending_verdict(why: list[str], acknowledged: bool) -> list[str]:
    """→ phần mô tả của các blocker CI CHƯA XONG; rỗng = cho qua. Thuần tuý, test được.

    Song sinh với `ci_red_verdict`, và cố ý dùng CHUNG cờ `--ci-red`: hai cờ cho hai
    sắc thái của đúng một lời khẳng định ("CI chưa nói gì có lợi cho tôi, tôi vẫn
    merge, và đây là vì sao") là thừa — cờ thứ hai chỉ tạo thêm một thứ để quên đăng
    ký ở đường `merge-batch`. `--force` vẫn KHÔNG mở, y như #2639."""
    if acknowledged:
        return []
    return [w[len(CI_PENDING):] for w in why if w.startswith(CI_PENDING)]


def check_age_label(started: str | None, now: float | None = None) -> str:
    """`"45s"` / `"8m"` / `""` — check đã chạy bao lâu, tính từ `startedAt` (ISO-8601 Z).

    Con số này là nội dung chính của thông điệp từ chối: "arch-gate chưa xong"
    không nói được nên chờ hay nên đi xem có gì kẹt; "arch-gate — đang chạy 41m"
    thì có (arch-gate của repo này xong trong ~1 phút).

    Không đo được ⇒ chuỗi rỗng và người gọi bỏ qua phần tuổi: một dấu thời gian
    lạ không được phép làm chết lệnh merge."""
    if not started:
        return ""
    try:
        t = datetime.strptime(started, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=timezone.utc).timestamp()
    except (ValueError, TypeError):
        return ""
    secs = int((time.time() if now is None else now) - t)
    if secs < 0:
        return ""
    return f"{secs}s" if secs < 90 else f"{secs // 60}m"


def pending_check_report(pr: int) -> list[str]:
    """`["arch-gate — đang chạy 8m", …]` — hỏi lại GitHub, CHỈ trên đường TỪ CHỐI.

    Một call thêm, cùng khuôn với `base_red_hint` ở #2639: tuổi của check không
    đi qua chuỗi blocker được (payload phải là tên thuần để `ci_pending_verdict`
    cắt lại), và đường ĐI QUA không được trả tiền cho một chẩn đoán không ai đọc."""
    out = []
    for r in pr_check_rows(pr):
        if (r.get("bucket") or "") in CI_DONE_BUCKETS:
            continue
        age = check_age_label(r.get("startedAt"))
        out.append(f"{r.get('name')}" + (f" — đang chạy {age}" if age else ""))
    return out


def _check_state_on(sha: str, check: str) -> str:
    """`fail` | `ok` | `?` — kết luận của check tên `check` trên commit `sha`.

    Một check chạy lại nhiều lần để lại NHIỀU run cùng tên; chỉ cần một run
    `success` là coi như đã xanh (re-run sửa được kết quả cũ). `?` nghĩa là không
    đo được / check chưa từng chạy trên commit đó — người gọi phải DỪNG ở đó chứ
    không được coi là xanh."""
    d = gh_json(["api", f"repos/{C.repo}/commits/{sha}/check-runs?per_page=100"], default=None)
    if not d:
        return "?"
    runs = [r for r in (d.get("check_runs") or []) if r.get("name") == check]
    if not runs:
        return "?"
    concl = {(r.get("conclusion") or "").lower() for r in runs}
    if "success" in concl:
        return "ok"
    if concl & {"failure", "timed_out", "cancelled", "startup_failure", "action_required"}:
        return "fail"
    return "?"


def base_red_blame(check: str, max_depth: int = 12) -> dict | None:
    """Check `check` có đang ĐỎ trên CHÍNH `BASE_BRANCH` không, và commit nào làm nó đỏ.

    → `{"sha", "pr", "author"}`, hoặc `None` khi base xanh / không đo được.

    Vì sao cần: CI chạy trên commit TRỘN (base + nhánh), nên một lần merge đỏ vào
    base làm **mọi PR mở sau đó đỏ theo**, kể cả PR không chạm dòng nào liên quan.
    Người phá không phải người trả giá — #2636 (không một dòng PHP) đỏ vì #2630, và
    tác giả nó truy ngược ba lượt. Base xanh ⇒ trả `None`: PR tự đỏ, không đổ cho ai.

    Đi lùi tối đa `max_depth` commit rồi dừng — rào này để CHỈ TAY, không phải để
    khảo cổ; đi sâu hơn thì trả giá bằng hạn mức API (#2151)."""
    commits = gh_json(["api", f"repos/{C.repo}/commits?sha={BASE_BRANCH}&per_page={max_depth}"],
                      default=None) or []
    if not commits:
        return None
    culprit = None
    for c in commits:
        sha = c.get("sha") or ""
        if not sha:
            break
        if _check_state_on(sha, check) == "fail":
            culprit = sha
            continue
        break        # xanh hoặc không đo được ⇒ dừng; cái đỏ CŨ NHẤT vừa thấy là thủ phạm
    if not culprit:
        return None
    pulls = gh_json(["api", f"repos/{C.repo}/commits/{culprit}/pulls"], default=None) or []
    pick = next((p for p in pulls if (p.get("merge_commit_sha") or "") == culprit),
                pulls[0] if pulls else None)
    return {"sha": culprit,
            "pr": (pick or {}).get("number"),
            "author": ((pick or {}).get("user") or {}).get("login")}


def notify_base_red(blame: dict, check: str) -> None:
    """Nói cho người PHÁ biết — một comment lên PR đã làm base đỏ.

    Đây là thông báo DUY NHẤT mà repo này với tới được mà không cần hạ tầng hay
    secret mới: `gh` đã xác thực sẵn, và GitHub tự gửi notification cho tác giả
    PR khi có comment. Không Slack, không email, không webhook — những thứ đó cần
    secret repo này không có.

    Idempotent theo (PR, sha): marker HTML trong thân comment. Hai session cùng
    lúc có thể ghi trùng một lần — chấp nhận được; im lặng thì không."""
    pr = blame.get("pr")
    sha = (blame.get("sha") or "")[:12]
    if not pr or not sha:
        return
    mark = f"<!-- {BASE_RED_MARK} sha={sha} check={check} -->"
    # `direction=desc`: endpoint này mặc định trả comment CŨ NHẤT trước, nên trên một
    # PR nhiều hơn 100 comment thì marker vừa ghi nằm ở trang sau và ta sẽ ghi lại.
    seen = gh_json(["api", f"repos/{C.repo}/issues/{pr}/comments"
                           "?per_page=100&sort=created&direction=desc"], default=None)
    if seen is None:
        return                                   # không đọc được ⇒ đừng ghi trùng
    if any(mark in (c.get("body") or "") for c in seen):
        return
    gh(["pr", "comment", str(pr), "-R", C.repo, "-b",
        f"{mark}\n**`{BASE_BRANCH}` ĐANG ĐỎ — check `{check}`**, từ `{sha}` (merge của PR này).\n\n"
        f"CI chạy trên commit TRỘN (`{BASE_BRANCH}` + nhánh), nên **mọi PR mở vào "
        f"`{BASE_BRANCH}` đỏ theo** cho tới khi `{check}` xanh lại — kể cả PR không chạm gì "
        f"liên quan. Tin này gửi tự động vì người phá vốn không nhận được tín hiệu nào "
        f"(#2639).\n\n"
        f"Sửa hoặc revert `{sha}`. Từ giờ `tal merge` TỪ CHỐI mọi PR có check đỏ và "
        f"`--force` không mở được rào đó."], check=False)


_BASE_RED_SEEN: dict[str, str] = {}


def base_red_hint(names: list[str]) -> str:
    """Dòng chỉ tay ghép vào thông điệp từ chối — và gửi thông báo cho người phá.

    Best-effort tuyệt đối: mọi lỗi ở đây nuốt thành chuỗi rỗng. Một rào chẩn đoán
    làm chết lệnh merge là rào sẽ bị gỡ nguyên cái.

    Nhớ theo TIẾN TRÌNH: `merge-batch` gọi `cmd_merge` nhiều lần, và khi base đỏ
    thì mọi PR trong lô cùng đỏ vì đúng một lý do — hỏi lại GitHub cho từng PR là
    đốt hạn mức để in lại cùng một câu (#2151)."""
    key = " ".join(names)
    if key in _BASE_RED_SEEN:
        return _BASE_RED_SEEN[key]
    hint = ""
    try:
        for name in names:
            blame = base_red_blame(name)
            if not blame:
                continue
            notify_base_red(blame, name)
            who = f" (@{blame['author']})" if blame.get("author") else ""
            where = f", PR #{blame['pr']}{who}" if blame.get("pr") else ""
            hint = (f"\n  `{name}` cũng ĐỎ trên chính `{BASE_BRANCH}` từ `{blame['sha'][:12]}`"
                    f"{where} — PR này nhiều khả năng KHÔNG phải thủ phạm. Đã comment báo lên đó.")
            break
    except Exception as e:                                          # noqa: BLE001
        warn(f"không chẩn đoán được `{BASE_BRANCH}` đỏ ({type(e).__name__}: {e}) — "
             "rào CI vẫn chặn như thường")
        return ""            # lỗi tạm thời thì đừng nhớ — lần merge sau đo lại
    _BASE_RED_SEEN[key] = hint
    return hint


_VERDICT_MARK_RE = re.compile(
    rf"<!--\s*{re.escape(REVIEW_MARKER)}\s+verdict=(pass|changes)\b[^>]*\bsha=([0-9a-f]+)",
    re.I,
)


def _verdict_markers(pr: int) -> list[tuple[str, str, str]]:
    """Mọi marker verdict trên PR, MỚI NHẤT trước: [(verdict, sha_prefix, comment_id)]."""
    d = gh_json(["pr", "view", str(pr), "-R", C.repo, "--json", "comments"], default={}) or {}
    out = []
    for c in reversed(d.get("comments") or []):
        m = _VERDICT_MARK_RE.search(c.get("body") or "")
        if m:
            cid = str(c.get("id") or c.get("databaseId") or "")
            out.append((m.group(1).lower(), m.group(2).lower(), cid))
    return out


def realign_only_delta(old: str, new: str, branch: str | None = None) -> bool:
    """#2299 — mọi commit giữa `old` (sha đã review) và `new` (head hiện tại) có
    PHẢI toàn commit căn-pointer do tal tạo không: subject đúng khuôn realign VÀ
    diff chỉ chạm gitlink submodule. Đúng cả hai ⇒ nội dung được review không
    đổi, verdict cũ còn hiệu lực."""
    root = str(C.main_worktree)
    if branch:
        run(["git", "fetch", "-q", "origin", branch], cwd=root, check=False)
    if getattr(run(["git", "cat-file", "-e", f"{old}^{{commit}}"], cwd=root, check=False),
               "returncode", 1) != 0:
        return False
    subj = run(["git", "log", "--format=%s", f"{old}..{new}"], cwd=root, check=False)
    if getattr(subj, "returncode", 1) != 0:
        return False
    lines = [ln for ln in (subj.stdout or "").splitlines() if ln.strip()]
    if not lines:
        return False        # không có commit mới — đáng lẽ đã match trực tiếp
    if not all(ln.startswith("chore(submodule): căn pointer") for ln in lines):
        return False
    diffp = run(["git", "diff", "--name-only", old, new], cwd=root, check=False)
    if getattr(diffp, "returncode", 1) != 0:
        return False
    paths = {ln.strip() for ln in (diffp.stdout or "").splitlines() if ln.strip()}
    sub_paths = {x["path"] for x in submodules().values()}
    return bool(paths) and paths <= sub_paths


def pr_verdict_pass_evidence(pr: int, head_sha: str | None = None,
                             head_branch: str | None = None) -> tuple[str | None, str | None]:
    """→ (marker_sha_prefix, comment_id) nếu bằng chứng verdict=pass còn HIỆU LỰC.

    #2299/F5 — hai luật mới:
    - VERDICT MỚI NHẤT trên một sha mới là câu trả lời: `pass` rồi `changes` trên
      CÙNG sha ⇒ không còn bằng chứng (trước đây chỉ tìm pass nên changes mới hơn
      bị lờ).
    - Head là commit CĂN-POINTER do tal tạo (merge chết giữa chừng sau realign)
      thì verdict của sha ngay trước chuỗi realign còn hiệu lực — không bắt người
      review lại một commit máy tạo, không cần `--force`."""
    if not head_sha:
        head_sha = (gh_json(["pr", "view", str(pr), "-R", C.repo, "--json", "headRefOid"],
                              default={}) or {}).get("headRefOid") or ""
    if not head_sha:
        return None, None
    prefix = head_sha[:12].lower()
    marks = _verdict_markers(pr)
    for verdict, sha, cid in marks:            # mới nhất trước
        if sha == prefix:
            if verdict == "pass":
                return prefix, cid or None
            return None, None                  # F5: verdict mới nhất trên sha này là changes
    # #2299 — không marker nào cho head: thử chuỗi realign-only từ sha pass gần nhất
    for verdict, sha, cid in marks:
        if verdict != "pass":
            continue
        newest_for_sha = next((v for v, s2, _ in marks if s2 == sha), None)
        if newest_for_sha != "pass":
            continue
        if realign_only_delta(sha, head_sha, head_branch):
            warn(f"PR #{pr}: head {prefix} chỉ là commit căn-pointer sau sha đã review "
                 f"{sha} — verdict còn hiệu lực (#2299)")
            return sha, cid or None
        break
    return None, None

def merge_blockers(pr: int, require_ci: bool = True) -> tuple[int | None, list[str], tuple[str | None, str | None]]:
    """→ (issue, danh sách lý do KHÔNG merge được, (verdict_sha, comment_id)). why rỗng = đủ điều kiện.

    Phần tử thứ ba là bằng chứng verdict lấy NGAY TẠI CỔNG — người gọi phải dùng
    lại nó khi ghi sổ (#2261 vòng 2): sau cổng, `realign_pointers` có thể push
    commit căn pointer lên chính nhánh PR làm HEAD đổi, và một lần tra thứ hai
    sẽ không thấy verdict (sha reviewer đã đọc ≠ head mới) → sổ ghi
    "verdict=KHÔNG_CÓ" cho một merge hợp lệ.

    `require_ci=False` dùng cho đường GOM LÔ: khi đó "CI xanh" được chứng minh MỘT lần
    cho cả lô bằng `tal merge-batch` (một lần full suite trên kết quả đã trộn), thay vì
    một lần cho từng PR. Full suite mỗi PR vừa chậm vừa tốn, và cái cần biết trước khi
    đẩy vào base là "cả lô cùng nhau có xanh không" — không phải "từng PR riêng lẻ có
    xanh không", vì chúng sẽ nằm cạnh nhau trên base chứ không nằm một mình.

    `require_ci` KHÔNG tha hai ca: CI ĐỎ (#2639) và CI CHƯA XONG (#2669). Cả hai chặn
    ở mọi đường, kể cả gom lô — cờ này trả lời "có bắt phải CÓ CI xanh không", không
    phải "có được lờ đi cái CI đang chạy dở không"."""
    why: list[str] = []
    d = gh_json(["pr", "view", str(pr), "-R", C.repo, "--json",
                 "isDraft,mergeable,state,headRefName,headRefOid,labels"], default=None)
    if d is None:
        return None, [f"không đọc được PR #{pr}"], (None, None)
    if d.get("state") != "OPEN":
        why.append(f"PR không mở (state={d.get('state')})")
    if d.get("isDraft"):
        why.append("PR đang là draft")
    # `mergeable` của GitHub tính BẤT ĐỒNG BỘ, nên nó sai theo CẢ HAI chiều và không
    # dùng làm rào được:
    #   - còn `UNKNOWN` lúc hỏi ⇒ một PR conflict thật vẫn lọt vào lô (đường #1318 lọt);
    #   - giữ `CONFLICTING` cũ ⇒ chặn oan một PR đã sạch (đo được trên #1330: cờ báo
    #     CONFLICTING/DIRTY trong khi `git merge --no-commit` vào origin/dev trộn sạch,
    #     thử hai lần cách nhau vài phút).
    # Câu trả lời chắc chắn duy nhất là TRỘN THỬ, và `merge-batch` đã trộn thật rồi: PR
    # nào conflict thì bị bỏ khỏi lô ngay tại đó, kèm output git. Nên ở đây chỉ CẢNH BÁO.
    if d.get("mergeable") == "CONFLICTING":
        warn(f"PR #{pr}: GitHub đang báo mergeable=CONFLICTING (cờ này bất đồng bộ). "
             "Không chặn — lần trộn thật trong `merge-batch` mới là căn cứ.")

    try:
        issue = pr_issue(pr)
    except Fail as e:
        return None, why + [str(e)], (None, None)

    # Nhãn trên ISSUE là căn cứ duy nhất — nó là máy trạng thái, có ledger đi kèm.
    # Nhãn trên PR chỉ để người nhìn cho nhanh, và nó SỐNG SÓT qua một lần push mới:
    # một PR từng được pass, rồi bị sửa tiếp, vẫn còn nhãn pass trên PR. Hợp hai nguồn
    # lại là tự mở cửa cho một bản chưa ai review đi qua rào này.
    names = set(issue_data(issue)["labels"])
    if L_PASSED and L_PASSED not in names:
        why.append(f"chưa có nhãn {L_PASSED} — review PHẢI đạt trước")
    # #2261 — nhãn có thể sống sót qua push mới; verdict trên GitHub + sha khớp HEAD
    # là bằng chứng bắt buộc trước merge (cùng marker `review-verdict` ghi ra).
    if L_CHANGES in names:
        why.append(f"đang mang {L_CHANGES} — vòng review yêu cầu sửa chưa xong")
    if L_DEAD in names:
        why.append(f"đang ở {L_DEAD} — cần người")
    # #2299 — cổng verdict (2 call gh) chạy SAU các phép kiểm rẻ: PR đã bị chặn
    # vì nhãn thì đừng đốt thêm API cho một bằng chứng không ai dùng.
    # #2874 — PR đang có review lease SỐNG thì CHƯA merge được, và phép kiểm phải
    # nằm Ở ĐÂY chứ không riêng trong `merge-batch`.
    #
    # Rào #2153 có thật, nhưng nó ở đường ÍT BỊ DÙNG NHẤT trong đúng tình huống
    # sinh ra lỗi. Ngày 2026-08-14/15 ba session độc lập cùng merge đè lên một
    # review đang chạy — #2833, #2867, #2862 — và cả ba đi đường `gh pr merge`,
    # không qua tal. Verdict rơi sau khi PR đã khép nên không ghi lên được; với
    # #2862 verdict là CHANGES và ba điểm blocking nằm nguyên trên `dev` mấy
    # tiếng, trong đó một đường tiền PayPay nuốt quy kết im lặng (tiền thu đúng,
    # không lỗi, không log).
    #
    # Ba session trong một ngày không phải ba lần cẩu thả — đó là thiếu rào. Và
    # lý do có tính hệ thống: mọi session đẩy PR bằng CÙNG một tài khoản GitHub
    # nên không ai duyệt được PR của chính tài khoản mình, ai thẩm tra xong cũng
    # rơi về `gh pr merge` — đúng đường duy nhất không có rào.
    #
    # `merge_blockers` là điểm hội tụ của CẢ BỐN đường trong tal (`merge-queue`,
    # `cmd_merge`, đường 4179, `merge-batch`), nên đặt ở đây khoá được cả bốn
    # bằng một chỗ. Khối trùng trong `merge-batch` đã gỡ: hai nguồn cho một luật
    # là cách chúng trôi khỏi nhau.
    #
    # Đặt SAU các phép kiểm nhãn (rẻ, không tốn API) và TRƯỚC cổng verdict (2
    # call gh) — cùng lý lẽ tiết kiệm mà #2299 đã đặt ra cho cổng verdict.
    #
    # Lease quá TTL thì KHÔNG chặn: session review đã chết, `tal gc` sẽ dọn ref,
    # và một lease mồ côi giữ con tin mọi lượt merge là rào tệ hơn không rào.
    if not why and f"pr-{pr}" in {k for k in refs_all() if k.startswith("pr-")}:
        led_r, _, upd_r = ledger_read(issue)
        if not lease_expired(led_r, upd_r):
            why.append(f"đang được review (lease pr-{pr} còn sống) — chờ verdict (#2153/#2874)")
        else:
            warn(f"PR #{pr}: lease review đã quá TTL — không chặn; `tal gc` sẽ dọn ref")

    head_sha = d.get("headRefOid") or ""
    vsha, vcid = (None, None)
    if not why:
        vsha, vcid = pr_verdict_pass_evidence(pr, head_sha, head_branch=d.get("headRefName"))
        if not vsha:
            why.append(
                f"không có comment `{REVIEW_MARKER} verdict=pass` trên GitHub khớp head "
                f"{head_sha[:12] if head_sha else '?'} — merge tin nhãn/ledger là không đủ"
            )

    state, detail = pr_checks(pr)
    if state == "fail":              # CI đỏ thì chặn kể cả ở đường gom lô
        # #2639 — chỉ TÊN check đỏ, không cả bảng. `cmd_merge` cắt lại theo tiền tố
        # `CI_RED` để biến blocker này thành rào cứng, nên phần sau tiền tố phải là
        # danh sách tên thuần, không lẫn check xanh.
        why.append(CI_RED + " · ".join(red_check_names(detail) or detail))
    elif state == "pending":
        # #2669 — CHƯA XONG cũng chặn ở CẢ đường gom lô, đúng như CI đỏ của #2639.
        # Trước đây nhánh này nằm dưới `require_ci`, mà `require_ci` mặc định TẮT
        # (#1454) và đường batch cũng truyền False — nên trên thực tế nó không bao
        # giờ chạy, và #2653/#2663 merge với check còn chạy.
        #
        # `require_ci` (#1454) trả lời câu "có bắt PR phải CÓ CI xanh không" —
        # không, vì CI ở repo này là pest full và đòi nó là bắt người chờ qua một
        # đường vòng. Câu ở đây khác hẳn: CI ĐANG CHẠY, tức nó SẼ nói, chỉ là chưa.
        # Merge lúc đó không tiết kiệm gì cả — nó chỉ dời câu trả lời sang commit
        # trộn trên base, nơi người trả lời là tác giả của các PR sau.
        why.append(CI_PENDING + " · ".join(pending_check_names(detail) or detail))
    elif require_ci and state == "none":
        why.append("không thấy CI nào — không có đối chứng để merge")
    return issue, why, (vsha, vcid)


def cmd_merge_queue(a):
    # #2151 — hàng đợi MERGE: "không có PR nào đủ điều kiện" phải là kết luận, không
    # phải hệ quả của một lần gọi hỏng.
    prs = gh_json_required(["pr", "list", "-R", C.repo, "--state", "open", "--limit", "50",
                            "--json", "number,title,headRefName,isDraft"])
    out = []
    for p in prs:
        if p["isDraft"] or not re.match(r"^issue-\d+$", p["headRefName"]):
            continue
        issue, why, _ev = merge_blockers(p["number"], require_ci=not a.batch)
        out.append({"pr": p["number"], "issue": issue, "title": p["title"],
                    "eligible": not why, "blockers": why})
    if a.json:
        return emit({"queue": out}, True)
    ready = [x for x in out if x["eligible"]]
    if not ready:
        print("không có PR nào đủ điều kiện merge")
    for x in ready:
        print(f"PR #{x['pr']:<5} ← #{x['issue']}  {x['title'][:60]}")
    if a.verbose:
        print("\n-- chưa đủ điều kiện --")
        for x in out:
            if not x["eligible"]:
                print(f"PR #{x['pr']}: {'; '.join(x['blockers'])}")
    return out


def merge_sub_prs(issue: int) -> list[dict]:
    """Merge PR của các repo con TRƯỚC PR umbrella, rồi căn lại pointer.

    Vì sao phải nằm trong `tal merge` chứ không để người làm tay: một thay đổi
    trải nhiều repo là MỘT đơn vị, nhưng git bắt nó thành N+1 PR có ràng buộc thứ
    tự. Merge umbrella trước ⇒ base mang pointer trỏ một nhánh chưa merge, và
    nhánh đó bị xoá ngay sau khi PR con merge ⇒ `git submodule update` chết cho
    mọi người. Làm tay thì đúng được, nhưng phải đúng **mỗi lần**: đo trong một
    phiên là 5 cặp, và 3/5 phải giải conflict gitlink sau đó vì merge PR umbrella
    thứ nhất đã đẩy pointer trên base đi.

    Lấy TIP **mới** sau mỗi lần merge, không dùng lại giá trị đọc lúc đầu — dùng
    lại là đặt pointer LÙI, và pointer lùi thì `pre-push` chặn ở người kế tiếp.
    """
    led, _, _ = ledger_read(issue)
    subs = led.get("sub_prs") or {}
    if not subs:
        return []
    done = []
    for path, info in sorted(subs.items()):
        repo, spr = info.get("repo"), info.get("pr")
        if not (repo and spr):
            continue
        d = gh_json(["pr", "view", str(spr), "-R", repo, "--json", "state,mergeable"], default={})
        state = (d or {}).get("state")
        if state == "MERGED":
            done.append({"path": path, "repo": repo, "pr": spr, "action": "đã merge từ trước"})
            continue
        if state != "OPEN":
            raise Fail(f"PR con {repo}#{spr} ({path}) ở trạng thái {state} — không merge "
                       f"umbrella khi cụm chưa đủ. Xử lý nó trước.", 2)
        p = gh(["pr", "merge", str(spr), "-R", repo, "--merge", "--delete-branch"], check=False)
        if p.returncode != 0:
            raise Fail(f"merge PR con {repo}#{spr} ({path}) thất bại — DỪNG, chưa merge "
                       f"umbrella:\n{(p.stdout + p.stderr).strip()}", 2)
        done.append({"path": path, "repo": repo, "pr": spr, "action": "đã merge"})
        print(f"  · PR con {repo}#{spr} ({path}) đã merge")
    return done


def realign_pointers(issue: int, branch: str, subs: list[dict]) -> list[str]:
    """Đưa pointer trên nhánh umbrella lên TIP repo con, nếu đã bị bỏ lại phía sau.

    Chỉ chạy khi pointer là **tổ tiên** của tip — đó là ca duy nhất máy được phép
    tự quyết theo bảng ở `docs/guide/agent-issue-loop.md`. Phân kỳ thì dừng và
    để người xử, vì lúc đó không có đáp án đúng duy nhất.
    """
    if not subs:
        return []
    wt = C.worktrees_dir / f"issue-{issue}"
    if not wt.exists():
        wt = ensure_worktree(issue, branch)
    root = str(wt)
    run(["git", "fetch", "-q", "origin", branch], cwd=root, check=False)
    # #2300 C6 — hai rào trước khi commit + force-push từ worktree này:
    # (a) cây phải SẠCH — file đang staged của session song song từng bị cuốn vào
    #     commit "căn pointer" (đúng sự cố uncommitted-work-swept CLAUDE.md ghi);
    # (b) HEAD phải LÀ origin/<branch> — worktree cũ/lệch remote mà force-push là
    #     ĐÈ MẤT commit chỉ-có-trên-remote (kể cả commit sửa theo review).
    porc = run(["git", "status", "--porcelain"], cwd=root, check=False).stdout.strip()
    if porc:
        raise Fail(f"worktree {root} còn thay đổi chưa commit ({len(porc.splitlines())} mục) — "
                   "realign sẽ cuốn chúng vào commit căn pointer. Dọn/stash trước.", 2)
    head_l = run(["git", "rev-parse", "HEAD"], cwd=root, check=False).stdout.strip()
    rem = run(["git", "rev-parse", f"origin/{branch}"], cwd=root, check=False)
    if rem.returncode == 0 and rem.stdout.strip() and head_l != rem.stdout.strip():
        raise Fail(f"worktree {root} không đứng ở origin/{branch} "
                   f"(HEAD {head_l[:9]} ≠ remote {rem.stdout.strip()[:9]}) — force-push từ đây "
                   f"sẽ đè commit chỉ có trên remote. `git -C {root} pull --ff-only origin {branch}` "
                   "hoặc người tự giải rồi chạy lại.", 2)
    changed = []
    for s in subs:
        path = s["path"]
        sub = wt / path
        # Repo con CHƯA checkout thì thư mục vẫn tồn tại nhưng RỖNG — và git chạy
        # trong thư mục rỗng sẽ leo LÊN repo cha. `origin/dev` khi đó là tip của
        # UMBRELLA, nên phép so tổ tiên bên dưới đem pointer submodule so với SHA
        # của repo khác: luôn "phân kỳ", luôn chặn merge, và thông báo lỗi hướng
        # người đọc đi soi một lịch sử không tồn tại. Đã chặn thật PR #1415.
        if not (sub / ".git").exists():
            run(["git", "submodule", "update", "--init", path], cwd=root, check=False)
        top = run(["git", "rev-parse", "--show-toplevel"], cwd=str(sub), check=False)
        if top.returncode != 0 or Path(top.stdout.strip()).resolve() != sub.resolve():
            raise Fail(f"submodule {path} chưa checkout được trong {root} — git ở đó "
                       f"đang leo lên repo cha, mọi so sánh pointer sẽ sai. "
                       f"Chạy `git -C {root} submodule update --init {path}` rồi thử lại.", 2)
        run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=str(sub), check=False)
        tip = run(["git", "rev-parse", f"origin/{BASE_BRANCH}"], cwd=str(sub)).stdout.strip()
        cur = run(["git", "ls-tree", "HEAD", path], cwd=root).stdout.split()
        cur = cur[2] if len(cur) > 2 else ""
        if not cur or cur == tip:
            continue
        anc = run(["git", "merge-base", "--is-ancestor", cur, tip], cwd=str(sub), check=False)
        if anc.returncode != 0:
            raise Fail(f"pointer {path} ({cur[:9]}) KHÔNG phải tổ tiên của tip "
                       f"{tip[:9]} — phân kỳ thật, máy không giải hộ được. Xem "
                       f"`git -C {path} log --oneline --graph {cur[:9]} {tip[:9]}`.", 2)
        run(["git", "update-index", "--cacheinfo", f"160000,{tip},{path}"], cwd=root)
        changed.append(path)
        print(f"  · pointer {path}: {cur[:9]} → {tip[:9]} (tổ tiên, tự căn)")
    if changed:
        run(["git", "commit", "-q", "-m",
             "chore(submodule): căn pointer lên tip sau khi merge PR con\n\n"
             + "\n".join(f"- {p}" for p in changed)], cwd=root)
        push_with_lease(root, branch, set_upstream=False)
    return changed


def reopened_after(n: int, merged_at: str | None) -> bool:
    """Issue có được MỞ LẠI sau thời điểm PR merge không.

    #1571 — đây là tín hiệu duy nhất phân biệt hai thứ mà `closable()` trước đây
    gộp làm một:

      · issue chưa từng đóng, PR vừa merge      → đóng là ĐÚNG
      · issue ĐÃ đóng rồi ai đó MỞ LẠI          → đóng là XOÁ MỘT QUYẾT ĐỊNH

    Trường hợp thứ hai có thật và lặp bốn lần trong một phiên: một PR làm xong
    MỘT PHẦN issue, `Closes #N` đóng nó, người/agent mở lại kèm comment liệt kê
    phần còn lại — rồi `gc` đóng lại trong vòng 5 phút. Việc còn dang dở biến mất
    khỏi hàng đợi, im lặng. Nhãn `status:*` không cứu được: issue mở lại thường
    mang `agent:ready` chứ không mang `status:` nào.

    Chỉ gọi khi thật sự sắp đổi trạng thái một issue ĐANG MỞ có PR đã merge —
    hiếm, vài cái mỗi lần chạy — nên một lời gọi API nữa ở đây là rẻ.
    """
    if not merged_at:
        return False
    # #2300 C9 — `--paginate` KHÔNG gộp trang: >100 event là nhiều mảng JSON nối
    # nhau, `-q` + json.loads chết ⇒ trước đây issue nhiều event bị coi "đã
    # reopen" VĨNH VIỄN (fail-safe đúng hướng nhưng im lặng và lặp mỗi lần gc).
    p = gh(["api", f"repos/{C.repo}/issues/{n}/timeline", "--paginate"], check=False)
    # Không đọc được timeline ⇒ FAIL-SAFE theo hướng KHÔNG đụng vào issue.
    # Đóng nhầm là mất việc; bỏ qua nhầm chỉ là một dòng nhãn cũ.
    if p is None or p.returncode != 0 or not (p.stdout or "").strip():
        return True
    try:
        events = _json_pages(p.stdout)
    except (json.JSONDecodeError, ValueError):
        return True
    return any(e.get("event") == "reopened" and (e.get("created_at") or "") > merged_at
               for e in events if isinstance(e, dict))


def closable(n: int, merged_at: str | None = None) -> tuple[bool, str]:
    """Issue này có được ĐÓNG khi PR của nó merge vào `dev` không.

    Chốt của chủ sản phẩm (2026-08-01): merge vào `dev` là đóng. `Closes #N`
    trong thân PR không bao giờ chạy — GitHub chỉ tự đóng khi merge vào DEFAULT
    BRANCH, mà default của repo là `main` còn mọi PR ở đây nhắm `dev`.

    Ngoại lệ, và nó có thật: `tal merge` gắn `status:shipped` cho MỌI PR merge,
    kể cả PR mới xong một pha của một epic. #962 (Modular Monolith) vì thế mang
    cả `status:planning` lẫn `status:shipped`; #1392 mang cả `status:blocked`
    lẫn `status:shipped`. Đóng những cái đó là **xoá việc còn dang dở khỏi tầm
    mắt**. Nên: còn một nhãn `status:*` nào khác `shipped` thì KHÔNG đóng, để
    người quyết.
    """
    d = issue_data(n)
    if d["state"] != "open":
        return False, ""
    other = sorted(l for l in d.get("labels", [])
                   if l.startswith("status:") and l != L_SHIPPED)
    if other:
        return False, f"còn mang {', '.join(other)} — việc chưa xong, để người quyết"
    if reopened_after(n, merged_at):
        return False, ("đã được MỞ LẠI sau khi PR merge — ai đó cố ý nói việc chưa xong; "
                       "đóng lại là xoá quyết định đó")
    return True, ""


def pr_dangling_pointers(pr: int) -> list[str]:
    """Con trỏ submodule trong HEAD của PR có với tới được từ `dev` repo con không.

    Cổng CUỐI CÙNG mà `tal` cưỡng chế được (#1487). Ba lớp trước đều hụt:
      - `submodule_audit` chỉ chạy lúc `tal pr`, trong worktree người viết. Sau đó
        repo con đi tiếp, PR con bị đóng, nhánh bị xoá — audit không chạy lại.
      - `dangling_pointers()` (#1465) chỉ nằm trong `tal doctor`, phải tự nhớ chạy.
      - `realign_pointers()` chỉ tự căn khi con trỏ là TỔ TIÊN của tip repo con;
        con trỏ chết không phải tổ tiên của gì cả, nên nó im lặng bỏ qua.

    Đã lọt BA LẦN trong một ngày (2026-08-01), cả ba đều là `customer-web` trỏ vào
    commit chỉ sống trên nhánh feature. Nghĩa là clone mới chết ở `submodule
    update` — và `tal gc` thì xoá nhánh đã merge.

    GIỚI HẠN, nói ra chứ không giả vờ đã kín: ai chạy `gh pr merge` thẳng thì đi
    vòng qua đây. Bịt nốt cần branch protection + required check bên GitHub.
    """
    head = gh_json(["pr", "view", str(pr), "-R", C.repo, "--json", "headRefName"],
                   default={}).get("headRefName")
    if not head:
        return []
    root = str(C.main_worktree)
    fp = run(["git", "fetch", "-q", "origin", head], cwd=root, check=False)
    if fp.returncode != 0:
        # #2300 C8 — fetch hỏng mà đi tiếp là kiểm pointer của TRACKING REF CŨ
        # (có thể là bản trước realign): cổng cuối #1487 khi đó gật đầu cho một
        # dangling thật. Không đo được thì chặn.
        raise Fail(f"không fetch được origin/{head} để kiểm pointer — không đo được thì "
                   f"không merge (#1487/#2300): {(fp.stderr or fp.stdout).strip()[:200]}", 2)
    bad = []
    for sm in submodules().values():
        path = sm["path"]
        sub = C.main_worktree / path
        if not (sub / ".git").exists():
            # #2300 C8 — bỏ qua im lặng là cổng cuối tự bịt mắt với đúng submodule
            # đang cần kiểm. Fail kèm lệnh sửa.
            raise Fail(f"submodule {path} chưa checkout ở cây chính — cổng pointer không kiểm "
                       f"được. Chạy `git -C {root} submodule update --init {path}` rồi merge lại.", 2)
        r = run(["git", "rev-parse", f"origin/{head}:{path}"], cwd=root, check=False)
        if r.returncode != 0:
            continue
        ptr = r.stdout.strip()
        run(["git", "fetch", "-q", "origin", "--prune"], cwd=str(sub), check=False)
        if run(["git", "cat-file", "-e", ptr + "^{commit}"], cwd=str(sub),
               check=False).returncode != 0:
            bad.append(f"{path}: {ptr[:12]} KHÔNG TỒN TẠI trong repo con")
            continue
        if run(["git", "merge-base", "--is-ancestor", ptr, f"origin/{BASE_BRANCH}"],
               cwd=str(sub), check=False).returncode == 0:
            continue
        br = run(["git", "branch", "-r", "--contains", ptr], cwd=str(sub),
                 check=False).stdout.split()
        bad.append(
            f"{path}: {ptr[:12]} chưa nằm trên origin/{BASE_BRANCH} của repo con; "
            f"sống nhờ {', '.join(br) if br else 'KHÔNG NHÁNH NÀO'}. "
            f"Merge PR con vào {BASE_BRANCH} TRƯỚC — con trỏ sẽ được tính lại."
        )
    return bad


def wait_checks(repo: str, pr: int, timeout: int = 1800) -> tuple[bool, str]:
    """Chờ CI của một PR xong. Trả (xanh?, mô tả).

    Chỉ xét check THẬT SỰ chạy: `SKIPPED` và `NEUTRAL` không phải đỏ cũng không
    phải xanh — một job có `if:` không thoả (như `pest` sau #1516, khi PR nhắm
    `dev`) sẽ mãi ở SKIPPED, và coi nó là "chưa xong" thì lệnh chờ vô hạn.

    Không có check nào ⇒ coi là xanh: nhiều repo con không cấu hình CI, và bắt
    chúng phải có mới merge được là dựng một rào không ai xin.
    """
    PENDING = {"IN_PROGRESS", "QUEUED", "PENDING", "WAITING", "REQUESTED"}
    OK = {"SUCCESS", "SKIPPED", "NEUTRAL"}
    waited = 0
    while True:
        rows = gh_json(["pr", "checks", str(pr), "-R", repo, "--json", "name,state"],
                       default=[]) or []
        if not rows:
            return True, "không có check nào"
        states = {r.get("state") for r in rows}
        if states & PENDING:
            if waited >= timeout:
                return False, f"quá {timeout}s mà CI chưa xong: " + ", ".join(
                    f"{r['name']}={r['state']}" for r in rows if r.get("state") in PENDING)
            time.sleep(20)
            waited += 20
            continue
        bad = [r for r in rows if r.get("state") not in OK]
        if bad:
            return False, "CI đỏ: " + ", ".join(f"{r['name']}={r['state']}" for r in bad)
        n = sum(1 for r in rows if r.get("state") == "SUCCESS")
        return True, f"{n} check xanh"


def cmd_pr_merge(a):
    """Cả chuỗi merge trong MỘT lệnh: con trước, chờ CI, kiểm con trỏ, umbrella sau.

    Chuỗi này trước đây phải làm tay 7 bước, và trong một phiên ngày 2026-08-01
    nó bị làm hơn mười lần với nhầm lẫn ở bước suy issue, chờ CI và kiểm con trỏ.

    RANH GIỚI, cố ý: lệnh này KHÔNG tự gắn `agent:review-passed`. Nhãn đó là bằng
    chứng đã có người đọc lại; lệnh tự gắn thì nó chỉ còn là thủ tục và cổng tách
    vai chết theo. Thiếu nhãn ⇒ dừng và nói rõ, không tự quyết.
    """
    pr = a.pr
    wait = not getattr(a, "no_wait", False)
    tmo = getattr(a, "timeout", 1800)

    # ① issue + cổng review
    issue, why, _ev = merge_blockers(pr, require_ci=False)
    if why and not a.force:
        raise Fail("① KHÔNG merge được PR #%d:\n  - %s\n"
                   "`pr-merge` cố ý KHÔNG tự gắn `%s` — nhãn đó là bằng chứng đã có "
                   "người đọc lại, không phải một bước thủ tục." % (
                       pr, "\n  - ".join(why), L_PASSED), 2)
    print(f"① PR #{pr} ← issue #{issue} · review đạt")

    # ② PR con
    led_sub, _, _ = ledger_read(issue) if issue else ({}, None, None)
    subs = [{"path": path, "repo": info.get("repo"), "pr": info.get("pr")}
            for path, info in sorted((led_sub.get("sub_prs") or {}).items())
            if info.get("repo") and info.get("pr")]
    if not subs:
        print("② không có PR con")
    for sp in subs:
        print(f"② PR con {sp['repo']}#{sp['pr']} ({sp['path']})")

    # ③ chờ CI PR con
    if wait:
        for sp in subs:
            ok, msg = wait_checks(sp["repo"], sp["pr"], tmo)
            print(f"③ {sp['repo']}#{sp['pr']}: {msg}")
            if not ok and not a.force:
                raise Fail(f"③ dừng — {sp['repo']}#{sp['pr']} chưa xanh. "
                           f"Sửa rồi chạy lại; KHÔNG merge umbrella khi con đang đỏ.", 2)

    # ⑥ chờ CI umbrella (④⑤⑦ nằm trong cmd_merge)
    if wait:
        ok, msg = wait_checks(C.repo, pr, tmo)
        print(f"⑥ umbrella #{pr}: {msg}")
        if not ok and not a.force:
            raise Fail(f"⑥ dừng — PR #{pr} chưa xanh: {msg}", 2)

    print("④⑤⑦ merge con → căn con trỏ → cổng con trỏ → merge umbrella")
    return cmd_merge(a)


def promotion_base_verdict(base: str | None, promote: bool,
                           base_branch: str, promotion_branch: str) -> str | None:
    """Base của PR có được phép merge không — phần thuần tuý, để test được.

    Trả `None` khi cho qua, hoặc một chuỗi mã lý do khi chặn:
      promotion   — base là nhánh phát hành mà không khai `--promote`
      foreign     — base không phải `base_branch` cũng không phải nhánh phát hành

    `promote=True` chỉ mở được ĐÚNG nhánh phát hành. Nó không phải cờ "bỏ qua
    mọi kiểm base": một PR nhắm `release/x` vẫn bị chặn, vì lúc đó người gọi
    đang nhầm chứ không phải đang phát hành.

    `base is None` (không đọc được) ⇒ cho qua. Rào này chống một tai nạn CỤ THỂ,
    không phải chống mạng hỏng; fail-closed ở đây chỉ làm mọi lệnh merge chết
    khi GitHub chậm, và người ta sẽ gỡ nguyên cái rào.
    """
    if base is None or base == base_branch:
        return None
    if base == promotion_branch:
        return None if promote else "promotion"
    return "foreign"


def promotion_only_files(base_branch: str, promotion_branch: str,
                         cwd: str | None = None, refresh: bool = True) -> list[str]:
    """Files that exist on the release branch but not on its source branch.

    A normal ``dev -> main`` promotion may add or modify files, but it must not
    silently delete a file that arrived on ``main`` through a production
    hotfix.  Refresh both remote-tracking refs immediately before measuring;
    using an old local ref would turn this safety gate into another memory aid.

    ``--no-renames`` is deliberate.  The question is about path existence, not
    Git's similarity guess: if a path is absent from ``dev`` and present on
    ``main``, the operator must reconcile it before promotion even when Git can
    pair it with a differently named file.
    """
    root = cwd or str(C.main_worktree)
    if refresh:
        fetched = run([
            "git", "fetch", "--quiet", "origin",
            f"{base_branch}:refs/remotes/origin/{base_branch}",
            f"{promotion_branch}:refs/remotes/origin/{promotion_branch}",
        ], cwd=root, check=False)
        if fetched.returncode != 0:
            detail = (fetched.stderr or fetched.stdout).strip() or "git fetch failed"
            raise Fail(
                f"không làm mới được origin/{base_branch} + origin/{promotion_branch}; "
                f"KHÔNG thể chứng minh lượt promote không xoá file: {detail}", 2)

    diff = run([
        "git", "diff", "--name-only", "-z", "--no-renames", "--diff-filter=A",
        f"origin/{base_branch}..origin/{promotion_branch}", "--",
    ], cwd=root, check=False)
    if diff.returncode != 0:
        detail = (diff.stderr or diff.stdout).strip() or "git diff failed"
        raise Fail(
            f"không so được origin/{base_branch} với origin/{promotion_branch}; "
            f"KHÔNG thể chứng minh lượt promote không xoá file: {detail}", 2)
    return [path for path in diff.stdout.split("\0") if path]


def assert_merge_landed(pr: int, head_sha: str) -> None:
    """Ném `Fail` nếu `head_sha` chưa nằm trong `origin/<base>` (#2988).

    Gọi NGAY SAU khi `gh pr merge` trả 0 và TRƯỚC mọi thao tác phá huỷ.

    `head_sha` rỗng ⇒ im. Đây là PHÒNG THỦ cho người gọi khác, không phải đường
    của `cmd_merge`: chỗ đó đo bằng `gh_json_strict` và đã `Fail` từ trước khi
    merge, nên nó không bao giờ gọi vào đây với chuỗi rỗng. Giữ nhánh này vì
    một hàm đo mà tự nổ khi thiếu đầu vào thì người gọi kế tiếp sẽ bọc try/except
    quanh nó — và một rào bị bọc try/except là rào đã tắt.
    """
    if not head_sha:
        return

    run(["git", "fetch", "-q", "origin", BASE_BRANCH], check=False)
    landed = run(["git", "merge-base", "--is-ancestor", head_sha,
                  f"origin/{BASE_BRANCH}"], check=False).returncode == 0
    if landed:
        return

    raise Fail(
        f"`gh pr merge` trả 0 nhưng {head_sha[:12]} KHÔNG phải tổ tiên của "
        f"origin/{BASE_BRANCH} — merge CHƯA landed.\n"
        f"worktree/nhánh/ledger GIỮ NGUYÊN. Kiểm `gh pr view {pr} "
        f"--json state,mergedAt` rồi chạy lại."
    )


def cmd_merge(a):
    pr = a.pr
    # #2573 — cửa ĐẦU TIÊN, trước mọi cổng khác, vì nó hỏi một câu khác hẳn:
    # "PR này đổ vào ĐÂU?" chứ không phải "PR này đủ tốt chưa?".
    #
    # Merge một PR `dev → main` là chạy `deploy-xserver.yml`: `migrate --force`
    # + hai `db:seed` + provisioner ghi Platform, vào database production, không
    # người trông. Và người gọi gần như không bao giờ CHỌN điều đó — GitHub tự
    # đổi base sang `main` cho MỌI PR đang mở nhắm `dev` mỗi khi một PR
    # `dev → main` merge (`automatic_base_change_succeeded`), im lặng, giữ
    # nguyên tiêu đề/mô tả/nhãn. Ngày 2026-08-12: bốn lần phát hành kéo 9 PR, và
    # một trong số đó bị merge nhầm vào `main` lúc 11:32 JST — giữa giờ trưa —
    # chỉ không thành deploy vì kịp huỷ `backend-tests` trước khi `workflow_run`
    # nối sang deploy.
    #
    # `--force` KHÔNG mở được rào này, và đó là cả điểm của nó: `--force` là thứ
    # mọi session gõ hằng ngày để bỏ cổng review, nên nếu nó bypass thì rào chết
    # ngay ngày đầu. Chỉ `--promote` mở, vì `--promote` là một câu khẳng định về
    # Ý ĐỊNH, không phải một cách nói "kệ đi".
    _target = gh_json(["pr", "view", str(pr), "-R", C.repo, "--json",
                       "baseRefName,headRefName"], default={}) or {}
    _base = _target.get("baseRefName")
    _head = _target.get("headRefName")
    _verdict = promotion_base_verdict(_base, getattr(a, "promote", False),
                                      BASE_BRANCH, PROMOTION_BRANCH)
    if _verdict == "promotion":
        raise Fail(
            f"PR #{pr} nhắm `{_base}`, KHÔNG phải `{BASE_BRANCH}` — merge nó là phát hành "
            f"lên production (`deploy-xserver.yml`: migrate --force + db:seed + ghi Platform, "
            f"không người trông).\n"
            f"  Bị GitHub tự đổi base? (xảy ra với MỌI PR mở nhắm `{BASE_BRANCH}` mỗi lần một "
            f"PR `{BASE_BRANCH} → {PROMOTION_BRANCH}` merge — kiểm `automatic_base_change_succeeded` "
            f"trong timeline)\n"
            f"      gh pr edit {pr} -R {C.repo} --base {BASE_BRANCH}\n"
            f"  Cố ý phát hành? Nói ra:\n"
            f"      tal merge {pr} --promote\n"
            f"`--force` KHÔNG mở rào này.", 2)
    if _verdict == "foreign":
        raise Fail(
            f"PR #{pr} nhắm `{_base}` — không phải `{BASE_BRANCH}` cũng không phải nhánh phát "
            f"hành `{PROMOTION_BRANCH}`. `tal` không biết nhánh đó là gì, nên không merge hộ. "
            f"Nhắm lại base rồi chạy lại:\n"
            f"      gh pr edit {pr} -R {C.repo} --base {BASE_BRANCH}", 2)

    # #2909 — một hotfix đi thẳng vào main phải được mang ngược về dev trước
    # lượt promote kế. Nếu không, merge dev -> main sẽ XÓA path của hotfix; xoá
    # chính file test vẫn để mọi suite xanh. Chỉ áp dụng cho đúng PR
    # BASE_BRANCH -> PROMOTION_BRANCH: hotfix branch -> main là đường tạo ra
    # chênh lệch này và không được tự chặn chính nó. `--force` không mở cổng —
    # đây là mất dữ liệu đã ship, không phải review/CI chưa đủ.
    if (_base == PROMOTION_BRANCH and _head == BASE_BRANCH
            and getattr(a, "promote", False)):
        _promotion_only = promotion_only_files(BASE_BRANCH, PROMOTION_BRANCH)
        if _promotion_only:
            shown = "\n".join(f"  - {path}" for path in _promotion_only[:50])
            more = (f"\n  - … và {len(_promotion_only) - 50} file khác"
                    if len(_promotion_only) > 50 else "")
            raise Fail(
                f"PR #{pr}: CHẶN promote `{BASE_BRANCH} → {PROMOTION_BRANCH}` — "
                f"`{PROMOTION_BRANCH}` có {len(_promotion_only)} file mà `{BASE_BRANCH}` "
                f"không có; merge lúc này sẽ âm thầm xoá chúng:\n{shown}{more}\n"
                f"Mang hotfix ngược về `{BASE_BRANCH}` (cherry-pick/PR), xác nhận danh sách "
                f"rỗng rồi chạy lại. `--force` KHÔNG mở rào này.", 2)
    # #2300 C5 — cổng merge-batch là bước TUẦN TỰ trên base: một merge lẻ đẩy
    # base đi giữa lúc lô đang chạy suite là kết luận của suite nói về một base
    # không còn tồn tại (hình dạng ws#239). Không đo được thì không chặn — cây
    # tạm của batch tự vệ thêm một lớp.
    if not getattr(a, "batch_verified", False):
        try:
            _gate_busy = ref_exists(BATCH_KEY)
        except Fail:
            _gate_busy = False
        if _gate_busy and not a.force:
            raise Fail(f"cổng merge-batch đang chạy (ref {BATCH_KEY}) — merge lẻ lúc này làm "
                       "suite của lô kết luận trên base đã đổi. Chờ lô xong; chắc chắn cổng "
                       f"chết: `tal unlock {BATCH_KEY} --force`.", BUSY)
    # #1454 — mặc định KHÔNG đòi CI: CI ở repo này CHÍNH LÀ pest full, nên đòi
    # nó là bắt người chờ full suite qua một đường vòng. Review đạt vẫn bắt buộc.
    # `--require-ci` để opt-in khi thật sự cần đối chứng.
    issue, why, verdict_ev = merge_blockers(pr, require_ci=getattr(a, "require_ci", False))
    # #2300 C2 — đường batch: bằng chứng verdict đã bắt TRƯỚC realign (head lúc đó
    # là bản reviewer đọc). Sau realign head đổi nên tra lại chắc chắn trượt —
    # blocker đó với batch là dương tính giả; các blocker khác vẫn chặn như thường.
    if getattr(a, "batch_verified", False):
        _batch_ev = getattr(a, "verdict_ev", None)
        if _batch_ev and _batch_ev[0]:
            verdict_ev = tuple(_batch_ev)
            why = [w for w in why if "verdict=pass" not in w]

    # #2639 — CỬA CI, và `--force` KHÔNG mở nó.
    #
    # #2630 merge vào `dev` lúc 15:05:50Z với `arch-gate` ĐỎ trên chính PR đó. Từ
    # commit merge ấy trở đi MỌI PR vào `dev` đỏ theo — CI chạy trên commit trộn —
    # và #2636, không chạm một dòng PHP nào, mất ba lượt truy ngược để chứng minh
    # mình vô can. Khoảng vỡ đo được là 45 phút.
    #
    # GitHub không chặn hộ được: repo private trên gói hiện tại trả
    # `403: Upgrade to GitHub Pro` cho `branches/dev/protection`, nên **không có
    # required status check nào tồn tại**. Rào này là thứ duy nhất còn lại trên
    # đường `tal` — và nó KHÔNG phủ `gh pr merge` hay nút trên web.
    #
    # `--force` không mở, vì `--force` là thứ mọi session gõ hằng ngày để bỏ cổng
    # review; mở được bằng nó thì rào chết ngay ngày đầu (bài học #2573). Cửa duy
    # nhất là `--ci-red --note "<vì sao>"` — một lời khẳng định về Ý ĐỊNH.
    _ci_ack = getattr(a, "ci_red", False)
    _reds = ci_red_verdict(why, _ci_ack)
    if _reds:
        raise Fail(
            f"PR #{pr}: CI ĐỎ — {' · '.join(_reds)}. KHÔNG merge.\n"
            f"  Một PR đỏ vào `{BASE_BRANCH}` làm MỌI PR sau đó đỏ theo (CI chạy trên commit "
            f"trộn), và tác giả của chúng đi tìm oan — #2639."
            # Tên check hỏi lại `pr_checks` chứ không tách từ chuỗi blocker — xem
            # `ci_red_verdict`. Một call thêm, chỉ trên đường TỪ CHỐI.
            + base_red_hint(red_check_names(pr_checks(pr)[1])) + "\n"
            f"  Xanh lại rồi chạy lại:\n"
            f"      tal merge {pr}\n"
            f"  Đỏ vì lý do NGOÀI PR này và bạn đã xác minh? Nói ra:\n"
            f"      tal merge {pr} --ci-red --note \"<vì sao đỏ này không phải của PR này>\"\n"
            f"`--force` KHÔNG mở rào này.", 2)

    # #2669 — CỬA THỨ HAI, cùng họ: CI CHƯA NÓI. Đo hai lần trong một phiên
    # (#2653 16:31:58Z, #2663 17:55:03Z) — cả hai merge lúc `arch-gate` còn chạy;
    # trên #2663 nó xanh 39 giây SAU merge. Không cái nào đỏ, nên #2639 im lặng.
    #
    # TỪ CHỐI, không chờ-rồi-thử-lại: một vòng chờ trong `tal merge` là trạng thái
    # mới phải bảo trì (timeout, Ctrl-C giữa chừng, lease/cổng batch giữ suốt lúc
    # ngủ), trong khi cái giá của từ chối là gõ lại MỘT lệnh. Ai thật sự muốn chờ
    # thì `tal pr-merge` đã có sẵn vòng đó (`wait_checks`, `--timeout`) — không cần
    # dựng cái thứ hai.
    _pending = ci_pending_verdict(why, _ci_ack)
    if _pending:
        # Tuổi của check hỏi lại `pr_check_rows` chứ không tách từ chuỗi blocker —
        # cùng lý do với `red_check_names` ở #2639. Một call thêm, chỉ ở đường TỪ CHỐI.
        _rep = pending_check_report(pr) or _pending
        raise Fail(
            f"PR #{pr}: CI CHƯA XONG — {' · '.join(_rep)}. KHÔNG merge.\n"
            f"  \"Chưa biết\" không phải \"đã xanh\". CI chạy trên commit TRỘN, nên một PR "
            f"hoá đỏ sau khi vào `{BASE_BRANCH}` làm MỌI PR sau đó đỏ theo và tác giả của "
            f"chúng đi tìm oan — #2639/#2669.\n"
            f"  Chờ CI xong rồi chạy lại (thường vài phút):\n"
            f"      tal merge {pr}\n"
            f"  Muốn đứng chờ hộ: `tal pr-merge {pr}` (có sẵn vòng chờ + --timeout).\n"
            f"  Check kẹt / sẽ không bao giờ chạy, và bạn đã xác minh? Nói ra:\n"
            f"      tal merge {pr} --ci-red --note \"<vì sao merge khi CI chưa nói>\"\n"
            f"`--force` KHÔNG mở rào này.", 2)

    if _ci_ack:
        _acked = [w for w in why if w.startswith(CI_RED) or w.startswith(CI_PENDING)]
        if _acked:
            if not (getattr(a, "note", "") or "").strip():
                raise Fail('`--ci-red` bắt buộc kèm `--note "<vì sao CI chưa nói mà vẫn '
                           'merge>"` — merge lên một CI đỏ hoặc chưa xong phải để lại dấu '
                           "vết đọc được, không phải một cờ im lặng (#2639/#2669).", 2)
            _head = ("MERGE KHI CI ĐỎ" if any(w.startswith(CI_RED) for w in _acked)
                     else "MERGE KHI CI CHƯA XONG")
            why = [w for w in why
                   if not (w.startswith(CI_RED) or w.startswith(CI_PENDING))]
            gh(["pr", "comment", str(pr), "-R", C.repo, "-b",
                f"**{_head} — `--ci-red`.** Session `{session_id()[:8]}…`\n\n"
                f"> {a.note.strip()}\n\nBỏ qua: " + "; ".join(_acked)], check=False)
            warn(f"--ci-red: merge dù CI chưa xanh — " + "; ".join(_acked))

    if why and not a.force:
        raise Fail("KHÔNG merge được PR #%d:\n  - %s\nLuật: review phải ĐẠT và CI phải XANH."
                   % (pr, "\n  - ".join(why)), 2)
    if why:
        if not (getattr(a, "note", "") or "").strip():
            raise Fail('`--force` bắt buộc kèm `--note "<lý do>"` khi bỏ qua cổng merge '
                       "(verdict/CI/nhãn) — phá luật thì phải nói to (#2261).", 2)
        gh(["pr", "comment", str(pr), "-R", C.repo, "-b",
            f"**MERGE KHÔNG CỔNG — `--force`.** Session `{session_id()[:8]}…`\n\n"
            f"> {a.note.strip()}\n\nBỏ qua: " + "; ".join(why)], check=False)
        warn(f"--force: bỏ qua {len(why)} điều kiện — " + "; ".join(why))

    # Cửa THỨ BA — nơi hệ quả thành thật. Đây là cửa duy nhất trước đây KHÔNG có rào
    # nào, và số đo là: chín lần tự merge trong một phiên, bởi chính session viết ra
    # luật cấm. `--batch-verified` (lời gọi nội bộ từ `merge-batch`) được miễn: lúc đó
    # cả lô đã qua cổng, và người bấm `merge-batch` mới là chủ thể, không phải PR.
    if issue and not a.batch_verified:
        led_sod, _, _ = ledger_read(issue)
        assert_not_own_work(led_sod, pr, "merge", getattr(a, "self_merge", False), "--self")
        if getattr(a, "self_merge", False):
            if not (getattr(a, "note", "") or "").strip():
                raise Fail("`--self` bắt buộc kèm `--note \"<vì sao>\"` — tự merge phải "
                           "để lại dấu vết đọc được, không phải một cờ im lặng.", 2)
            gh(["pr", "comment", str(pr), "-R", C.repo, "-b",
                f"**TỰ MERGE — tách vai bị phá.** Session `{session_id()[:8]}…` vừa merge "
                f"PR mà chính nó đã code.\n\n> {a.note}\n\nGhi ra để không thành tiền lệ: "
                f"không ai đọc lại thay đổi này ngoài người viết. Review sau-merge vẫn có "
                f"giá trị."], check=False)
            warn(f"TỰ MERGE PR #{pr} — đã ghi lý do lên PR: {getattr(a, 'note', '')}")

    # CỤM trước, umbrella sau — thứ tự này không có ngoại lệ (#1393).
    subs = []
    if issue and not a.no_subs:
        subs = merge_sub_prs(issue)
        if subs:
            br = gh_json(["pr", "view", str(pr), "-R", C.repo, "--json", "headRefName"],
                         default={}).get("headRefName") or f"issue-{issue}"
            realign_pointers(issue, br, subs)
            # Pointer vừa đổi ⇒ GitHub phải tính lại; hỏi lại chính nó thay vì đoán.
            for _ in range(6):
                d = gh_json(["pr", "view", str(pr), "-R", C.repo, "--json", "mergeable"],
                            default={})
                if (d or {}).get("mergeable") == "MERGEABLE":
                    break
                time.sleep(2)

    # Cổng con trỏ — chạy SAU khi cụm repo con đã merge + căn lại, ngay TRƯỚC khi
    # merge thật. Đặt ở đây mới đúng: trước đó con trỏ còn có thể đang chờ
    # `realign_pointers` sửa; sau đó thì đã muộn (#1487).
    dang = pr_dangling_pointers(pr)
    if dang and not a.force:
        raise Fail(
            "KHÔNG merge được PR #%d — con trỏ submodule chưa với tới được từ "
            "`%s` của repo con:\n  - %s\n"
            "Luật: repo con vào `%s` TRƯỚC, con trỏ umbrella được TÍNH LẠI lúc "
            "merge. Merge như hiện trạng là đặt lên `%s` một con trỏ mà clone mới "
            "không lấy được." % (pr, BASE_BRANCH, "\n  - ".join(dang),
                                 BASE_BRANCH, BASE_BRANCH), 2)
    if dang:
        warn(f"--force: bỏ qua {len(dang)} con trỏ chưa với tới được — " + "; ".join(dang))

    # #2300 C1 — merge TRƯỚC, dọn SAU. Thứ tự cũ (`remove_worktree` rồi mới
    # `gh pr merge --delete-branch`) đã cắn thật: merge fail vì mergeable
    # CONFLICTING bất đồng bộ, nhưng worktree + branch cục bộ + thẻ lease đã bị
    # xoá — không gì rollback được, và bước tự nhiên kế tiếp (claim lại) quét
    # luôn nhãn review. Lý do lịch sử của thứ tự cũ là `--delete-branch` không
    # xoá được branch cục bộ đang bị worktree giữ — giải bằng cách KHÔNG dùng
    # `--delete-branch`: merge trần, thành công rồi mới dọn worktree và xoá
    # branch remote qua API. Merge fail ⇒ mọi trạng thái còn NGUYÊN.
    # SHA head lấy TRƯỚC khi merge — sau đó nhánh có thể bị xoá và không hỏi lại
    # được. Đây là thứ phép đo bên dưới đối chiếu.
    #
    # `gh_json_strict`, KHÔNG phải `gh_json`: docstring của `gh_json` cấm đúng
    # chuyện này — *"đường nào dùng kết quả để QUYẾT ĐỊNH PHÁ HUỶ phải đi
    # `gh_json_strict`/`gh_json_required`"*. Với `gh_json`, một cú 502 trả ""
    # và rào bên dưới im lặng cho qua, tức cleanup phá huỷ chạy y như trước bản
    # vá — API hỏng biến thành "đo xong, không có gì".
    #
    # Hỏng ⇒ dừng ở ĐÂY, trước cả `gh pr merge`: chưa merge thì chưa có gì để
    # phá, sạch hơn hẳn so với chặn sau merge. Cùng chiều với
    # `promotion_only_files` (#2909), vốn `Fail` khi không chứng minh được.
    _head_rows = gh_json_strict(
        ["pr", "view", str(pr), "-R", C.repo, "--json", "headRefOid"],
        f"head SHA của PR #{pr}")
    head_before = ((_head_rows or [{}])[0] or {}).get("headRefOid") or ""
    if not head_before:
        raise Fail(f"KHÔNG ĐO ĐƯỢC head SHA của PR #{pr} — GitHub trả rỗng.\n"
                   "Chưa merge gì cả. Thử lại khi API lành.")

    p = gh(["pr", "merge", str(pr), "-R", C.repo, "--merge"], check=False)
    blob = (p.stdout + p.stderr).strip()
    if p.returncode != 0:
        raise Fail(f"merge PR #{pr} thất bại — worktree/branch/nhãn GIỮ NGUYÊN, "
                   f"sửa nguyên nhân rồi chạy lại:\n{blob}")

    # #2988 — exit 0 KHÔNG có nghĩa là commit đã vào base.
    #
    # Ba bước ngay dưới đều KHÔNG rollback được: xoá worktree, XOÁ NHÁNH REMOTE,
    # ghi ledger `shipped`. Nếu chúng chạy trên một merge chưa hề landed thì PR
    # không mở lại được (`gh pr reopen` cần head branch còn sống) và công việc
    # chỉ còn trong worktree cục bộ — thứ mà `tal gc` được phép dọn.
    #
    # Đã xảy ra ở #2974: hai PR `mergedAt=null`, nhánh biến mất, `origin/dev`
    # vẫn mang bản CHƯA vá. Nên "merge fail ⇒ trạng thái còn nguyên" (#2300 C1
    # ngay trên) chỉ đúng khi "fail" được ĐO, không phải khi nó là exit code.
    #
    # Phép đo gắn với `--merge` ở dòng trên: merge commit giữ head làm tổ tiên.
    # Đổi sang `--squash` thì nội dung vào base dưới một SHA KHÁC và rào này sẽ
    # kêu oan mọi lượt — `test_merge_uses_merge_commit_so_ancestry_holds` ghim
    # cặp đôi đó lại để không ai đổi một vế mà quên vế kia.
    assert_merge_landed(pr, head_before)

    if issue:
        remove_worktree(issue)
        # Xoá branch remote sau merge (thay cho --delete-branch). 422 "đã xoá"
        # (repo bật delete_branch_on_merge) là bình thường.
        gh(["api", "-X", "DELETE", f"repos/{C.repo}/git/refs/heads/issue-{issue}"], check=False)

    if issue:
        led, cid, _ = ledger_read(issue)
        led["state"] = "shipped"
        led["lease"] = None
        # #2261 vòng 2 — KHÔNG hỏi lại GitHub ở đây: `realign_pointers` có thể đã
        # push commit căn pointer lên nhánh PR làm HEAD đổi, và tra bằng head mới
        # sẽ ghi "verdict=KHÔNG_CÓ" cho một merge đã qua cổng. Bằng chứng lấy MỘT
        # lần ở cổng (merge_blockers) — sha là bản reviewer đã thật sự đọc.
        vsha, vcid = verdict_ev
        ev = f"verdict=pass sha={vsha}" + (f" comment={vcid}" if vcid else "") if vsha else "verdict=KHÔNG_CÓ"
        ledger_write(led, cid, f"merge PR #{pr} vào {BASE_BRANCH} ({ev})")
        closed, kept = [], []
        # #2789 — group ∪ Closes: cụm chỉ được nối bằng `Closes` trong thân PR.
        # Hỏi thân PR ở ĐÂY (sau khi merge đã xong) chứ không tái dùng bản đọc
        # sớm hơn: giữa hai thời điểm đó `tal` có thể đã sửa mô tả, và nguồn
        # đúng là bản GitHub đang giữ.
        _pr_body = (gh_json(["pr", "view", str(pr), "-R", C.repo, "--json", "body"],
                            default={}) or {}).get("body")
        for n in shipped_scope(led, issue, _pr_body):
            set_state_labels(n, {L_SHIPPED} if L_SHIPPED else set(), drop={L_READY})
            ok, why = closable(n)
            if ok:
                r = gh(["issue", "close", str(n), "-R", C.repo, "-c",
                        f"Đã merge vào `{BASE_BRANCH}` qua PR #{pr}."], check=False)
                (closed if r.returncode == 0 else kept).append(n)
            elif why:
                kept.append(n)
                print(f"  · KHÔNG đóng #{n}: {why}")
        if closed:
            print("  · đóng issue: " + ", ".join(f"#{n}" for n in closed))
    print(f"đã merge PR #{pr} vào {BASE_BRANCH}" + (f", #{issue} → shipped" if issue else ""))
    return {"pr": pr, "issue": issue, "sub_prs": subs}


def repo_cfg() -> dict:
    """Chính sách repo từ .claude/agent-loop.json. Bản `tal` trong repo này không có tầng
    config như bản plugin — chỉ đọc đúng khoá cần dùng."""
    try:
        return json.loads((C.main_worktree / ".claude" / "agent-loop.json").read_text())
    except Exception:
        return {}


def full_suite_cmds() -> list[str]:
    """Lệnh cổng merge, đọc từ .claude/agent-loop.json (chính sách của repo).

    Bản `tal` trong repo này KHÔNG có tầng config như bản plugin — nó ra đời trước.
    Chỉ đọc đúng khoá cần dùng, thay vì port cả tầng config vào một bản sắp bị xoá."""
    return repo_cfg().get("fullSuite") or []


def setup_cmds() -> list[str]:
    """Lệnh dựng môi trường trong cây tạm, chạy TRƯỚC `fullSuite`.

    Cây tạm của merge-batch là một worktree mới tinh: mọi thứ nằm trong `.gitignore`
    (`backend/vendor`, `node_modules`, `.env`, submodule chưa init) đều KHÔNG có. Không
    dựng thì cổng đỏ 100% lần chạy vì thiếu binary — không phải vì test hỏng (#1329).

    Khai trong config chứ không hardcode: stack đổi (thêm app web vào `fullSuite`) thì
    bước cài phải đổi theo, ngay cạnh nó, chứ không nằm trong tool."""
    return repo_cfg().get("setup") or []


def setup_verify_cmds() -> list[str]:
    """Kiểm rẻ tiền chứng minh môi trường đã dựng xong (vd `test -x backend/vendor/bin/pest`).

    Bắt đúng ca `setup` xanh nhưng vẫn thiếu thứ `fullSuite` cần — thường là fullSuite
    được thêm lệnh mới mà setup không theo. Trượt ở đây là CỔNG HỎNG, không phải test đỏ."""
    return repo_cfg().get("setupVerify") or []


GATE_BROKEN = 3   # cây tạm không dựng được — KHÁC HẲN test đỏ (exit 2)
GATE_BUSY = 4     # session khác đang chạy cổng — KHÔNG phải hỏng, chỉ là đến lượt sau

BATCH_KEY = "merge-batch"


def batch_tmp_dir() -> Path:
    """Cây tạm RIÊNG cho từng session.

    Trước đây đường dẫn là `_batch` cố định, dùng chung cho mọi session trên cùng máy,
    và `drop_batch_worktree()` chạy ở ĐẦU mỗi lần gọi với `rm -rf`. Hai session chồng
    nhau thì session sau xoá cây của session trước **giữa lúc pest đang chạy**, và lỗi
    hiện ra như `Class "Pest\\Panic" not found` — một thông điệp chỉ thẳng vào một test
    hỏng không tồn tại (#1355). Tên theo session thì `drop_batch_worktree` chỉ còn chạm
    được cây của chính mình, kể cả khi khoá dưới đây bị mở tay.
    """
    return C.worktrees_dir / f"_batch-{_sanitize(session_id())[:12]}"


def batch_gate_acquire() -> bool:
    """Khoá cổng merge — CAS trên cùng ref namespace với lease issue.

    Cổng vốn là bước tuần tự: chỉ một lô được trộn lên base tại một thời điểm, vì lô
    sau phải thấy kết quả của lô trước. Nên một khoá là đủ, và gặp khoá thì **thoát
    sạch**, không chờ và tuyệt đối không đụng vào cây của người đang giữ.
    """
    if not local_lock(BATCH_KEY):
        return False
    # #2300 C7 — danh tính chủ cổng đi TRONG ref (như lease review #2172): gc ở
    # MÁY KHÁC trước đây chỉ có chứng cứ cục bộ ("khoá cục bộ không còn") và xoá
    # cổng đang sống của máy bên cạnh giữa lúc full suite chạy.
    if not ref_create(BATCH_KEY, head_sha(), {
        "kind": "batch-gate", "session": session_id(), "host": socket.gethostname(),
        "pid": os.getpid(), "acquired_at": iso(now()),
    }):
        local_unlock(BATCH_KEY)
        return False
    return True


def batch_gate_release():
    ref_delete(BATCH_KEY)
    local_unlock(BATCH_KEY)


# Dấu hiệu "cây/môi trường hỏng", KHÔNG phải "test đỏ". Đều là lỗi ở tầng nạp
# file — không một assertion nào chạy được (#1468/B).
_BROKEN_GATE_SIGNS = (
    "no such file or directory",
    "could not open input file",
    "failed opening required",
    "class \"pest\\panic\" not found",
    "autoload.php",
    "command not found",
)


def looks_like_broken_gate(tmp: Path, blob: str) -> str | None:
    """Thất bại này là CỔNG HỎNG chứ không phải suite đỏ? Trả lý do, hoặc None.

    Trước #1468, hai loại được phân biệt bằng `fail_msg` truyền vào — tức bằng VỊ
    TRÍ gọi. Nên một lệnh suite chết vì `vendor/` biến mất giữa chừng vẫn bị dán
    nhãn "full suite ĐỎ", và người đọc đi tìm một test hỏng không tồn tại. Phân
    biệt phải theo TRIỆU CHỨNG.
    """
    if not tmp.exists():
        return "cây tạm biến mất giữa lúc chạy"
    low = blob.lower()
    for sign in _BROKEN_GATE_SIGNS:
        if sign in low:
            return f"lỗi nạp file, không phải assertion: {sign!r}"
    return None


def changed_go_modules(tmp: Path) -> list[str]:
    """Module Go mà LÔ NÀY chạm vào — không phải mọi module.

    Chỉ kiểm cái lô chạm tới, vì (a) cái không đổi thì `dev` đã chịu trách nhiệm
    rồi, và (b) đòi Go trên máy chạy cho một lô chỉ có backend là biến một cổng
    thành vật cản không liên quan.

    #2339 — HÀM NÀY TỪNG LUÔN TRẢ RỖNG, tức cổng #2156 im lặng tắt từ lúc gộp
    monorepo (#2306). `git diff --name-only` trả đường dẫn **FILE**, còn bản cũ
    lọc bằng `(tmp / path).is_dir()` — luôn False với file. Thời còn submodule
    nó chạy được vì diff trả đúng đường dẫn **thư mục** gitlink; in-tree thì
    không còn gitlink nào để trả.

    Nay quy mỗi file lên **thư mục tổ tiên gần nhất có `go.mod`**. Đó cũng là
    cách Go xác định module, nên cổng đi theo đúng ranh giới thật thay vì theo
    một tình cờ của định dạng diff.
    """
    out = run(["git", "diff", "--name-only", f"origin/{BASE_BRANCH}...HEAD"],
              cwd=str(tmp), check=False).stdout

    modules: set[str] = set()
    for line in out.splitlines():
        rel = line.strip()
        if not rel:
            continue
        # Đi ngược lên gốc cây tạm; dừng ở `go.mod` ĐẦU TIÊN gặp được — module
        # lồng nhau thì cái trong cùng mới là chủ sở hữu file.
        cur = (tmp / rel).parent
        while True:
            try:
                inside = cur.relative_to(tmp)
            except ValueError:
                break
            if (cur / "go.mod").exists():
                modules.add(str(inside))
                break
            if inside == Path("."):
                break
            cur = cur.parent

    return sorted(modules)


EMBED_DIRECTIVE_RE = re.compile(r"^\s*//go:embed\s+(.+?)\s*$", re.M)


def stub_missing_embed_dirs(root: Path) -> list[str]:
    """Dựng chỗ trống cho thư mục `//go:embed` là ARTIFACT BUILD, không nằm trong git.

    Không có bước này thì cổng #2156 **luôn đỏ** trên `workstation-app`, vĩnh viễn:

        frontend.go:8:12: pattern all:frontend/dist: no matching files found

    `frontend/dist` và `pos-web/dist` do `make` sinh ra và `.gitignore` loại — nên
    một cây vừa `git submodule update --init` (đúng trạng thái cổng chạy) KHÔNG có
    chúng, và `go:embed` hỏng ngay ở khâu BIÊN DỊCH chứ không phải lúc chạy.

    Repo con đã gặp và đã giải đúng cách này: `workstation-app/.github/workflows/
    ci.yml` (#1197) `mkdir -p frontend/dist` + ghi một file rác trước mọi lệnh Go.
    Cổng phải làm y hệt, nếu không nó báo mã 2 ("code hỏng") cho một artifact còn
    THIẾU — đúng kiểu lẫn CỔNG HỎNG với test đỏ mà #1329 đã trả giá.

    Vì sao dựng stub thay vì thu hẹp phạm vi xuống `./internal/...`: `frontend.go`
    và `posweb.go` nằm ở PACKAGE GỐC. Thu hẹp thì cổng không bao giờ biên dịch
    chính hai file ấy, mà chúng là chỗ đường phục vụ pos-web được nối vào — bỏ ra
    ngoài tầm nhìn là mở lại một lỗ khác ngay cạnh lỗ vừa bịt.

    Chỉ dựng cho pattern trỏ tới THƯ MỤC (không có phần mở rộng). Pattern trỏ tới
    một FILE mà thiếu thì để nó đỏ: đó là file đáng lẽ phải nằm trong git, tức lỗi
    thật, không phải artifact.

    Tên file rác KHÔNG bắt đầu bằng `.` hay `_` — `//go:embed dir` (không có tiền
    tố `all:`) bỏ qua đúng hai loại tên đó, nên một stub tên `.keep` sẽ không thoả
    và cổng vẫn đỏ.
    """
    created: list[str] = []
    for src in root.rglob("*.go"):
        parts = set(src.parts)
        if "vendor" in parts or "node_modules" in parts or "testdata" in parts:
            continue
        try:
            text = src.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in EMBED_DIRECTIVE_RE.findall(text):
            for pat in line.split():
                pat = pat.split(":", 1)[1] if pat.startswith("all:") else pat
                if any(ch in pat for ch in "*?[") or pat.startswith('"'):
                    continue
                target = (src.parent / pat)
                if Path(pat).suffix:          # trỏ tới FILE → không dựng, để đỏ thật
                    continue
                if target.is_dir() and any(target.iterdir()):
                    continue
                target.mkdir(parents=True, exist_ok=True)
                (target / "gate-stub.txt").write_text(
                    "stub do tal dung de #go:embed bien dich duoc (#2156/#1197)\n")
                created.append(str(target.relative_to(root)))
    return sorted(set(created))


def gate_go_modules(tmp: Path) -> None:
    """#2156 — submodule Go phải BIÊN DỊCH ĐƯỢC trên base mới, không chỉ merge sạch.

    `review-passed` + GitHub `mergeable_state=clean` + CI xanh **cùng lúc** vẫn có
    thể là một PR submodule không compile trên base hiện tại. Đã nổ thật: ws#239
    merge lúc `23:58:21Z`, và `dev` của workstation-app sau đó chết ở

        vet: internal/handler/split_by_items_golden_test.go:211:65:
             not enough arguments in call to computeByItemsPreviewBills

    Vì sao BỐN cổng đều nói xanh:

    - `mergeable_state` — PR THÊM FILE MỚI (`@@ -0,0`), nên không có xung đột VĂN
      BẢN nào. Xung đột nằm ở CHỮ KÝ HÀM, thứ git không đọc.
    - CI repo con — chạy lúc `12:35Z`; commit đổi chữ ký merge lúc `23:26Z`, **11
      tiếng SAU**. GitHub không tự chạy lại check khi base tiến lên (repo không bật
      "require branches up to date"), nên dấu xanh ấy nói về một base KHÔNG CÒN TỒN
      TẠI.
    - `fullSuite` — không có một lệnh Go nào; nó là pest của backend in-tree.
    - bảng gitlink — kiểm pointer FETCH ĐƯỢC, không kiểm nội dung.

    Chạy ở ĐÂY, ngay sau khi cây con đã đồng bộ về pointer vừa trộn, là chỗ rẻ nhất:
    cây đã có sẵn, không tốn thêm lần checkout nào. Và phải chạy trên CÂY ĐÃ TRỘN,
    không phải trên head của PR — đó chính là khác biệt giữa xanh và đỏ ở ws#239.

    `go build` một mình KHÔNG đủ: lỗi trên là ở FILE TEST, mà `build` bỏ qua file
    test. `vet` mới đọc chúng.
    """
    subs = changed_go_modules(tmp)
    if not subs:
        return

    if not shutil.which("go"):
        raise Fail(
            "CỔNG HỎNG — lô này chạm module Go (%s) nhưng máy chạy KHÔNG có `go`, "
            "nên không kiểm được nó có biên dịch trên base mới hay không.\n"
            "ĐÂY KHÔNG PHẢI TEST ĐỎ. Bỏ qua im lặng là đúng cái lỗ #2156 sinh ra để bịt: "
            "'chưa nhìn' KHÔNG phải 'sạch'. Cài Go rồi chạy lại." % ", ".join(subs),
            GATE_BROKEN,
        )

    for path in subs:
        print(f"cổng Go trên cây ĐÃ TRỘN: {path} (#2156)")
        stubbed = stub_missing_embed_dirs(tmp / path)
        if stubbed:
            print(f"  dựng stub cho artifact build thiếu (#1197): {', '.join(stubbed)}")
        run_stage(
            tmp / path,
            ["go build ./...", "go vet ./..."],
            f"{path} KHÔNG BIÊN DỊCH ĐƯỢC trên base vừa trộn — KHÔNG merge gì cả.\n"
            "Merge sạch + CI xanh + review đạt vẫn có thể là thế này: xung đột nằm ở "
            "CHỮ KÝ HÀM, không phải ở văn bản, và dấu xanh của CI nói về một base cũ hơn "
            "(#2156). Chủ PR phải merge base vào rồi chạy lại:",
            2,
        )


def run_stage(tmp: Path, cmds: list[str], fail_msg: str, code: int):
    """Chạy một dãy lệnh trong cây tạm, dừng ngay ở lệnh đầu tiên đỏ.

    `fail_msg` phân biệt hai loại thất bại — cổng không chạy được vs test thật sự đỏ.
    Gộp chung là cách #1329 sống sót nhiều ngày: cây thiếu `vendor/` báo y hệt một
    suite đỏ, nên không ai đọc ra là môi trường.

    Nhưng `fail_msg` là vị trí gọi, không phải triệu chứng — nên một lệnh SUITE
    chết vì môi trường vẫn ra nhãn sai. `looks_like_broken_gate` sửa đúng chỗ đó
    (#1468/B): triệu chứng thắng vị trí."""
    for c in cmds:
        print(f"  $ {c}")
        r = run(["bash", "-lc", c], cwd=str(tmp), check=False)
        blob = (r.stdout + r.stderr).strip()
        tail = "\n".join(blob.splitlines()[-15:])
        if r.returncode != 0:
            why = looks_like_broken_gate(tmp, blob)
            if why:
                # #2300 C3 — triệu chứng thắng vị trí gọi thì EXIT CODE cũng phải
                # thắng: hợp đồng #1329 là 3=cổng hỏng ≠ 2=test đỏ, mà nhánh này
                # từng hard-code 2 — automation phân nhánh theo mã đi tìm test
                # hỏng không tồn tại.
                raise Fail(
                    f"CỔNG HỎNG — {why}. KHÔNG phải test đỏ: không assertion nào chạy. "
                    f"Sửa môi trường rồi chạy lại, đừng đi tìm test hỏng.\n  $ {c}\n{tail}",
                    GATE_BROKEN,
                )
            raise Fail(f"{fail_msg}\n  $ {c}\n{tail}", code)
        print("    " + (tail.splitlines()[-1] if tail else "ok"))


def drop_batch_worktree(root, tmp) -> None:
    """Xoá cây tạm cho chắc — KHÔNG tin `git worktree remove`.

    `remove --force` từ chối trong đúng những ca cây tạm dễ hỏng nhất: submodule đã
    init BÊN TRONG nó, một `vendor/` untracked to, hay một lần Ctrl-C giữa
    `composer install`. `check=False` nuốt thất bại đó, và `prune` chỉ bỏ ĐĂNG KÝ
    worktree — nó không xoá thư mục còn sót. Lần chạy sau `worktree add` chết với
    `fatal: '…/_batch' already exists` và cổng đỏ **vĩnh viễn** cho tới khi có người
    `rm -rf` bằng tay, với một thông điệp không nói cho ai biết phải làm gì.

    Đúng lớp lỗi #1329 đang chữa: cổng không chạy được, nhưng báo ra như một thứ
    khác. Nên `rmtree` là bước bắt buộc giữa hai lệnh git, không phải cho chắc thêm.
    """
    run(["git", "worktree", "remove", "--force", str(tmp)], cwd=str(root), check=False)
    shutil.rmtree(tmp, ignore_errors=True)
    run(["git", "worktree", "prune"], cwd=str(root), check=False)


def cmd_merge_batch(a):
    """Gom LÔ: trộn mọi PR đã review đạt vào một cây tạm, chạy full suite MỘT lần,
    xanh thì merge cả lô.

    Vì sao gom: full suite chạy hàng chục phút. Chạy nó cho từng PR vừa chậm vừa tốn,
    và nó còn trả lời sai câu hỏi — điều cần biết trước khi đẩy vào base là "cả lô
    cùng nhau có xanh không", chứ không phải "từng PR đứng một mình có xanh không".
    Hai PR đều xanh riêng lẻ vẫn có thể đỏ khi nằm cạnh nhau.

    Cây tạm dùng detached HEAD, KHÔNG tạo branch — luật tên `issue-<số>` không có chỗ
    cho một branch tích hợp, và không cần có."""
    # #1454 — full suite THÔI chạy tự động. Chủ repo nói ba lần: chỉ test liên
    # quan; full suite chỉ khi được yêu cầu. Đo trong một phiên: nó chạy ít nhất
    # 6 lần, 9-10 phút mỗi lần, và bắt được đúng MỘT thứ mà test hẹp của cùng
    # thư mục cũng bắt được. Đổi lại nó khoá chết một cặp PR bù nhau (#1444 ↔
    # #1450) tới mức phải `--force` mới ra.
    #
    # Cây tạm VẪN dựng và VẪN trộn thật — đó mới là giá trị của merge-batch
    # (bắt conflict gitlink, chứng minh cả lô trộn được). Chỉ cái suite là opt-in.
    want_suite = getattr(a, "suite", False) and not a.skip_suite
    cmds = full_suite_cmds() if want_suite else []
    if want_suite and not cmds:
        raise Fail("chưa khai `fullSuite` trong .claude/agent-loop.json — không biết chạy gì "
                   "để chứng minh cả lô xanh. Khai nó, hoặc --skip-suite nếu người yêu cầu.", 2)
    # Không chạy suite thì không cần dựng gì cho nó: `--skip-suite` bỏ luôn
    # `setup`/`setupVerify`. `git submodule update --init` bên dưới thì VẪN chạy — đó là
    # điều kiện để git trộn được pointer submodule, không phải để chạy test.
    setup, verify = (setup_cmds(), setup_verify_cmds()) if cmds else ([], [])
    if cmds and not setup:
        warn("có `fullSuite` mà không khai `setup` — cây tạm không có vendor/node_modules/.env, "
             "cổng nhiều khả năng đỏ vì thiếu binary chứ không vì test (#1329)")

    prs = gh_json(["pr", "list", "-R", C.repo, "--state", "open", "--limit", "50",
                   "--json", "number,title,headRefName,isDraft,headRefOid"], default=[])
    lot = []
    for p in prs:
        if p["isDraft"] or not re.match(r"^issue-\d+$", p["headRefName"]):
            continue
        issue, why, _ev = merge_blockers(p["number"], require_ci=False)
        if why:
            # #2299 — "PR biến mất khỏi lô không lời giải thích" là cách rẻ nhất
            # để một PR bị bỏ quên nhiều lượt liền: nói ra, ngắn gọn.
            warn(f"PR #{p['number']}: bỏ khỏi lô — " + "; ".join(w[:90] for w in why[:2]))
            continue
        # #2300 C2 — bằng chứng verdict bắt Ở ĐÂY (trước realign): stage ⓪ sẽ push
        # commit căn pointer làm head đổi, tra lại theo head mới là mất bằng chứng
        # cho MỌI PR đa-repo dù suite đã xanh.
        # #2153 — PR đang có review lease SỐNG thì KHÔNG vào lô. Sự cố gốc: PR
        # merge lúc 14:18:38, verdict `changes` (blocking, ĐÚNG) rơi lúc 14:20:11
        # — muộn 93 giây, và điểm blocking nằm nguyên trên dev.
        #
        # #2874 — phép kiểm đã DỜI vào `merge_blockers` ở trên, nên nó khoá cả
        # bốn đường merge của tal chứ không riêng lô này; PR đang review bị loại
        # qua `why` ngay tại vòng lặp. Khối trùng ở đây đã gỡ: một luật hai chỗ
        # là cách chúng trôi khỏi nhau.
        lot.append({"pr": p["number"], "issue": issue, "sha": p["headRefOid"],
                    "branch": p["headRefName"], "title": p["title"], "verdict_ev": _ev})
    lot.sort(key=lambda x: x["pr"])
    if a.limit:
        lot = lot[: a.limit]

    if not lot:
        print("không có PR nào đã review đạt — lô rỗng, không chạy full suite")
        return {"lot": [], "verified": False}

    print(f"lô {len(lot)} PR: " + ", ".join(f"#{x['pr']}(←#{x['issue']})" for x in lot))
    if a.dry_run:
        return emit({"lot": lot, "verified": False, "dry_run": True}, a.json)

    # Khoá SAU khi biết lô không rỗng: không giữ cổng chỉ để in "lô rỗng".
    if not batch_gate_acquire():
        raise Fail(
            "session khác đang chạy cổng merge — KHÔNG phải lỗi, chỉ là đến lượt sau.\n"
            "  Cổng là bước tuần tự (lô sau phải thấy kết quả lô trước), nên chỉ một lô\n"
            "  chạy tại một thời điểm. Chạy lại khi nó xong.\n"
            f"  Chắc chắn session giữ cổng đã chết: `tal unlock {BATCH_KEY} --force`.",
            GATE_BUSY,
        )
    # #1617 — TỪ ĐÂY tới `try/finally` bên dưới là cửa sổ mà cổng ĐÃ giành nhưng
    # chưa ai chịu trách nhiệm nhả. `try/finally` hiện có không với tới được: `finally`
    # của nó gọi `drop_batch_worktree(root, tmp)`, mà `root`/`tmp` chỉ ra đời ở giữa
    # cửa sổ này — nên phải là một lớp bọc RIÊNG, không phải kéo `try:` lên.
    #
    # Trong cửa sổ có việc thật sự hay hỏng: `git worktree add` (không `check=False`)
    # với đăng ký worktree cũ còn sót — skill issue-work ghi rõ đó là chuyện xảy ra
    # thường xuyên. Rò ở ĐÂY nặng hơn ở `review-claim` (#1616): cổng là bước tuần tự
    # toàn repo, một khoá kẹt là MỌI session không merge được cho tới hết TTL.
    try:
        # ── ⓪ CỤM TRƯỚC KHI TRỘN ─────────────────────────────────────────────────
        #
        # Đây là chỗ ĐÚNG cho `merge_sub_prs`. Bản đầu (#1394) đặt nó trong `cmd_merge`,
        # tức chạy SAU khi cổng xanh — nhưng conflict gitlink nổ ở bước trộn lô, TRƯỚC
        # đó. Kết quả: mọi PR đa-repo bị bỏ khỏi lô ngay khi pointer của `dev` nhúc
        # nhích, và đường merge cụm không bao giờ được chạm tới. Đo được: 3/5 PR trong
        # một lô bị bỏ, dù các commit repo con không đụng nhau một dòng nào (#1435).
        #
        # Merge PR con TRƯỚC thì tip repo con chứa mọi phía, pointer được TÍNH LẠI từ
        # tip, và cái đem đi trộn không còn là hai sha đông cứng nữa. Thứ tính ra thì
        # không bao giờ conflict.
        #
        # Đánh đổi có chủ ý: PR con vào `dev` của repo con TRƯỚC khi full suite của lô
        # chạy. Chấp nhận được — PR con đã qua cổng review riêng, và "repo con đi trước
        # umbrella một nhịp" là hình dạng bình thường của mọi thay đổi đa repo (pointer
        # chậm hơn tip là hợp lệ, luật tổ tiên #1353). Đổi lại là PR đa-repo KHÔNG BAO
        # GIỜ qua nổi cổng — trạng thái trước bản vá này.
        for x in lot:
            try:
                subs = merge_sub_prs(x["issue"])
            except Fail as e:
                warn(f"PR #{x['pr']}: cụm repo con chưa xong — {e}")
                # #2300 C10 — chủ PR không đọc log session khác: hai nhánh loại-khỏi-lô
                # kia đều comment, nhánh này từng im lặng — PR nửa-merge (một PR con đã
                # vào, một PR con kẹt) bị bỏ lô nhiều lần mà không ai biết.
                gh(["pr", "comment", str(x["pr"]), "-R", C.repo, "-b",
                    f"**Bị bỏ khỏi lô merge** — cụm repo con chưa xong:\n\n```\n{e}\n```\n\n"
                    f"Không có gì hỏng ở review. Xử PR con trước rồi lô sau sẽ nhặt lại."],
                   check=False)
                x["group_failed"] = True
                continue
            if not subs:
                continue
            try:
                realign_pointers(x["issue"], x["branch"], subs)
            except Fail as e:
                # MỘT PR có pointer phân kỳ KHÔNG được giết cả lô. Đó là luật đã có ở
                # bước trộn ("bỏ PR conflict, các PR còn lại đi tiếp") — tôi quên áp
                # cho bước ⓪ khi thêm nó ở #1435, và một PR của session khác đã làm
                # đứng nguyên một lô 3 PR.
                warn(f"PR #{x['pr']}: pointer phân kỳ, BỎ khỏi lô này — {e}")
                gh(["pr", "comment", str(x["pr"]), "-R", C.repo, "-b",
                    f"**Bị bỏ khỏi lô merge** — pointer submodule **phân kỳ thật**, máy không "
                    f"giải hộ được.\n\n```\n{e}\n```\n\nKhông có gì hỏng ở review: PR vẫn giữ "
                    f"`agent:review-passed`. Cần người nhìn hai nhánh rồi quyết bên nào đúng, "
                    f"đặt lại pointer, push — lô sau sẽ nhặt lại."], check=False)
                x["group_failed"] = True
                continue
            # Pointer vừa đổi ⇒ sha đầu nhánh đã khác; lấy lại, nếu không sẽ trộn bản cũ.
            run(["git", "fetch", "-q", "origin", x["branch"]], cwd=str(C.main_worktree), check=False)
            fresh = run(["git", "rev-parse", f"origin/{x['branch']}"],
                        cwd=str(C.main_worktree), check=False).stdout.strip()
            if fresh:
                x["sha"] = fresh
        lot = [x for x in lot if not x.get("group_failed")]
        if not lot:
            raise Fail("mọi PR trong lô đều có cụm repo con chưa xong — không có gì để kiểm.", 2)

        root = C.main_worktree
        tmp = batch_tmp_dir()
        drop_batch_worktree(root, tmp)  # rác của LẦN CHẠY TRƯỚC CỦA CHÍNH SESSION NÀY
        run(["git", "fetch", "-q", "--prune", "origin"], cwd=str(root), check=False)
        tmp.parent.mkdir(parents=True, exist_ok=True)
        # detached: không sinh branch nào, nên không phạm luật tên
        run(["git", "worktree", "add", "--detach", str(tmp), f"origin/{BASE_BRANCH}"], cwd=str(root))
        # Chứng minh sự sống, đọc được từ MỘT SESSION KHÁC (#1468/A). Không có nó thì
        # `reap_batch_gate` chỉ biết "cây này không phải của tôi" và xoá — giữa lúc
        # full suite của người ta đang chạy.
        batch_mark_alive(tmp)
        exclude_lease(tmp)
    except BaseException:
        # BaseException, không phải Exception: KeyboardInterrupt / SystemExit cũng phải
        # nhả cổng — Ctrl-C giữa lô là cách dễ nhất để kẹt nó.
        batch_gate_release()
        raise
    try:
        if (tmp / ".gitmodules").exists():
            # Submodule chưa checkout thì git TỪ CHỐI trộn chính cái pointer của nó
            # ("Failed to merge submodule admin-web (not checked out)") và báo ra thành
            # CONFLICT — dù nhánh không hề xung đột. Đó là lần đỏ thứ hai của cùng một
            # nguyên nhân gốc ở #1329: cây tạm chưa được dựng. ~13s, so với cả suite là
            # không đáng kể. Cái gì suite cần (pnpm install…) thì khai ở `setup`, không ở đây.
            print("init submodule trong cây tạm — git cần chúng để trộn được pointer")
            run_stage(tmp, ["git submodule update --init"],
                      "CỔNG HỎNG — không init được submodule trong cây tạm. "
                      "ĐÂY KHÔNG PHẢI TEST ĐỎ: chưa trộn PR nào:", GATE_BROKEN)
        # Conflict là chuyện RIÊNG của một PR (nhánh nó đứng sau base, hoặc pointer
        # submodule đã rẽ) — không phải chuyện của cả lô. Bỏ PR đó ra rồi đi tiếp, thay vì
        # để một PR cũ giữ con tin toàn bộ hàng đợi. `merge_blockers` có lọc
        # mergeable=CONFLICTING, nhưng GitHub tính trường đó bất đồng bộ: lúc hỏi thường
        # còn UNKNOWN, nên lần trộn tại chỗ này mới là câu trả lời chắc chắn.
        dropped = []
        keep = []
        for x in lot:
            m = run(["git", "merge", "--no-edit", x["sha"]], cwd=str(tmp), check=False)
            if m.returncode != 0:
                run(["git", "merge", "--abort"], cwd=str(tmp), check=False)
                dropped.append(x)
                detail = "\n".join((m.stdout + m.stderr).strip().splitlines()[:6])
                warn(f"PR #{x['pr']} conflict với {BASE_BRANCH} — BỎ khỏi lô này (các PR còn lại "
                     f"vẫn đi tiếp). Merge {BASE_BRANCH} vào nhánh đó, giải conflict, rồi chạy lại:\n"
                     + detail)
                # Chủ PR không đọc log của session khác: một PR bị bỏ im lặng nhiều lần
                # trông y như bị bỏ quên. Comment là đường duy nhất tới đúng người.
                # check=False — không comment được thì vẫn tiếp tục lô, đây không phải money path.
                gh(["pr", "comment", str(x["pr"]), "-R", C.repo, "-b",
                    f"**Bị bỏ khỏi lô merge** — nhánh này conflict với `{BASE_BRANCH}`, nên "
                    f"`tal merge-batch` bỏ nó ra và các PR còn lại trong lô vẫn đi tiếp.\n\n"
                    f"Không có gì hỏng ở review: PR vẫn giữ `agent:review-passed`. Cần "
                    f"`git merge origin/{BASE_BRANCH}` vào nhánh, giải conflict, push — lô sau "
                    f"sẽ nhặt lại.\n\n```\n" + detail + "\n```"], check=False)
                continue
            keep.append(x)
        lot = keep
        if not lot:
            raise Fail(f"mọi PR trong lô đều conflict với {BASE_BRANCH} — không có gì để kiểm. "
                       "Cập nhật các nhánh đó trước.", 2)
        print(f"đã trộn {len(lot)} PR lên origin/{BASE_BRANCH} trong cây tạm"
              + (f" (bỏ {len(dropped)} PR conflict)" if dropped else ""))
        if (tmp / ".gitmodules").exists():
            # Lần init thứ HAI, và nó không thừa. `git merge` sửa INDEX của gitlink
            # nhưng KHÔNG move cây làm việc của submodule — kể cả ca nó tự giải
            # ("Note: Fast-forwarding submodule …"). Đo trên fixture: index 9f0c665,
            # `git -C sub rev-parse HEAD` c600f69, `git status` " M sub", và file
            # trong sub/ vẫn là nội dung cũ.
            #
            # Bỏ bước này thì `setup` → `setupVerify` → `fullSuite` chạy trên nội dung
            # submodule KHÁC với cái lô sắp merge. Hôm nay chưa cắn vì `fullSuite` chỉ
            # có backend pest (in-tree), nhưng `//setup` hướng dẫn thêm lệnh app web —
            # ngày ai đó làm theo, cổng bắt đầu test code cũ mà vẫn xanh. Cổng xanh vì
            # nó ngừng kiểm là kiểu hỏng tệ nhất một cổng có thể có (#1400).
            print("đồng bộ submodule về pointer vừa trộn — merge chỉ sửa index, không move cây con")
            run_stage(tmp, ["git submodule update --init"],
                      "CỔNG HỎNG — không đồng bộ được submodule về pointer vừa trộn. "
                      "ĐÂY KHÔNG PHẢI TEST ĐỎ: chưa test nào được chạy:", GATE_BROKEN)
            gate_go_modules(tmp)
        if setup:
            # Dựng SAU khi trộn, cố ý: lô có thể đổi composer.lock / lockfile của app web,
            # và cổng phải cài đúng bản mà lô khai — không phải bản đang có ở cây chính.
            print(f"dựng môi trường trong cây tạm ({len(setup)} bước) — worktree mới không có "
                  "vendor/node_modules/.env")
            run_stage(tmp, setup, "CỔNG HỎNG — không dựng được môi trường trong cây tạm. "
                                  "ĐÂY KHÔNG PHẢI TEST ĐỎ: chưa test nào được chạy. Sửa `setup` trong "
                                  ".claude/agent-loop.json (hoặc môi trường máy chạy), rồi chạy lại:",
                      GATE_BROKEN)
        run_stage(tmp, verify, "CỔNG HỎNG — môi trường dựng xong mà `setupVerify` vẫn trượt. "
                               "ĐÂY KHÔNG PHẢI TEST ĐỎ. Thường là `fullSuite` vừa được thêm lệnh mới "
                               "mà `setup` chưa theo:", GATE_BROKEN)
        if cmds:
            print("chạy full suite MỘT lần cho cả lô")
            run_stage(tmp, cmds, "full suite ĐỎ trên lô — KHÔNG merge gì cả:", 2)

        # Merge NẰM TRONG cổng, không nằm ngoài: nhả khoá trước khi merge xong thì lô
        # sau có thể bắt đầu trộn trên một base đang đổi dở giữa chừng.
        if a.gate_only:
            print("\ncổng XANH cho cả lô — dừng ở đây theo --gate-only, KHÔNG merge gì")
            return emit({"lot": lot, "dropped": dropped, "verified": True, "merged": [],
                         "gate_only": True}, a.json)

        print("\nfull suite XANH cho cả lô — merge lần lượt")
        merged, failed = [], []
        for x in lot:
            # #2300 D10 — tách vai áp cho TỪNG PR trong lô: đường batch từng miễn
            # hẳn rào, coder chạy merge-batch là tự merge PR mình không dấu vết.
            # Vi phạm ⇒ bỏ PR đó khỏi lô (kèm comment), không giết cả lô.
            try:
                led_x, _, _ = ledger_read(x["issue"])
                assert_not_own_work(led_x, x["pr"], "merge (qua merge-batch)", False, "--self")
            except Fail as e:
                warn(f"PR #{x['pr']}: {e}")
                gh(["pr", "comment", str(x["pr"]), "-R", C.repo, "-b",
                    f"**Bị bỏ khỏi lô merge — tách vai.** Session chạy `merge-batch` là session "
                    f"đã code PR này; để session/người khác merge (`tal merge {x['pr']}` với "
                    f"`--self --note` nếu buộc phải)."], check=False)
                failed.append({"pr": x["pr"], "why": "own-work"})
                continue
            # #2300 C2 — một PR merge hỏng không được nuốt phần còn lại của lô:
            # trước đây Fail nổ giữa vòng lặp không try, PR trước đã merge còn PR
            # sau (đã verify xong) mất trắng, không ai dọn.
            try:
                r = cmd_merge(argparse.Namespace(pr=x["pr"], force=False, no_subs=False,
                                                 self_merge=False, note=None, require_ci=False,
                                                 batch_verified=True, json=False,
                                                 # #2639/#2669 — lô KHÔNG tự tha CI đỏ,
                                                 # cũng không tự tha CI còn đang chạy.
                                                 ci_red=False,
                                                 verdict_ev=x.get("verdict_ev")))
                merged.append(r)
            except Fail as e:
                warn(f"PR #{x['pr']}: merge hỏng giữa lô — {e}")
                gh(["pr", "comment", str(x["pr"]), "-R", C.repo, "-b",
                    f"**Merge hỏng giữa lô** (các PR khác trong lô vẫn đi tiếp):\n\n```\n{e}\n```"],
                   check=False)
                failed.append({"pr": x["pr"], "why": str(e)[:200]})
        if dropped:
            print("còn lại (conflict, chưa merge): " + ", ".join(f"#{x['pr']}" for x in dropped))
        if failed:
            print("merge hỏng giữa lô: " + ", ".join(f"#{x['pr']}" for x in failed))
        return {"lot": lot, "dropped": dropped, "verified": True, "merged": merged, "failed": failed}
    finally:
        drop_batch_worktree(root, tmp)
        batch_gate_release()


