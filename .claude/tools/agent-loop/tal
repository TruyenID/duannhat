# Vùng file (#2270) — advisory-at-claim, KHÔNG phải khoá riêng
#
# Lease khoá theo ISSUE. Hai session điều phối nhận HAI issue khác nhau nhưng
# sửa CÙNG file thì không gì chặn — 2026-08-08 đã suýt tai nạn kiểu đó. Vùng
# file vá đúng khe ấy, và cố ý vá ở mức rẻ nhất còn hữu ích: đối chiếu MỘT LẦN
# lúc claim, chứ không canh từng thao tác ghi.
#
# Vùng KHÔNG có vòng đời riêng: nó nằm trong `led["lease"]["regions"]`, tức là
# sống/chết theo đúng lease đang chứa nó. Lease hết TTL, bị `gc` thu hồi, hay
# `release` xoá sổ ⇒ vùng tự nhả, không cần dọn thêm ở đâu cả. Một danh sách
# vùng riêng thì sẽ có trạng thái riêng, và trạng thái riêng thì sẽ rò — đúng
# cái mà lease-bằng-label đã dạy (4 issue dính `status:executing` mồ côi).
#
# Payload ref KHÔNG đổi: ref vẫn chỉ là một SHA, và mọi session đang chạy đọc
# lease từ sổ như cũ. Lease cũ không có khoá `regions` ⇒ `.get()` ra rỗng ⇒
# không giữ vùng nào ⇒ không chặn ai.
# ─────────────────────────────────────────────────────────────────────────────


def norm_region(p: str) -> str:
    """`./backend/app/` → `backend/app`. Chuẩn hoá TRƯỚC khi so, không phải khi in."""
    parts = [x for x in (p or "").strip().replace("\\", "/").split("/") if x not in ("", ".")]
    if not parts:
        raise Fail(f"--region rỗng/không hợp lệ: {p!r}", 2)
    if ".." in parts:
        raise Fail(f"--region không nhận `..`: {p!r} — hãy khai đường dẫn từ gốc repo", 2)
    return "/".join(parts)


def regions_overlap(a: str, b: str) -> bool:
    """Chồng lấn = một bên là tiền tố của bên kia THEO THÀNH PHẦN đường dẫn.

    `backend/app` chồng `backend/app/Services` (cha chứa con), nhưng KHÔNG chồng
    `backend/app2` — và đó chính là chỗ so chuỗi thô sai: `"backend/app2"
    .startswith("backend/app")` là True, nên một session xin `backend/app2` sẽ bị
    một session giữ `backend/app` chặn oan. Chặn oan ở đây không vô hại: nó dạy
    người vận hành gõ `--force` theo phản xạ, và lúc đó rào mất tác dụng thật.
    """
    x, y = norm_region(a).split("/"), norm_region(b).split("/")
    n = min(len(x), len(y))
    return x[:n] == y[:n]


def live_region_holders(exclude: set[int] | None = None) -> list[dict]:
    """Mọi lease SỐNG có khai vùng. Đi đúng đường sống/chết sẵn có của lease."""
    out: list[dict] = []
    for key in refs_all():
        m = re.match(r"^issue-(\d+)$", key)
        if not m:
            continue                      # `pr-*` (lease review) và `merge-batch` không giữ vùng
        issue = int(m.group(1))
        if exclude and issue in exclude:
            continue
        led, _, upd = ledger_read(issue)
        lease = led.get("lease") or {}
        regions = list(lease.get("regions") or [])
        if not regions or lease_expired(led, upd):
            continue
        left = ((upd + timedelta(seconds=lease.get("ttl", TTL))) - now()).total_seconds()
        out.append({"issue": issue, "session": lease.get("session") or "?",
                    "host": lease.get("host"), "regions": regions,
                    "expires_in": human_delta(left)})
    return out


def region_conflicts(want: list[str], exclude: set[int] | None = None) -> list[dict]:
    """Đối chiếu HAI CHIỀU: xin cha mà người ta giữ con cũng là chồng, và ngược lại."""
    if not want:
        return []                         # không khai vùng = không giữ vùng, không chặn ai
    hits = []
    for h in live_region_holders(exclude):
        pairs = [(w, r) for w in want for r in h["regions"] if regions_overlap(w, r)]
        if pairs:
            hits.append({**h, "pairs": pairs})
    return hits


def guard_regions(want: list[str], exclude: set[int] | None = None,
                  force: bool = False) -> list[str]:
    """→ danh sách vùng đã chuẩn hoá để ghi vào lease. Chồng lấn ⇒ Fail(BUSY)."""
    regions: list[str] = []
    for r in want or []:
        n = norm_region(r)
        if n not in regions:
            regions.append(n)
    hits = region_conflicts(regions, exclude)
    if not hits:
        return regions
    lines = []
    for h in hits:
        why = ", ".join(f"`{w}` ⇄ `{r}`" for w, r in h["pairs"])
        lines.append(f"       #{h['issue']} · session {h['session'][:8]}… · giữ "
                     f"{', '.join(h['regions'])} · còn {h['expires_in']} · chồng: {why}")
    body = "\n".join(lines)
    if force:
        warn("⚠️  --force: VƯỢT rào vùng file. Session khác đang giữ vùng chồng lấn:\n"
             + body + "\n       Hai session cùng ghi một vùng thì người sau đè người trước.")
        return regions
    raise Fail("vùng file đang có người giữ:\n" + body +
               "\n       Chờ lease kia hết hạn/nhả, thu hẹp --region, hoặc --force nếu "
               "người yêu cầu (chấp nhận rủi ro đè nhau).", BUSY)


