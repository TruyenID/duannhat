WRITE_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
# `gh` nói chung ghi lên GitHub, không ghi cây làm việc (#1472). Chỉ ba lệnh dưới
# thật sự có đích ghi cục bộ; bash_write_targets() sẽ quy chúng về đường dẫn trước
# khi hỏi lease, giống nhánh Edit/Write thay vì phán theo CWD (#2360).
# …TRỪ vài lệnh con của `gh` thật sự ghi vào cây làm việc. Đây mới là thứ đáng
# chặn, và chặn đúng chúng thì phần còn lại của `gh` được tự do.
GH_WRITES_TREE_RE = re.compile(r"\bgh\s+(pr\s+checkout|repo\s+(clone|sync))\b")
# Lối thoát luôn mở: chính thông điệp deny bảo chạy `tal claim`, nên nó không
# được chặn. Nhận diện `tal` LÀ `tal` thay vì liệt kê từng lệnh con (#1528).
#
# Bản cũ liệt kê tên: claim|queue|status|…|merge. Mỗi lệnh mới thêm vào `tal` là
# một lần phải nhớ sửa regex, và quên thì rào chặn chính công cụ của mình —
# `tal pr-merge` (#1524) dính ngay hôm nó ra đời, cùng với `merge-batch`,
# `merge-queue`, `review-claim`, `review-verdict`, `submodule-pr`,
# `submodule-check`: bảy lệnh, không lệnh nào ghi vào worktree của người khác.
#
# Vì sao miễn cả họ là an toàn: mọi lệnh con của `tal` đã có rào RIÊNG bên trong
# — `assert` kiểm lease, cổng review kiểm nhãn, cổng con trỏ kiểm submodule. Rào
# CWD ở ngoài không thêm an toàn nào, chỉ thêm ma sát. Thứ thật sự ghi vào đĩa
# (`git`, `rm`, `sed`, `composer`, redirect…) vẫn bị chặn nguyên như cũ.
TAL_RE = re.compile(r"(^|[;&|]\s*)(\S*/)?tal\b")
PUSH_RE = re.compile(r"\bgit\s+push\b|\bgh\s+pr\s+create\b")
DANGER_RE = re.compile(r"\bgit\s+push\b.*\b(origin\s+)?(dev|main)\b")
# Mọi cách tạo branch — chặn ngay từ dòng lệnh, kể cả trong submodule (`git -C sub …`).
NEWBRANCH_RE = [
    re.compile(r"\bgit\s+(?:-C\s+\S+\s+)*(?:checkout|switch)\s+(?:-b|-B|-c|-C)\s+(\S+)"),
    re.compile(r"\bgit\s+(?:-C\s+\S+\s+)*branch\s+(?!-[dDmMrlva]|--)(\S+)"),
    re.compile(r"\bgit\s+(?:-C\s+\S+\s+)*worktree\s+add\s+(?:.*?\s)?-[bB]\s+(\S+)"),
    re.compile(r"\bgit\s+(?:-C\s+\S+\s+)*push\s+\S+\s+\S+:(?:refs/heads/)?(\S+)"),
]

GIT_READ_ONLY = {
    "status", "log", "diff", "show", "fetch", "rev-parse", "merge-base",
    "ls-files", "ls-remote", "describe", "blame", "cat-file", "for-each-ref",
}


def _shell_path(raw: str, cwd: Path) -> Path | None:
    """Resolve a literal shell path; dynamic expressions deliberately fail open."""
    if not raw or raw in {"-", "/dev/null"} or any(c in raw for c in "$`*?[]{}"):
        return None
    p = Path(os.path.expanduser(raw))
    return (p if p.is_absolute() else cwd / p).resolve()


def _git_is_read_only(args: list[str]) -> bool:
    """Classify only the explicitly safe git surface; unknown subcommands write."""
    i = 1
    while i < len(args):
        if args[i] == "-C" and i + 1 < len(args):
            i += 2
        elif args[i].startswith("-"):
            i += 1
        else:
            break
    if i >= len(args):
        return True
    sub, rest = args[i], args[i + 1:]
    if sub in GIT_READ_ONLY:
        return True
    if sub == "remote":
        return not rest or rest[0] in {"-v", "--verbose", "get-url"}
    if sub == "branch":
        return any(x in rest for x in ("--list", "--show-current", "-a", "-r"))
    if sub == "worktree":
        return bool(rest and rest[0] == "list")
    if sub == "stash":
        return bool(rest and rest[0] == "list")
    if sub == "config":
        return any(x == "--get" or x.startswith("--get-") for x in rest)
    return False


def bash_write_targets(command: str, initial_cwd: str | Path) -> list[Path]:
    """Best-effort literal destinations written by a shell command.

    The lease protects paths, not command names or the shell's current directory.
    Unknown/dynamic syntax remains fail-open by design; later fencing still guards
    commits and pushes.
    """
    cwd = Path(initial_cwd).resolve()
    targets: list[Path] = []
    for segment in re.split(r"&&|\|\||[;&|]", command):
        segment = segment.strip()
        if not segment or TAL_RE.search(segment):
            continue
        try:
            args = shlex.split(segment, posix=True)
        except ValueError:
            continue
        if not args:
            continue

        # Keep track of the effective directory across simple command chains.
        if args[0] == "cd" and len(args) >= 2:
            nxt = _shell_path(args[1], cwd)
            if nxt is not None:
                cwd = nxt
            continue

        # stdout redirection writes its destination. stderr redirection and fd
        # duplication (`2>/dev/null`, `2>&1`) do not write the worktree.
        for m in re.finditer(r"(?<!\d)(?:1)?>>?\s*([^\s;&|]+)", segment):
            p = _shell_path(m.group(1).strip("'\""), cwd)
            if p is not None:
                targets.append(p)

        cmd = Path(args[0]).name
        plain = [a for a in args[1:] if not re.match(r"^(?:[012])?>", a)]
        if cmd == "git":
            git_cwd = cwd
            for i, arg in enumerate(args[:-1]):
                if arg == "-C":
                    p = _shell_path(args[i + 1], cwd)
                    if p is not None:
                        git_cwd = p
            if not _git_is_read_only(args):
                targets.append(git_cwd)
        elif cmd in {"sed", "perl"}:
            if any(a == "-i" or a.startswith("-i") for a in plain):
                vals = [a for a in plain if a and not a.startswith("-")]
                # Script thay thế đứng trước; toán hạng cuối là file trong những
                # dạng `sed/perl -i ... file` mà hook nhận diện có chủ ý.
                if len(vals) >= 2 and (p := _shell_path(vals[-1], cwd)) is not None:
                    targets.append(p)
        elif cmd in {"rm", "touch", "mkdir", "tee"}:
            for raw in plain:
                if not raw.startswith("-") and (p := _shell_path(raw, cwd)) is not None:
                    targets.append(p)
        elif cmd in {"cp", "mv"}:
            vals = [a for a in plain if not a.startswith("-")]
            if vals and (p := _shell_path(vals[-1], cwd)) is not None:
                targets.append(p)
        elif cmd in {"npm", "pnpm", "yarn", "composer", "go", "make", "php"}:
            targets.append(cwd)
        elif GH_WRITES_TREE_RE.search(segment):
            targets.append(cwd)

        # Common literal writes from otherwise unknown interpreters. This keeps
        # the intentional fail-open policy while catching the concrete bypasses
        # that motivated #2360.
        literal_patterns = {
            "python3": r"\bopen\(\s*['\"]([^'\"]+)['\"]\s*,\s*['\"][wax+]",
            "python": r"\bopen\(\s*['\"]([^'\"]+)['\"]\s*,\s*['\"][wax+]",
            "node": r"\b(?:writeFileSync|appendFileSync)\(\s*['\"]([^'\"]+)['\"]",
            "ruby": r"\bFile\.write\(\s*['\"]([^'\"]+)['\"]",
        }
        if cmd in literal_patterns:
            for raw in re.findall(literal_patterns[cmd], segment):
                if (p := _shell_path(raw, cwd)) is not None:
                    targets.append(p)
    return targets


def cmd_hook_guard(a):
    try:
        payload = json.load(sys.stdin)
    except Exception as e:
        print(f"[tal] hook-guard bỏ qua payload không hợp lệ: {e}", file=sys.stderr)
        sys.exit(0)
    tool = payload.get("tool_name", "")
    ti = payload.get("tool_input", {}) or {}
    sid = payload.get("session_id") or ""
    cwd = payload.get("cwd") or os.getcwd()

    target = ti.get("file_path") or ti.get("notebook_path") or cwd

    def target_lease(path: str | Path):
        p = Path(path)
        try:
            # lease_file tự leo cha, nên một file chưa tồn tại vẫn quy đúng worktree.
            return lease_file(p if p.is_dir() else p.parent, search=False)
        except Exception:
            return None

    context = target_lease(cwd)
    if tool == "Bash":
        guarded = [x for p in bash_write_targets(ti.get("command", ""), cwd)
                   if (x := target_lease(p)) is not None]
    else:
        hit = target_lease(target)
        guarded = [hit] if hit is not None else []

    # Không có đích ghi nào nằm trong worktree có lease: hook không can thiệp.
    # Riêng rào mẫu lệnh Bash bên dưới vẫn cần context của CWD nếu có.
    if not guarded and not (tool == "Bash" and context is not None):
        sys.exit(0)

    def deny(reason: str):
        print(json.dumps({
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        }))
        sys.exit(0)

    # Với Bash, `target` là CWD — mà đứng ở đâu không phải bằng chứng đang ghi cái gì.
    # Chặn theo cwd thì `pwd`, `cd ..`, `ls`, và cả `tal claim` mà chính thông điệp
    # mách đều bị chặn ⇒ session bị NHỐT, không còn lệnh nào chạy được để tự gỡ.
    # Đã xảy ra thật. Nên hai rào lease dưới đây chỉ áp cho lệnh THỰC SỰ ghi; còn
    # rào theo mẫu lệnh (đặt tên branch, push dev/main, push không lease) vẫn áp cho
    # mọi lệnh Bash như cũ — chúng vốn đã xét nội dung lệnh, không xét chỗ đứng.
    for _, lf in guarded:
        if lf.get("released"):
            deny(
                f"[tal] Worktree này (issue #{lf['issue']}) đã NHẢ LEASE lúc "
                f"{lf.get('released_at','?')} — nó được giữ lại chỉ để dùng cho vòng sửa sau. "
                f"Ghi vào đây bây giờ là ghi ra ngoài mọi rào. Chạy `tal claim {lf['issue']}` "
                "để nhận lại, hoặc `tal queue` chọn issue khác."
            )
        if sid and lf.get("session") and sid != lf["session"]:
            deny(
                f"[tal] Worktree này thuộc issue #{lf['issue']}, do session {lf['session'][:8]}… giữ lease. "
                f"Session của bạn ({sid[:8]}…) KHÔNG được sửa ở đây. Chạy `tal queue` rồi `tal claim` "
                "một issue khác, hoặc `tal status` xem ai đang giữ."
            )

    if tool == "Bash":
        if context is None:
            sys.exit(0)
        _, lf = context
        cmdline = ti.get("command", "")
        for rx in NEWBRANCH_RE:
            for name in rx.findall(cmdline):
                nm = name.strip("'\"")
                if not BRANCH_RE.match(nm):
                    deny(
                        f"[tal] Cấm đặt tên branch {nm!r}. Branch và worktree chỉ được là "
                        f"`issue-<số>` — ở umbrella VÀ ở mọi submodule, không ngoại lệ. "
                        f"Issue đang làm là #{lf['issue']} → dùng `issue-{lf['issue']}` "
                        f"(`tal submodule <path>` tự tạo đúng tên). Cần một nhánh riêng nữa thì "
                        "mở sub-issue rồi `tal claim <sub> --split`."
                    )
        if DANGER_RE.search(cmdline):
            deny(f"[tal] Không push thẳng vào dev/main từ worktree issue #{lf['issue']}. "
                 f"Dùng `tal pr` để mở PR vào {BASE_BRANCH}.")
        if PUSH_RE.search(cmdline):
            try:
                do_assert(quiet=True)
            except Fail as e:
                deny(f"[tal] Chặn ghi ra remote: {e}")
    sys.exit(0)


