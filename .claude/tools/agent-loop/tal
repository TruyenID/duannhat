_AGENT_SESSION_VARS = ("CODEX_THREAD_ID", "CLAUDE_CODE_SESSION_ID")
_SESSION_OVERRIDE_VAR = "TAL_SESSION"


# ── Địa chỉ nhắn tin của phiên giữ lease (#2704) ─────────────────────────────
#
# `tal status` in digest phiên (`379869a2…`), còn thứ gửi tin được lại là
# `uds:/tmp/cc-socks/<PID>.sock` — HAI không gian định danh rời nhau, không bảng
# tra nào ở giữa. Hệ quả đo được: một session bị chặn claim vì chồng vùng phải
# RẢI tin cho từng phiên đang bận để dò đúng người, và hỏi trúng cả phiên vô can.
#
# Cầu nối là PID của tiến trình `claude`/`codex` CHA. Lưu ý field `pid` sẵn có
# KHÔNG dùng được: nó là `os.getpid()` của chính tiến trình python `tal`, sống
# vài giây rồi chết, nên nó không bao giờ khớp một socket.
_AGENT_PROCS = ("claude", "codex")
_SOCK_DIR = Path("/tmp/cc-socks")


def agent_pid() -> int | None:
    """PID của tiến trình agent CHA gần nhất, hoặc None nếu không tìm ra.

    Đi ngược cây cha; trên máy đo được thì mất đúng 2 chặng
    (python ← zsh ← claude). Giới hạn số chặng để một cây lạ không làm treo.
    """
    pid = os.getpid()
    for _ in range(12):
        try:
            out = subprocess.run(
                ["ps", "-p", str(pid), "-o", "ppid=,comm="],
                capture_output=True, text=True, timeout=5,
            ).stdout.split()
        except (OSError, subprocess.SubprocessError):
            return None
        if not out:
            return None
        ppid, comm = out[0], " ".join(out[1:])
        # `comm` có thể là đường dẫn đầy đủ; so trên phần tên cuối.
        if Path(comm).name in _AGENT_PROCS:
            return pid
        try:
            nxt = int(ppid)
        except ValueError:
            return None
        if nxt <= 1 or nxt == pid:
            return None
        pid = nxt
    return None


def agent_addr(lease: dict) -> str:
    """Địa chỉ nhắn tin để in trong bảng, hoặc lý do không có.

    PID chỉ có nghĩa TRÊN CÙNG MÁY. Một lease từ máy khác mang PID trùng số với
    một tiến trình ở đây sẽ cho ra một địa chỉ trông sống mà gửi vào hư không —
    nên đối chiếu `host` TRƯỚC, và nói thẳng khi không kiểm được.
    """
    pid = lease.get("agent_pid")
    if not pid:
        return "—"
    host = lease.get("host")
    if host and host != socket.gethostname():
        return f"pid {pid}@{host}"
    sock = _SOCK_DIR / f"{pid}.sock"
    # Socket còn hay mất là chuyện PHẢI nói ra. In một đường dẫn đã chết y như
    # một đường dẫn sống chỉ đổi kiểu mơ hồ này lấy kiểu mơ hồ khác — cùng họ với
    # bẫy `session ?` (lease sống và lease mồ côi in giống hệt nhau).
    return f"uds:{sock}" if sock.exists() else f"(pid {pid} đã tắt)"


def session_identity() -> tuple[str, str]:
    """(danh tính, nguồn). Nguồn để `doctor` nói thẳng nó đến từ đâu."""
    override = os.environ.get(_SESSION_OVERRIDE_VAR)
    if override:
        return override, _SESSION_OVERRIDE_VAR
    present = [(v, os.environ[v]) for v in _AGENT_SESSION_VARS if os.environ.get(v)]
    if len(present) == 1:
        return present[0][1], present[0][0]
    if present:
        raw = "|".join(f"{v}={val}" for v, val in sorted(present))
        # Băm ĐỨNG TRƯỚC hậu tố: mọi chỗ hiển thị cắt [:8], nên tiền tố cố định
        # sẽ ăn hết ký tự phân biệt — đúng lỗi #2300 mà fallback dưới đã trả giá.
        digest = hashlib.sha256(raw.encode()).hexdigest()[:12]
        return f"{digest}-nested", "+".join(v for v, _ in sorted(present))
    # #2300 — fallback cũ `shell-<host>-<ppid>` bị mọi chỗ hiển thị cắt [:8] thành
    # `shell-` + 2 ký tự hostname: hai người trên cùng máy TRÙNG danh tính, chặn
    # review oan lẫn nhau. Băm để 12 ký tự ĐẦU đã phân biệt.
    raw = f"{socket.gethostname()}-{os.getppid()}"
    return "shell" + hashlib.sha256(raw.encode()).hexdigest()[:11], ""


def session_id() -> str:
    return session_identity()[0]


# ─────────────────────────────────────────────────────────────────────────────
# Ledger — sổ trạng thái, sống trong MỘT comment trên issue
#
# `updated_at` của comment là đồng hồ SERVER, nên nó là căn cứ duy nhất để nói
# lease còn sống hay đã chết. Máy giữ lease không tự khai được là mình còn sống.
# ─────────────────────────────────────────────────────────────────────────────

FENCE = re.compile(r"```json\s*\n(.*?)\n```", re.S)


def _sanitize(s: str) -> str:
    return s.replace("-->", "--&gt;").replace("```", "'''")


def ledger_new(issue: int) -> dict:
    return {
        "version": 1,
        "issue": issue,
        "group": [issue],
        "branch": f"issue-{issue}",
        "state": "queued",
        "epoch": 0,
        "attempts": 0,
        "review_rounds": 0,
        "reaps": 0,
        "pr": None,
        "sub_prs": {},
        "lease": None,
        "heartbeat": None,
        "history": [],
    }


def ledger_read(issue: int) -> tuple[dict, int | None, datetime | None]:
    """→ (data, comment_id, comment_updated_at). Không có sổ thì trả sổ trắng.

    #2300 — "không đọc được" phải KHÁC "không có sổ": trước đây API hỏng một nhịp
    là claim thấy sổ trắng, POST một ledger comment THỨ HAI với epoch=1, và từ đó
    mọi lượt đọc trả về sổ CŨ — fencing token mất đơn điệu, `tal assert` của chính
    người vừa claim tự báo mất lease. Giờ API hỏng ⇒ raise."""
    comments = gh_json_strict(
        ["api", f"repos/{C.repo}/issues/{issue}/comments", "--paginate"],
        what=f"sổ ledger của #{issue}",
    )
    for c in comments:
        if LEDGER_MARKER in (c.get("body") or ""):
            m = FENCE.search(c["body"])
            if not m:
                continue
            try:
                data = json.loads(m.group(1))
            except json.JSONDecodeError:
                continue
            return data, c["id"], parse_iso(c["updated_at"])
    return ledger_new(issue), None, None


def ledger_render(d: dict) -> str:
    lease = d.get("lease")
    if lease:
        holder = f"`{lease['session'][:8]}…` trên `{lease.get('host','?')}`"
        state_line = f"**{d['state']}** — đang giữ bởi {holder}, hết hạn {lease['expires_at']}"
    else:
        state_line = f"**{d['state']}** — không session nào đang giữ"
    rows = [
        f"| state | {d['state']} |",
        f"| group | {', '.join('#' + str(n) for n in d['group'])} |",
        f"| branch | `{d['branch']}` |",
        f"| PR | {('#' + str(d['pr'])) if d.get('pr') else '—'} |",
        f"| epoch (fencing token) | {d['epoch']} |",
        f"| attempts / review rounds / reaps | {d['attempts']} / {d['review_rounds']} / {d['reaps']} |",
    ]
    hist = "\n".join(f"- {_sanitize(h)}" for h in d["history"][-15:]) or "- (chưa có)"
    return (
        f"{LEDGER_MARKER}\n"
        "## TAL ledger — điều phối tự động\n\n"
        f"{state_line}\n\n"
        "| field | value |\n|---|---|\n" + "\n".join(rows) + "\n\n"
        "<details><summary>lịch sử</summary>\n\n" + hist + "\n\n</details>\n\n"
        "<details><summary>state (máy đọc — đừng sửa tay)</summary>\n\n"
        "```json\n" + json.dumps(d, ensure_ascii=False, indent=2) + "\n```\n\n</details>\n"
    )


def ledger_write(d: dict, comment_id: int | None, note: str | None = None) -> int:
    if note:
        d.setdefault("history", []).append(f"{iso(now())} · {_sanitize(note)}")
        d["history"] = d["history"][-40:]
    d["heartbeat"] = iso(now())  # luôn đổi → server chắc chắn cập nhật updated_at
    body = ledger_render(d)
    if comment_id:
        gh(
            ["api", f"repos/{C.repo}/issues/comments/{comment_id}", "-X", "PATCH",
             "-f", f"body={body}"]
        )
        return comment_id
    res = gh_json(
        ["api", f"repos/{C.repo}/issues/{d['issue']}/comments", "-f", f"body={body}"]
    )
    # #2300 — POST hỏng trước đây nổ TypeError thô (res None) SAU khi ref/worktree
    # đã dựng, ngoài tầm rollback của claim. Fail có thông điệp để caller còn dọn.
    if not res or "id" not in res:
        raise Fail(f"KHÔNG GHI ĐƯỢC sổ ledger cho #{d['issue']} — POST comment thất bại. "
                   "Trạng thái GitHub CHƯA đổi; thử lại khi API lành.")
    return res["id"]


def lease_expired(d: dict, updated_at: datetime | None) -> bool:
    """Hết hạn theo ĐỒNG HỒ SERVER. Không có ledger comment = coi như hết hạn."""
    if updated_at is None:
        return True
    ttl = (d.get("lease") or {}).get("ttl", TTL)
    return now() > updated_at + timedelta(seconds=ttl + GRACE)


# ─────────────────────────────────────────────────────────────────────────────
# Lease — CAS trên git ref + khoá cục bộ
# ─────────────────────────────────────────────────────────────────────────────


def ref_path(key: str) -> str:
    return f"{REF_NS}{key}"


def ref_create(key: str, sha: str, payload: dict | None = None) -> bool:
    """True = mình vừa tạo được (giành được). False = đã có người giữ (422).

    `payload` (#2172): danh tính chủ lease đi TRONG chính cái ref — bọc `sha` vào một
    tag object mà message là JSON, rồi trỏ ref vào tag đó. Trước đây ref chỉ là một
    SHA câm: `tal status` phải suy chủ từ history của sổ, và lease review (cố ý không
    ghi sổ) hiện `session ?` y hệt lease mồ côi — cái mơ hồ đẩy người ta tới chỗ xoá
    nhầm ref của một session đang sống. Payload là PHỤ TRỢ: tạo tag hỏng thì rơi về
    SHA trần (CAS trên ref mới là cơ chế loại trừ, không phải payload); tag object
    không có ref trỏ tới sẽ được GitHub tự dọn."""
    obj = sha
    if payload is not None:
        t = gh_json(["api", f"repos/{C.repo}/git/tags",
                     "-f", f"tag={key}", "-f", f"message={json.dumps(payload)}",
                     "-f", f"object={sha}", "-f", "type=commit"], default=None)
        if t and t.get("sha"):
            obj = t["sha"]
    p = gh(
        ["api", f"repos/{C.repo}/git/refs", "-f", f"ref={ref_path(key)}", "-f", f"sha={obj}"],
        check=False,
    )
    if p.returncode == 0:
        return True
    blob = (p.stderr + p.stdout).lower()
    if "already exists" in blob:
        return False
    raise Fail(f"không tạo được lease ref {key}: {p.stderr.strip()}")


def ref_payload(sha: str) -> dict | None:
    """Đọc payload chủ lease từ tag object (#2172). None = ref không mang payload
    (ref kiểu cũ trỏ thẳng commit, hoặc không đọc được) — người gọi tự nói rõ."""
    t = gh_json(["api", f"repos/{C.repo}/git/tags/{sha}"], default=None)
    if not t:
        return None
    try:
        d = json.loads(t.get("message") or "")
    except (ValueError, AttributeError):
        return None
    return d if isinstance(d, dict) else None


def ref_exists(key: str) -> bool:
    """#2300 — ba trạng thái, không phải hai: True / False-vì-404-THẬT / raise.

    Trước đây mọi lỗi (quota, mạng) đều đọc thành "ref không còn" — `tal assert`
    dừng oan một session lành (exit 4 giữa việc), `local_lock` rmtree khoá sống
    của session khác, gc dọn nhầm. Không đo được thì phải NÓI không đo được."""
    p = gh(["api", f"repos/{C.repo}/git/ref/{ref_path(key)[5:]}"], check=False)
    if p.returncode == 0:
        return True
    blob = (p.stderr + p.stdout).lower()
    if "not found" in blob or "404" in blob:
        return False
    raise Fail(f"KHÔNG ĐO ĐƯỢC ref {key} — gh thất bại (không phải 404):\n"
               f"  {(p.stderr or p.stdout).strip()}\n"
               "Đừng kết luận ref còn hay mất khi chưa đo được.")


def ref_delete(key: str) -> bool:
    """#2300 — xoá fail không được im lặng: caller từng in "đã nhả lease" trong khi
    ref còn nguyên, claim sau BUSY vô cớ và gc thì skip. True = ref chắc chắn không
    còn (xoá được, hoặc vốn không tồn tại); False = KHÔNG xoá được, đã warn."""
    p = gh(["api", "-X", "DELETE", f"repos/{C.repo}/git/refs/{ref_path(key)[5:]}"], check=False)
    if p.returncode == 0:
        return True
    blob = (p.stderr + p.stdout).lower()
    if "does not exist" in blob or "not found" in blob or "404" in blob:
        return True
    warn(f"KHÔNG xoá được lease ref {key}: {(p.stderr or p.stdout).strip()} — "
         "ref có thể còn sống trên GitHub; lần claim sau sẽ báo BUSY, chạy lại release/gc khi API lành.")
    return False


def refs_all_full() -> list[dict]:
    """Mọi lease ref kèm object nó trỏ tới: `type == "tag"` ⇒ có payload chủ lease.

    #2300 — đường raise: consumer của danh sách này toàn quyết định hệ trọng
    (rào vùng #2270, rào gc #1385, `tal status`). API hỏng mà trả [] là: hai
    session nhận vùng chồng nhau, gc xoá worktree của lease sống, status in
    "(không có lease nào)" trấn an sai."""
    out = gh_json_strict(
        ["api", f"repos/{C.repo}/git/matching-refs/{REF_NS[5:]}", "--paginate"],
        what="danh sách lease refs",
    )
    return [{"key": r["ref"][len(REF_NS):],
             "sha": (r.get("object") or {}).get("sha", ""),
             "type": (r.get("object") or {}).get("type", "commit")} for r in out]


def refs_all() -> list[str]:
    return [r["key"] for r in refs_all_full()]


def local_lock(key: str) -> bool:
    """Khoá cục bộ: rào nhanh cho nhiều session trên CÙNG máy. Ref mới là căn cứ.

    #2300 — hai chỗ hại: (a) `ref_exists` fail-as-False từng cho phép rmtree khoá
    SỐNG của session khác cùng máy khi API chập chờn — giờ ref_exists raise thì
    coi như bận (fail-closed, CAS ref vẫn là loại trừ thật); (b) meta ghi thẳng
    tạo cửa sổ mkdir→write mà session khác đọc được meta rỗng — ghi tmp rồi
    os.replace cho nguyên tử."""
    d = C.state_dir / f"{key}.lock"
    try:
        d.mkdir()
    except FileExistsError:
        meta_f = d / "meta.json"
        try:
            meta = json.loads(meta_f.read_text())
        except Exception:
            meta = {}
        if meta.get("session") == session_id():
            return True                     # re-entrant, cùng session
        try:
            gone = not ref_exists(key)
        except Fail:
            return False                    # không đo được ⇒ không phá khoá của ai
        if gone:
            shutil.rmtree(d, ignore_errors=True)  # rác của session đã chết (404 thật)
            return local_lock(key)
        return False
    tmp = d / "meta.json.tmp"
    tmp.write_text(
        json.dumps({"session": session_id(), "pid": os.getpid(), "at": iso(now())})
    )
    os.replace(tmp, d / "meta.json")
    return True


def local_unlock(key: str):
    shutil.rmtree(C.state_dir / f"{key}.lock", ignore_errors=True)


def head_sha() -> str:
    run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=str(C.main_worktree), check=False)
    return run(
        ["git", "rev-parse", f"origin/{BASE_BRANCH}"], cwd=str(C.main_worktree)
    ).stdout.strip()


