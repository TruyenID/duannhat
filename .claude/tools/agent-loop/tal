# GC — thu hồi lease chết + xoá sạch branch sau merge
# ─────────────────────────────────────────────────────────────────────────────


def _pid_alive(pid) -> bool:
    try:
        os.kill(int(pid), 0)
    except (OSError, TypeError, ValueError):
        return False
    return True


BATCH_MARK = ".tal-batch.json"


def batch_mark_alive(tmp: Path) -> None:
    """Ghi pid + session vào cây tạm để session khác biết nó đang sống (#1468/A)."""
    try:
        (tmp / BATCH_MARK).write_text(json.dumps({
            "pid": os.getpid(),
            "session": session_id(),
            "host": socket.gethostname(),
            "started_at": iso(now()),
        }))
    except Exception:
        pass                                  # thiếu dấu chỉ làm reap dè dặt hơn


def batch_tree_dead(d: Path) -> tuple[bool, str]:
    """Cây tạm này có CHẮC CHẮN chết không, và vì sao.

    Mặc định của hàm này là **KHÔNG xoá**: một cây còn sống bị xoá thì full suite
    của người khác chết giữa chừng và báo nhầm thành test đỏ (#1436/#1409) — mất
    hàng chục phút và một kết luận sai. Một cây chết bị bỏ sót thì chỉ tốn đĩa,
    và lần chạy sau của chính chủ tự dọn.
    """
    f = d / BATCH_MARK
    try:
        meta = json.loads(f.read_text())
    except Exception:
        # Không có dấu: hoặc là rác `_batch` trước #1355, hoặc cây vừa được
        # `worktree add` xong mà chưa kịp ghi dấu. Phân biệt bằng tuổi thư mục.
        try:
            age = time.time() - d.stat().st_mtime
        except Exception:
            return False, ""
        if age < 300:
            return False, ""
        return True, "không có dấu sự sống và đã cũ hơn 5 phút"
    if meta.get("host") and meta["host"] != socket.gethostname():
        return False, ""                      # máy khác — pid ở đây vô nghĩa
    pid = meta.get("pid")
    if _pid_alive(pid):
        return False, ""
    return True, f"pid {pid} đã chết (session {str(meta.get('session'))[:8]}…)"


def reap_batch_gate(dry: bool) -> list[dict]:
    """Thu hồi cổng merge bị rò + xoá cây tạm mồ côi (#1355).

    `batch_gate_acquire` tạo khoá cục bộ RỒI ref; `batch_gate_release` xoá ref RỒI khoá
    cục bộ. Nên một session bị `kill -9` để lại **cả hai**. Căn cứ để biết nó chết:
    khoá cục bộ mất hẳn (không ai trên máy này giữ), hoặc pid trong đó không còn sống.

    Cố ý KHÔNG dùng TTL: cổng chạy full suite, hàng chục phút là bình thường, và một
    TTL đoán mò sẽ thu hồi cổng của một lô đang chạy đúng — đúng cái lỗi này đang chữa.
    """
    acts: list[dict] = []
    try:
        gate_alive = ref_exists(BATCH_KEY)
    except Fail:
        acts.append({"key": BATCH_KEY, "action": "không đo được lease refs — bỏ qua reap cổng lượt này"})
        return acts + _reap_batch_trees(dry)
    if gate_alive:
        # #2300 C7 — payload trong ref là chứng cứ XUYÊN MÁY; chứng cứ cục bộ
        # (meta/pid) chỉ có nghĩa khi cổng thuộc CHÍNH máy này. Không đọc được
        # payload (ref kiểu cũ / API chớp) thì rơi về đường chứng cứ cục bộ.
        pay = None
        try:
            gate_ref = next((r for r in refs_all_full() if r["key"] == BATCH_KEY), None)
            if gate_ref and gate_ref.get("type") == "tag":
                pay = ref_payload(gate_ref["sha"])
        except Fail:
            pay = None
        if pay and pay.get("host") and pay["host"] != socket.gethostname():
            acts.append({"key": BATCH_KEY,
                         "action": f"cổng merge của máy khác ({pay['host']}, session "
                                   f"{str(pay.get('session', '?'))[:8]}…) → để nguyên"})
            return acts + _reap_batch_trees(dry)
        meta_f = C.state_dir / f"{BATCH_KEY}.lock" / "meta.json"
        try:
            meta = json.loads(meta_f.read_text())
        except Exception:
            meta = None
        if meta is None:
            why = "khoá cục bộ không còn"
        elif not _pid_alive(meta.get("pid")):
            why = f"pid {meta.get('pid')} đã chết (session {str(meta.get('session'))[:8]}…)"
        else:
            why = None
        if why:
            acts.append({"key": BATCH_KEY, "action": f"cổng merge bị rò ({why}) → thu hồi"})
            if not dry:
                ref_delete(BATCH_KEY)
                local_unlock(BATCH_KEY)

    return acts + _reap_batch_trees(dry)


def _reap_batch_trees(dry: bool) -> list[dict]:
    # Cây tạm mồ côi: `_batch-<session>` của session đã chết, và `_batch` cũ trước #1355.
    acts: list[dict] = []
    mine = batch_tmp_dir().name
    for d in sorted(C.worktrees_dir.glob("_batch*")) if C.worktrees_dir.exists() else []:
        if d.name == mine:
            continue
        # Trước #1468 chỗ này xoá THẲNG mọi cây không phải của mình. Nhưng
        # `_batch-<session-khác>` đang chạy full suite KHÔNG phải mồ côi — nó bị
        # `rm -rf` giữa chừng, pest chết ở bootstrap với `Class "Pest\Panic" not
        # found`, và cổng kết luận "full suite ĐỎ". Tái hiện 2/2 lần (#1436).
        dead, why = batch_tree_dead(d)
        if not dead:
            acts.append({"key": d.name, "action": "cây tạm của session khác còn SỐNG → để nguyên"})
            continue
        acts.append({"key": d.name, "action": f"cây tạm mồ côi của cổng merge ({why}) → xoá"})
        if not dry:
            drop_batch_worktree(C.main_worktree, d)
    return acts


ORPHAN_GRACE = 300          # giây; `cmd_claim` chỉ cần vài giây giữa ref và sổ


def _orphan_seen_file(key: str) -> Path:
    return C.state_dir / f"orphan-{key}.json"


def orphan_ref_is_stale(key: str) -> tuple[bool, str]:
    """Ref "có ref mà không có sổ" này đã ĐỦ CŨ để coi là rác chưa (#1468/C).

    `cmd_claim` tạo ref TRƯỚC rồi mới ghi sổ, nên trong vài giây đó trạng thái
    "thiếu sổ" là BÌNH THƯỜNG, không phải rác. `gc` của session khác rơi vào
    đúng cửa sổ ấy sẽ **cướp lease của người đang làm**: ref biến mất, `tal
    queue` mời session khác vào nhận, và `tal assert` của chính chủ fail giữa lúc
    họ đang sửa — commit của họ thành rác. Bắt được tại trận trong #1404.

    Hai lớp chặn:
      1. Khoá cục bộ còn pid sống  → chắc chắn có người đang claim ngay lúc này.
         (`cmd_claim` gọi `local_lock` TRƯỚC `ref_create`, nên bằng chứng luôn có
         trên máy đang claim.)
      2. Không có khoá (máy khác)  → ghi mốc "lần đầu thấy mồ côi" và chỉ xoá ở
         lần gc SAU, khi đã quá `ORPHAN_GRACE`.
    """
    meta_f = C.state_dir / f"{key}.lock" / "meta.json"
    try:
        meta = json.loads(meta_f.read_text())
    except Exception:
        meta = None
    if meta and _pid_alive(meta.get("pid")):
        return False, f"khoá cục bộ còn sống (pid {meta.get('pid')}) — có người đang claim"

    f = _orphan_seen_file(key)
    try:
        first = float(json.loads(f.read_text())["at"])
    except Exception:
        first = None
    if first is None:
        try:
            C.state_dir.mkdir(parents=True, exist_ok=True)
            f.write_text(json.dumps({"at": time.time()}))
        except Exception:
            pass
        return False, "vừa thấy lần đầu — chờ hết ân hạn rồi mới xoá"
    if time.time() - first < ORPHAN_GRACE:
        return False, f"mới thấy {int(time.time() - first)}s trước, ân hạn {ORPHAN_GRACE}s"
    return True, f"thiếu sổ liên tục hơn {ORPHAN_GRACE}s"


def orphan_seen_clear(key: str) -> None:
    """Ref đã có sổ trở lại (hoặc đã bị xoá) — quên mốc đi, đừng cộng dồn."""
    try:
        _orphan_seen_file(key).unlink()
    except Exception:
        pass



def open_pr_for_issue_branch(issue: int) -> dict | None:
    """PR OPEN head=`issue-<N>`. None = không có. Raise Fail = không đo được (#2788).

    Đường reap DÙNG kết quả này để quyết định stamp queued vs awaiting-review —
    nuốt lỗi thành "không có PR" là đúng bug đã nuốt hai PR mergeable một buổi sáng.
    """
    prs = gh_json_strict(
        ["pr", "list", "-R", C.repo, "--head", f"issue-{issue}",
         "--json", "number,url,state"],
        what=f"PR mở của issue-{issue}",
    )
    open_prs = [p for p in (prs or []) if p.get("state") == "OPEN"]
    return open_prs[0] if open_prs else None


def stranded_review_candidates(open_prs: list[dict], open_labels: dict[int, set[str]],
                               live: set[int]) -> list[dict]:
    """PR mở head=issue-N mà issue không nằm ở HÀNG ĐỢI NÀO (#2788).

    Ca đã đo: #2784/#2785 và #2778/#2780 — ledger `queued`, nhãn trống managed,
    PR MERGEABLE. `tal queue` đòi agent:ready; `tal review-queue` đòi
    agent:awaiting-review; không cái nào có ⇒ vô hình với cả hai vai.

    Không nhặt khi issue đang có chỗ: awaiting-review / review-passed / executing
    / changes-requested / shipped / dead / blocked, hoặc đang giữ lease sống
    (session code còn làm trên PR đã mở).
    """
    out: list[dict] = []
    seen: set[int] = set()
    parked = {L_AWAIT, L_PASSED, L_WORKING, L_SHIPPED, L_DEAD, L_BLOCKED, L_CHANGES}
    for p in open_prs:
        m = re.match(r"^issue-(\d+)$", p.get("headRefName") or "")
        if not m:
            continue
        issue = int(m.group(1))
        if issue in seen or issue in live or issue not in open_labels:
            continue
        labels = open_labels[issue]
        if labels & parked:
            continue
        seen.add(issue)
        out.append({"issue": issue, "pr": p.get("number"), "labels": sorted(labels)})
    return out


def reap_leases(dry: bool) -> list[dict]:
    """Visibility-timeout expiry: lease im lặng quá TTL (theo đồng hồ server) thì thu hồi."""
    done = []
    for key in refs_all():
        if key == BATCH_KEY:
            continue                      # cổng merge — `reap_batch_gate` lo, có luật riêng
        mi, mp = re.match(r"^issue-(\d+)$", key), re.match(r"^pr-(\d+)$", key)
        if not (mi or mp):
            done.append({"key": key, "action": "ref lạ, để nguyên (không phải lease của tal)"})
            continue
        if mp:
            try:
                issue = pr_issue(int(mp.group(1)))
            except Gone:
                done.append({"key": key, "action": "ref mồ côi (PR không còn — 404 thật) → xoá"})
                if not dry:
                    ref_delete(key)
                    local_unlock(key)
                continue
            except Fail as e:
                # #2300 — KHÔNG ĐO ĐƯỢC ≠ KHÔNG CÒN: quota cạn từng làm gc xoá
                # ref lease review đang sống rồi hai session review chồng nhau.
                done.append({"key": key, "action": f"KHÔNG đo được PR — để nguyên ({str(e)[:80]})"})
                continue
        else:
            issue = int(mi.group(1))
            # #2300 A2 — ref của THÀNH VIÊN NHÓM không có sổ riêng (ledger chỉ ghi
            # trên root): trước đây nó bị coi là mồ côi và xoá TRONG KHI group
            # lease đang sống — session khác `claim --split` được ngay giữa việc.
            root = parent_of(issue)
            if root and root != issue:
                led_r, _, upd_r = ledger_read(root)
                lr = led_r.get("lease") or {}
                if key in (lr.get("keys") or []) and not lease_expired(led_r, upd_r):
                    done.append({"key": key, "issue": issue,
                                 "action": f"thành viên nhóm #{root} — lease nhóm đang sống, để nguyên"})
                    continue

        led, cid, upd = ledger_read(issue)
        if upd is None:                     # có ref mà chưa có sổ — CHƯA chắc là rác
            stale, why = orphan_ref_is_stale(key)
            if not stale:
                done.append({"key": key, "issue": issue,
                             "action": f"ref chưa có sổ nhưng KHÔNG xoá — {why}"})
                continue
            done.append({"key": key, "issue": issue,
                         "action": f"ref mồ côi ({why}) → xoá"})
            if not dry:
                ref_delete(key)
                local_unlock(key)
                orphan_seen_clear(key)
            continue
        orphan_seen_clear(key)              # có sổ rồi thì mốc mồ côi cũ vô nghĩa
        if not lease_expired(led, upd):
            continue

        age = human_delta((now() - upd).total_seconds())
        done.append({"key": key, "issue": issue, "action": f"thu hồi lease (im lặng {age})"})
        if dry:
            continue
        ref_delete(key)
        local_unlock(key)

        if mp:                              # lease review chết → PR về lại hàng đợi review
            # #2300 D8 — hỏi PR trước khi re-stamp: reviewer chết + người merge tay
            # từng làm gc dán lại {reviewing, awaiting-review} lên issue ĐÃ SHIP,
            # kẹt "đang chờ review" vĩnh viễn.
            pd = gh_json(["pr", "view", mp.group(1), "-R", C.repo,
                          "--json", "state,mergedAt"], default=None)
            if pd is None:
                ledger_write(led, cid, f"lease review {key} quá hạn — PR không đo được, "
                                       "KHÔNG re-stamp nhãn (chờ lần gc sau)")
            elif pd.get("mergedAt"):
                ledger_write(led, cid, f"lease review {key} quá hạn nhưng PR đã MERGED — không re-stamp")
            elif pd.get("state") != "OPEN":
                ledger_write(led, cid, f"lease review {key} quá hạn, PR đóng-không-merge — "
                                       "trả issue về hàng đợi code (#2289)")
                set_state_labels(issue, {L_READY}, drop=set(), preserve={L_CHANGES})
            else:
                ledger_write(led, cid, f"lease review {key} quá hạn (im lặng {age}) — trả PR về hàng đợi review")
                set_state_labels(issue, {L_REVIEWING, L_AWAIT})
            continue

        led["reaps"] = led.get("reaps", 0) + 1
        led["lease"] = None
        # #2788 — PR đã mở TRƯỚC lúc reap thì KHÔNG queued: stamp awaiting-review
        # + ghi số PR vào sổ. Bản trước reset pr=null, gỡ nhãn làm việc mà không
        # trả agent:ready → issue rơi khỏi CẢ HAI queue, im lặng. Hai ca một buổi.
        try:
            opened = open_pr_for_issue_branch(issue)
        except Fail as e:
            ledger_write(led, cid,
                         f"lease quá hạn (im lặng {age}) — KHÔNG đo được PR mở, "
                         f"KHÔNG stamp queued ({str(e)[:80]})")
            continue
        if opened:
            led["state"] = "review"
            led["pr"] = opened["number"]
            ledger_write(led, cid,
                         f"lease quá hạn (im lặng {age}) nhưng PR #{opened['number']} đang mở "
                         f"— chuyển awaiting-review, không queued (#2788)")
            set_state_labels(issue, {L_REVIEWING, L_AWAIT}, preserve={L_CHANGES})
            continue
        if led["reaps"] >= MAX_ATTEMPTS:
            led["state"] = "dead_letter"
            ledger_write(led, cid, f"thu hồi lần {led['reaps']} → dead-letter (session cứ chết giữa đường)")
            set_state_labels(issue, {L_DEAD, L_BLOCKED})
        else:
            led["state"] = "queued"
            ledger_write(led, cid,
                         f"lease quá hạn, thu hồi (im lặng {age}) — trả về hàng đợi, gắn lại {L_READY}")
            # #2300 D14 — giữ cờ ƯU TIÊN "sửa theo review".
            # #2788 — desired PHẢI có L_READY: `set()` gỡ nhãn làm việc rồi để
            # trống managed = không hàng đợi nào thấy. History "trả về hàng đợi"
            # trước đây là sai sự thật.
            set_state_labels(issue, {L_READY}, preserve={L_CHANGES})
    return done


def live_lease_issues() -> set[int]:
    """Issue đang có lease SỐNG (ref còn + ledger chưa quá TTL).

    `gc` chạy `reap_leases` trước, nên ref `issue-<N>` còn sót lại gần như chắc chắn
    là lease sống. Vẫn kiểm lại TTL ở đây vì `reap_leases` có thể bỏ sót một ref do
    lỗi mạng — và khi không chắc thì nghiêng về "đang sống": dọn muộn một lượt là
    phiền, xoá việc của người đang làm là mất việc (#1385).
    """
    live: set[int] = set()
    for key in refs_all():
        m = re.match(r"^issue-(\d+)$", key)
        if not m:
            continue
        issue = int(m.group(1))
        led, _, upd = ledger_read(issue)
        if led.get("lease") and not lease_expired(led, upd):
            live.add(issue)
    return live


def delete_merged_branches(repo: str, dry: bool, protect: set[str]) -> list[dict]:
    """Xoá branch của MỌI PR đã merge — bot hay người mở đều dọn."""
    acts = []
    prs = gh_json(
        ["pr", "list", "-R", repo, "--state", "merged", "--limit", "100",
         "--json", "number,headRefName,headRepositoryOwner,mergedAt"],
        default=[],
    )
    owner = repo.split("/")[0]
    live_heads = {
        r["ref"].split("refs/heads/")[-1]
        for r in gh_json(["api", f"repos/{repo}/git/matching-refs/heads/", "--paginate"], default=[])
    }
    # Một branch được DÙNG LẠI qua nhiều vòng PR — đó là ca `tal` cố ý hỗ trợ
    # (vòng 1 merge, vòng sửa mở PR mới từ cùng `issue-<N>`). Suy từ MỘT PR đã
    # merge ra "cả branch là rác" nên là sai, và xoá branch thì GitHub đóng luôn
    # PR đang mở từ nó: đã mất trắng hai PR đã test xong theo đúng đường đó
    # (#1413 — closed 01:58:50, head_ref_deleted 01:58:51, cách nhau 1 giây).
    #
    # Rào của #1385 không với tới đây: nó chừa issue có LEASE SỐNG, mà `tal pr`
    # nhả lease ngay sau khi mở PR — đúng thiết kế. Khoảng từ lúc mở PR tới lúc
    # merge là lúc branch cần được bảo vệ NHẤT và lại đang trần.
    open_heads = {
        p["headRefName"]
        for p in gh_json(
            ["pr", "list", "-R", repo, "--state", "open", "--limit", "100", "--json", "headRefName"],
            default=[],
        )
    }
    for p in prs:
        br = p["headRefName"]
        if br in protect or br not in live_heads:
            continue
        if br in open_heads:
            acts.append({"repo": repo, "branch": br, "pr": p["number"],
                         "action": "BỎ QUA branch — đang có PR MỞ từ nó (vòng sửa tiếp theo)"})
            continue
        if (p.get("headRepositoryOwner") or {}).get("login") not in (owner, None):
            continue  # fork — không phải của mình
        acts.append({"repo": repo, "branch": br, "pr": p["number"], "action": "xoá branch remote (PR đã merge)"})
        if not dry:
            gh(["api", "-X", "DELETE", f"repos/{repo}/git/refs/heads/{br}"], check=False)
    return acts


def cmd_gc(a):
    dry = a.dry_run
    # #2782 — ref origin/<base> cũ bằng lần fetch gần nhất; PR vừa merge ở remote
    # thì đo unmerged_content kêu oan. Mất mạng thì check=False, gc vẫn chạy
    # (bảo thủ — không xoá nhầm).
    run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=str(C.main_worktree), check=False)
    acts: list[dict] = []
    acts += reap_batch_gate(dry)
    acts += reap_leases(dry)
    acts += cleanup_orphan_worktrees(dry)

    # Một issue có thể được claim LẠI sau khi PR trước đã merge — đó là ca `Refs #N`
    # (PR làm xong một phần, issue còn dở) mà chính tal hỗ trợ. Lúc đó branch/worktree
    # `issue-<N>` là của vòng làm MỚI, không phải rác của PR cũ. Không có rào này thì
    # `gc` của session A xoá worktree + branch + lease đang sống của session B (#1385).
    live = live_lease_issues()

    protect = {"main", "dev", "master"} | {f"issue-{n}" for n in live}
    acts += delete_merged_branches(C.repo, dry, protect)
    if not a.no_submodules:
        for s in submodules().values():
            if s.get("repo"):
                acts += delete_merged_branches(s["repo"], dry, protect | {s.get("branch", "dev")})

    # PR đã merge → (1) đối chiếu nhãn/ledger, (2) dọn worktree + branch cục bộ.
    #
    # #1384 — HAI việc, KHÔNG chung một điều kiện. Trước đây cả khối nằm sau
    # `if not wt.exists() and not branch_exists_local(...): continue`, nên việc
    # gắn `status:shipped` bị buộc vào chuyện *máy này* còn worktree hay không —
    # một trạng thái cục bộ, khác nhau giữa các máy và biến mất sau lần gc đầu.
    # Hệ quả đo được: #1382/#1151/#1154/#1161 (worktree còn) được gắn nhãn, còn
    # #1353/#1356 (worktree đã dọn) thì không — và vì `Closes #N` không đóng
    # được issue khi merge vào `dev` (GitHub chỉ auto-close ở default branch),
    # hai cái đó ở lại OPEN + `agent:ready` và quay về hàng đợi như việc mới.
    merged_prs = gh_json(
        ["pr", "list", "-R", C.repo, "--state", "merged", "--limit", "100",
         # `body` cho #2789 — cụm chỉ được nối bằng `Closes #N` trong thân PR.
         # (`closingIssuesReferences` đã được lấy từ trước nhưng KHÔNG chỗ nào
         # đọc; giữ nguyên để không đổi hình dạng dữ liệu ngoài phạm vi bản sửa.)
         "--json", "number,headRefName,closingIssuesReferences,mergedAt,body"],
        default=[],
    )
    # Một lời gọi cho toàn bộ issue đang mở: phần đối chiếu bên dưới chỉ tốn
    # thêm API cho những issue THẬT SỰ còn lệch, không phải cho cả 100 PR.
    open_labels = {i["number"]: {l["name"] for l in i["labels"]} for i in open_issues()}
    open_pr_rows = gh_json(
        ["pr", "list", "-R", C.repo, "--state", "open", "--limit", "100",
         "--json", "number,headRefName"],
        default=[],
    )
    umbrella_open_heads = {p["headRefName"] for p in open_pr_rows}

    for p in merged_prs:
        m = re.match(r"^issue-(\d+)$", p["headRefName"])
        if not m:
            continue
        issue = int(m.group(1))

        # (1) đối chiếu nhãn — chạy dù máy này chưa từng có worktree cho issue đó.
        #
        # #1571 — GẮN NHÃN và ĐÓNG phải chịu CHUNG MỘT điều kiện. Trước đây nhãn
        # được gắn vô điều kiện rồi mới hỏi `closable()` để quyết định có đóng
        # không, nên `gc` tự mâu thuẫn trong cùng một lần chạy: in ra "KHÔNG đóng
        # #962: còn mang status:planning" ngay sau khi vừa gắn `status:shipped`
        # cho chính nó. Issue mang cả hai nhãn, và `tal queue` lọc theo nhãn nên
        # nó **rơi khỏi hàng đợi** — việc còn dang dở biến mất, im lặng.
        if issue in open_labels and L_SHIPPED not in open_labels[issue]:
            merged_at = p.get("mergedAt")
            # Hỏi TRƯỚC khi đụng vào bất cứ thứ gì. Nhóm có thể gồm nhiều issue,
            # nên hỏi từng cái — một cái chưa xong không được kéo cả nhóm theo.
            led_peek, _, _ = ledger_read(issue)
            # #2789 — group ∪ Closes, cùng lý do như đường merge.
            group = [n for n in shipped_scope(led_peek, issue, p.get("body"))
                     if issue_data(n)["state"] == "open"]
            verdicts = {n: closable(n, merged_at) for n in group}
            touch = [n for n, (ok, _) in verdicts.items() if ok]
            skip = [(n, why) for n, (ok, why) in verdicts.items() if not ok and why]

            for n, why in skip:
                print(f"  · KHÔNG đụng #{n}: {why}")

            if touch:
                acts.append({"issue": issue,
                             "action": f"gắn {L_SHIPPED} (PR #{p['number']} đã merge)"})
            if touch and not dry:
                led, cid, _ = ledger_read(issue)
                led["state"] = "shipped"
                led["lease"] = None
                ledger_write(led, cid, f"PR #{p['number']} đã merge → shipped")
                for n in touch:
                    set_state_labels(n, {L_SHIPPED})
                    # `--no-close` chỉ để gắn nhãn mà không đóng.
                    if not getattr(a, "no_close", False):
                        gh(["issue", "close", str(n), "-R", C.repo, "-c",
                            f"Đã merge vào `{BASE_BRANCH}` qua PR #{p['number']}."],
                           check=False)

        # (2) dọn cục bộ — hỏi git worktree list, không đoán thư mục (#2710).
        paths = worktree_paths_for_issue(issue)
        if not paths and not branch_exists_local(f"issue-{issue}"):
            continue
        wt = paths[0] if paths else (C.worktrees_dir / f"issue-{issue}")
        if issue in live:
            acts.append({"issue": issue, "action": "BỎ QUA worktree — có lease đang sống "
                                                   "(issue được claim lại sau PR đã merge)"})
            continue
        if f"issue-{issue}" in umbrella_open_heads:
            # Vòng sửa đã mở PR mới từ cùng branch và đã nhả lease (đúng thiết kế
            # của `tal pr`). Xoá branch cục bộ ở đây là vứt bản sao cuối cùng của
            # công việc đó trên máy này — remote đã được chừa ở
            # delete_merged_branches, cây cục bộ phải theo cùng luật (#1413).
            acts.append({"issue": issue, "action": "BỎ QUA worktree — đang có PR MỞ từ branch này"})
            continue
        # #2201 — hỏi "có PHẢI worktree không" TRƯỚC khi hỏi "có bẩn không".
        #
        # Một thư mục dưới `.claude/worktrees/` mà đăng ký git đã mất (thư mục
        # còn, entry trong `git worktree list` không còn) vẫn `cd` vào được, và
        # `git status` chạy từ đó IM LẶNG giải lên CÂY CHÍNH — nên nó trả về
        # trạng thái bẩn của cây chính. Cây chính thì luôn có untracked file
        # (`vendor/`, `.agents/`…), nên điều kiện dọn KHÔNG BAO GIỜ thoả và xác
        # worktree tích lại vĩnh viễn: 18 thư mục / 202 MB lúc phát hiện. Dấu
        # nhận biết trong log là con số y HỆT nhau cho mọi issue ("còn thay đổi
        # chưa commit (18 file)" ×18) — ba cây khác nhau không thể tình cờ bẩn
        # giống hệt nhau.
        #
        # Tệ hơn 202 MB rác: câu đó là một lời TRẤN AN SAI. "Còn thay đổi chưa
        # commit" đọc như *đang có người làm dở, tôi tránh ra*, nên không ai đi
        # kiểm. Cùng họ với #2172 (`review-queue` rỗng không phân biệt "hết việc"
        # với "người khác đang giữ"): công cụ trả lời nghe hợp lý cho một câu hỏi
        # nó không thật sự trả lời được.
        #
        # Xác thì đi đường orphan sẵn có của #2177 (`remove_worktree` dời sang
        # `<tên>.orphan-<ts>` rồi mới rmtree), không phải đường "cây bẩn".
        if wt.exists() and not worktree_attached(wt):
            if dry or remove_worktree(issue):
                acts.append({"issue": issue,
                             "action": "xoá XÁC worktree — thư mục còn nhưng đăng ký git "
                                       "đã mất (#2201) + branch cục bộ"})
            else:
                acts.append({"issue": issue,
                             "action": "XÁC worktree (đăng ký git đã mất, #2201) nhưng KHÔNG dời "
                                       "được thư mục — dọn tay rồi chạy lại gc"})
            continue
        dirty = run(["git", "status", "--porcelain"], cwd=str(wt), check=False).stdout.strip() if wt.exists() else ""
        if dirty:
            acts.append({"issue": issue, "action": f"BỎ QUA worktree — còn thay đổi chưa commit ({len(dirty.splitlines())} file)"})
            continue
        # #2300 A12 — "sạch" chưa đủ: commit ĐÃ commit nhưng CHƯA push không dính
        # porcelain, và `branch -D` trong remove_worktree là bản sao cuối cùng.
        # #2674 — nhưng hỏi bằng NỘI DUNG, không bằng tổ tiên SHA: repo squash-merge
        # nên `origin/<base>..HEAD` không bao giờ rỗng và rào cũ giữ lại 100% worktree.
        if wt.exists():
            # #2792 — hỏi GitHub một lần cho branch này; None nghĩa là
            # "không có PR merged để đối chiếu", tức đi tiếp đường so nội dung.
            keep = worktree_unmerged_content(
                wt, BASE_BRANCH, merged_head_sha=merged_pr_head_sha(f"issue-{issue}"))
            if keep:
                acts.append({"issue": issue,
                             "action": f"BỎ QUA worktree — {keep} "
                                       f"(push hoặc bỏ tay rồi gc lại)"})
                continue
        if dry or remove_worktree(issue):
            acts.append({"issue": issue, "action": "xoá worktree + branch cục bộ (PR đã merge)"})
        else:
            acts.append({"issue": issue,
                         "action": "KHÔNG dọn trọn vẹn worktree — xem cảnh báo; nếu đã dời "
                                   "thành orphan thì gc sẽ thử lại, nếu chưa dời thì đăng ký git "
                                   "được giữ nguyên (#2177/#2364)"})

    # #2788 — nhặt PR mở mà issue không nhãn review/ready (reap đã nuốt). Không
    # đụng issue đang giữ lease sống (session code còn làm trên PR đã mở).
    for s in stranded_review_candidates(open_pr_rows, open_labels, live):
        acts.append({"issue": s["issue"], "pr": s["pr"],
                     "action": (f"PR #{s['pr']} mở, issue #{s['issue']} không nhãn review "
                                f"— nhặt vào awaiting-review (#2788)")})
        if not dry:
            led_s, cid_s, _ = ledger_read(s["issue"])
            led_s["state"] = "review"
            led_s["pr"] = s["pr"]
            led_s["lease"] = None
            ledger_write(led_s, cid_s,
                         f"gc nhặt PR #{s['pr']} mở mồ côi (#2788) — awaiting-review, không queued")
            set_state_labels(s["issue"], {L_REVIEWING, L_AWAIT}, preserve={L_CHANGES})

    # PR đóng mà KHÔNG merge = việc bị bỏ. Xoá branch là mất code, nên chỉ báo,
    # trừ khi người yêu cầu rõ bằng --include-abandoned.
    for p in gh_json(["pr", "list", "-R", C.repo, "--state", "closed", "--limit", "100",
                      "--json", "number,headRefName,mergedAt"], default=[]):
        if p.get("mergedAt") or not re.match(r"^issue-\d+$", p["headRefName"]):
            continue
        issue = int(p["headRefName"].split("-")[1])
        # Chỉ báo khi THẬT SỰ còn gì để dọn. Không kiểm thì mọi PR bị đóng sẽ được nhắc
        # lại ở từng lượt gc, vĩnh viễn — và tiếng ồn lặp lại thì người đọc bắt đầu bỏ qua
        # cả những dòng có thật.
        leftover = (bool(worktree_paths_for_issue(issue))
                    or branch_exists_local(p["headRefName"])
                    or branch_exists_remote(p["headRefName"]))
        if not leftover:
            continue
        if a.include_abandoned:
            # #2993 — "PR đóng mà KHÔNG merge = việc bị bỏ" là một SUY LUẬN TỪ
            # TRẠNG THÁI, và tiền đề của nó đã sai ba lần trong hai giờ ngày
            # 2026-08-16: #2977 · #2980 · #2989 đều `mergedAt=null` trong khi
            # mang việc đã xong, đã test, chưa vào base. #2974 sống sót CHỈ vì
            # worktree cục bộ còn — thứ chính đường này được phép dọn.
            #
            # Cùng hình dạng với #2988 một tầng phía trên: một TRẠNG THÁI được
            # đọc thành một sự thật về NỘI DUNG. Nên hỏi nội dung, bằng đúng
            # `worktree_unmerged_content` mà nhánh PR-đã-merge ngay dưới dùng —
            # nó đã qua hai vòng sửa (#2300 A12 → #2674) và biết cả ca squash.
            # Hỏi về VẬT SẮP MẤT. `DELETE refs/heads/X` xoá **ref X**, nên câu
            # phải hỏi là "ref X còn giữ gì chưa tới base", không phải "cây làm
            # việc còn giữ gì" — hai vật khác nhau, và trên máy KHÔNG có
            # worktree thì câu hỏi kia không trả lời được gì cả. Đó không phải
            # ca hiếm: chính `gc` là thứ dọn worktree đi, nên mọi lượt sau lần
            # đầu đều rơi vào đó.
            br_ab = p["headRefName"]
            wt_ab = C.worktrees_dir / f"issue-{issue}"
            if branch_exists_remote(br_ab):
                # Kéo ref về đã, nếu không `git cherry` hỏng và rào sẽ KÊU OAN
                # mọi lượt — rào kêu oan thì bị tắt.
                run(["git", "fetch", "-q", "origin",
                     f"{br_ab}:refs/remotes/origin/{br_ab}"],
                    cwd=str(C.main_worktree), check=False)
                keep_ab = worktree_unmerged_content(
                    C.main_worktree, BASE_BRANCH, rev=f"origin/{br_ab}")
            elif wt_ab.exists():
                keep_ab = worktree_unmerged_content(wt_ab, BASE_BRANCH)
            else:
                keep_ab = None
            if keep_ab:
                acts.append({"issue": issue,
                             "action": (f"TỪ CHỐI xoá (PR #{p['number']} đóng, KHÔNG merge) — "
                                        f"{keep_ab}. `--include-abandoned` nói 'tôi biết đây "
                                        f"là việc bỏ', không phải 'xoá cả thứ chưa vào "
                                        f"{BASE_BRANCH}'. Xem nhánh còn giữ gì: "
                                        f"git cherry origin/{BASE_BRANCH} origin/{br_ab}")})
                continue
            if dry or remove_worktree(issue):
                acts.append({"issue": issue, "action": f"xoá branch + worktree (PR #{p['number']} đóng, KHÔNG merge)"})
                if not dry:
                    gh(["api", "-X", "DELETE", f"repos/{C.repo}/git/refs/heads/{p['headRefName']}"], check=False)
            else:
                acts.append({"issue": issue,
                             "action": "KHÔNG dọn trọn vẹn worktree — xem cảnh báo; nếu đã dời "
                                       "thành orphan thì gc sẽ thử lại, nếu chưa dời thì đăng ký git "
                                       "được giữ nguyên (#2177/#2364)"})
        else:
            acts.append({"issue": issue,
                         "action": f"PR #{p['number']} đóng KHÔNG merge — còn branch/worktree; "
                                   "dùng --include-abandoned nếu chắc là bỏ"})

    if not dry:
        run(["git", "worktree", "prune"], cwd=str(C.main_worktree), check=False)
        run(["git", "fetch", "--prune", "-q", "origin"], cwd=str(C.main_worktree), check=False)
        for d in C.state_dir.glob("*.lock"):
            key = d.name[:-5]
            try:
                gone = not ref_exists(key)
            except Fail:
                # #2300 A16 — không đo được thì DỪNG cả vòng dọn: một cú API hỏng
                # từng cho phép rmtree TOÀN BỘ local lock, kể cả của claim đang
                # trong cửa sổ ref→sổ.
                warn("không đo được lease refs — bỏ vòng dọn local lock lượt này")
                break
            if gone:
                shutil.rmtree(d, ignore_errors=True)

    if a.json:
        return emit({"dry_run": dry, "actions": acts}, True)
    if not acts:
        print("không có gì để dọn")
    for x in acts:
        tag = "[dry] " if dry else ""
        who = x.get("branch") or (f"#{x['issue']}" if x.get("issue") else x.get("key", ""))
        print(f"{tag}{x.get('repo', C.repo)} {who}: {x['action']}")
    return acts


