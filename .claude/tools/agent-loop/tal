def branch_exists_local(br: str) -> bool:
    return run(["git", "rev-parse", "--verify", "-q", f"refs/heads/{br}"],
               cwd=str(C.main_worktree), check=False).returncode == 0


def branch_exists_remote(br: str, cwd: Path | None = None) -> bool:
    p = run(["git", "ls-remote", "--exit-code", "--heads", "origin", br],
            cwd=str(cwd or C.main_worktree), check=False)
    if p.returncode == 0:
        return True
    if p.returncode == 2:      # --exit-code: 2 = không có ref khớp (404 thật)
        return False
    # #2300 — mạng/hạ tầng hỏng KHÔNG được đọc thành "branch không tồn tại":
    # caller (cmd_submodule) từng reset branch về origin/dev vì một cú ls-remote trượt.
    raise Fail(f"không đo được origin/{br} (ls-remote thoát {p.returncode}): "
               f"{(p.stderr or p.stdout).strip()[:200]}")


def worktree_attached(path: Path) -> bool:
    """#2177 — thư mục có THẬT là toplevel của một worktree git không.

    Một thư mục dưới `.claude/worktrees/` mà đăng ký git đã bị prune (thư mục
    còn, entry mất) vẫn `cd` vào được, và mọi lệnh git chạy từ đó **im lặng**
    giải về repo cha — `git rev-parse --show-toplevel` khi ấy trả về gốc repo
    chính, không phải chính thư mục. So hai đường dẫn là phân biệt được."""
    top = run(["git", "rev-parse", "--show-toplevel"], cwd=str(path), check=False)
    if getattr(top, "returncode", 1) != 0 or not (top.stdout or "").strip():
        return False
    try:
        return Path(top.stdout.strip()).resolve() == Path(path).resolve()
    except OSError:
        return False


def worktree_unmerged_content(wt: Path, base: str,
                              merged_head_sha: str | None = None,
                              rev: str = "HEAD") -> str | None:
    """#2674 — `rev` còn giữ NỘI DUNG nào chưa có ở `origin/<base>` không?

    `wt` là thư mục git để CHẠY LỆNH trong đó (worktree, hoặc repo chính);
    `rev` là thứ được HỎI. Mặc định `HEAD` = câu hỏi cũ về worktree.

    #2993 thêm `rev` vì hai vật khác nhau: trước `DELETE refs/heads/X` thì thứ
    sắp mất là **ref X**, không phải cây làm việc. Worktree sạch mà ref remote
    còn mang commit là chuyện thường (reset, hoặc đẩy xong rồi dọn) — và trên
    máy KHÔNG có worktree thì câu hỏi cũ không trả lời được gì cả.

    Trả về lý do (chuỗi) khi CÒN, `None` khi không còn gì để mất.

    Phép đo cũ là `git log origin/<base>..HEAD`, tức **quan hệ tổ tiên theo SHA**.
    Repo này merge bằng **squash**: commit của nhánh bị viết lại thành một commit
    MỚI trên base với SHA khác, nên commit cũ KHÔNG BAO GIỜ là tổ tiên của base.
    Vòng lặp gọi hàm này chỉ duyệt PR **đã merge**, nên rào cũ bắn trúng 100%
    số worktree nó gặp — nó chưa từng nhả được cái nào (6 worktree tích lại,
    mỗi cái mang nguyên một lượt `setup`).

    Ý định của #2300 A12 giữ nguyên — commit đã commit nhưng CHƯA push không
    dính `git status --porcelain`, và `branch -D` trong `remove_worktree` là bản
    sao cuối cùng. Đổi phép đo, không đổi mục tiêu: hỏi về NỘI DUNG.

    Hai tầng, và mọi đường lỗi đều lệch về phía **GIỮ** (giữ nhầm tốn đĩa; xoá
    nhầm mất mã):

    1. `git cherry origin/<base> HEAD` — dòng `-` = patch đã có ở upstream, kể
       cả khi SHA khác. Bắt trọn ca squash, tức phần lớn.
    2. Còn dòng `+` thì hỏi CÓ CHIỀU: HEAD có dòng nào origin/<base> chưa có
       không (`git diff --numstat origin/<base> HEAD` — cột added). So đối xứng
       `git diff --quiet A B` từng giữ worktree mãi khi base đi tiếp: worktree
       già, origin mới hơn, DIFF vẫn bật dù HEAD không mang gì độc nhất (#2782
       ca #2689). added>0 ⇒ giữ. Binary/không đọc được ⇒ giữ (fail-closed).

       Nhưng added==0 KHÔNG đủ để nhả (#2782 vòng 2): commit CHỈ XOÁ — `git rm`,
       gỡ dòng chết, đúng hình dạng chiến dịch #2188 — cũng ra added==0, mà
       deleted>0 của diff hai điểm thì mù chiều: nó vừa là "HEAD xoá mà base chưa
       nhận" (mất việc thật nếu nhả) vừa là "base đi tiếp, worktree chỉ TỤT"
       (#2689 — phải nhả). Phân xử bằng MERGE-BASE: `git diff --numstat
       <merge-base> HEAD -- <file>` đo thứ CHÍNH HEAD làm từ điểm rẽ nhánh.
       HEAD không xoá gì ⇒ deleted của diff hai điểm chỉ là base mới hơn ⇒ nhả;
       HEAD có tự tay xoá ⇒ GIỮ (fail-closed — bản xoá đã squash-merge VÀ base
       sửa tiếp cùng file cũng bị giữ oan, chấp nhận: giữ nhầm tốn đĩa, nhả
       nhầm là `branch -D` nuốt bản sao cuối cùng của một commit xoá-mã).
    """
    # #2792 — câu hỏi RẺ NHẤT và chắc chắn nhất, hỏi trước mọi phép so nội dung.
    #
    # Repo squash-merge nên `git cherry` không bao giờ rỗng, và phép so nội dung
    # bên dưới chỉ nhả khi MỌI file worktree chạm còn byte-identical với base —
    # điều đó hỏng ngay lần đầu có người sửa tiếp bất kỳ file nào trong số đó.
    # Cửa sổ dọn được vì thế hẹp bằng khoảng thời gian tới lần sửa kế tiếp, và
    # ngoài cửa sổ đó worktree bị giữ VĨNH VIỄN, kèm một dòng cảnh báo đọc như
    # "có người đang làm dở" về việc đã ship xong (#2689).
    #
    # Nếu HEAD bằng đúng sha GitHub ghi là đã merge thì không có gì để mất: bản
    # sao ấy đang ở remote. Chỉ nhả khi KHỚP TUYỆT ĐỐI — merged nhưng HEAD có
    # commit thêm sau đó thì phần thêm chưa ở đâu cả, phải đi tiếp đường cũ.
    if merged_head_sha:
        head = run(["git", "rev-parse", rev], cwd=str(wt), check=False)
        if getattr(head, "returncode", 1) == 0 and (head.stdout or "").strip() == merged_head_sha.strip():
            return None

    cherry = run(["git", "cherry", f"origin/{base}", rev], cwd=str(wt), check=False)
    if getattr(cherry, "returncode", 1) != 0:
        # Không đo được KHÁC đo ra "sạch" (#2300). origin/<base> chưa fetch, HEAD
        # detached, repo hỏng — mọi thứ ở đây là lý do để giữ.
        err = (cherry.stderr or cherry.stdout or "").strip().splitlines()
        return f"không so được patch với origin/{base} ({err[0] if err else 'git cherry lỗi'})"

    pending = [ln.split()[1] for ln in cherry.stdout.splitlines()
               if ln.startswith("+") and len(ln.split()) > 1]
    if not pending:
        return None

    touched: list[str] = []
    for sha in pending:
        p = run(["git", "show", "--pretty=format:", "--name-only", sha], cwd=str(wt), check=False)
        if getattr(p, "returncode", 1) != 0:
            return f"không đọc được commit {sha[:8]} để so nội dung"
        for f in p.stdout.splitlines():
            if f.strip() and f.strip() not in touched:
                touched.append(f.strip())

    if not touched:
        # Commit rỗng (hoặc chỉ đổi mode/merge) — không có nội dung nào để mất.
        return None

    unique = []
    merge_base: str | None = None
    for f in touched:
        ns = run(["git", "diff", "--numstat", f"origin/{base}", rev, "--", f],
                 cwd=str(wt), check=False)
        if getattr(ns, "returncode", 1) != 0:
            return f"không so được nội dung {f} với origin/{base}"
        line = (ns.stdout or "").strip().splitlines()
        if not line:
            continue
        parts = line[0].split("	")
        if len(parts) < 3 or parts[0] == "-":
            unique.append(f)          # binary / không đọc được → fail-closed GIỮ
            continue
        try:
            added, deleted = int(parts[0]), int(parts[1])
        except ValueError:
            unique.append(f)
            continue
        if added > 0:
            unique.append(f)
            continue
        if deleted == 0:
            continue
        # added==0, deleted>0 — diff hai điểm mù chiều (#2782 vòng 2): hỏi
        # merge-base xem CHÍNH HEAD có xoá gì từ điểm rẽ nhánh không.
        if merge_base is None:
            mb = run(["git", "merge-base", f"origin/{base}", rev],
                     cwd=str(wt), check=False)
            if getattr(mb, "returncode", 1) != 0 or not (mb.stdout or "").strip():
                return f"không tìm được merge-base với origin/{base} để phân xử {f}"
            merge_base = mb.stdout.strip()
        hs = run(["git", "diff", "--numstat", merge_base, rev, "--", f],
                 cwd=str(wt), check=False)
        if getattr(hs, "returncode", 1) != 0:
            return f"không so được {f} với merge-base của origin/{base}"
        hline = (hs.stdout or "").strip().splitlines()
        if not hline:
            continue                  # HEAD không đổi gì file này — chỉ base mới hơn ⇒ nhả
        hparts = hline[0].split("	")
        if len(hparts) < 3 or hparts[0] == "-":
            unique.append(f)          # binary → fail-closed GIỮ
            continue
        try:
            head_deleted = int(hparts[1])
        except ValueError:
            unique.append(f)
            continue
        if head_deleted > 0:
            unique.append(f)          # HEAD tự tay xoá — nhả là mất bản xoá (#2188)
    if not unique:
        return None
    return (f"còn {len(pending)} commit chưa tới origin/{base} và {len(unique)}/{len(touched)} "
            f"file mang nội dung origin/{base} chưa có ({', '.join(unique[:3])}"
            f"{'…' if len(unique) > 3 else ''})")


def assert_worktree_attached(path: Path):
    """Guard #2177: chặn mọi lệnh ghi trong một worktree mồ côi."""
    if worktree_attached(path):
        return
    raise Fail(
        f"WORKTREE MỒ CÔI: {path} — `git rev-parse --show-toplevel` không trỏ về chính "
        f"thư mục này, tức đăng ký git worktree đã mất trong khi thư mục còn nguyên. "
        f"Mọi lệnh git chạy từ đây sẽ IM LẶNG giải về repo cha (đã gây 4 sự cố ghi "
        f"nhầm cây chính trong một phiên, #2177). DỪNG — dời/xoá thư mục này rồi dựng "
        f"lại bằng `tal claim`.", 4)


def ensure_worktree(issue: int, branch: str) -> Path:
    assert_branch_name(branch, "umbrella")
    root = C.main_worktree
    path = C.worktrees_dir / f"issue-{issue}"     # tên worktree = tên branch, luôn khớp
    path.parent.mkdir(parents=True, exist_ok=True)
    run(["git", "fetch", "-q", "--prune", "origin"], cwd=str(root), check=False)

    if path.exists():
        # #2177 — thư mục còn nhưng git không nhận: KHÔNG được tái sử dụng. Thiếu
        # rào này thì rev-parse bên dưới đọc HEAD của REPO CHA, và nếu cha tình cờ
        # đứng đúng branch, worktree mồ côi được trao cho session như đồ thật.
        assert_worktree_attached(path)
        cur = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=str(path), check=False)
        if cur.returncode == 0 and cur.stdout.strip() == branch:
            exclude_lease(path)
            return path
        raise Fail(f"{path} đã tồn tại nhưng đang ở branch {cur.stdout.strip()!r}, không phải {branch}")

    if branch_exists_local(branch):
        run(["git", "worktree", "add", str(path), branch], cwd=str(root))
    elif branch_exists_remote(branch):
        run(["git", "worktree", "add", "-b", branch, str(path), f"origin/{branch}"], cwd=str(root))
    else:
        run(["git", "worktree", "add", "-b", branch, str(path), f"origin/{BASE_BRANCH}"], cwd=str(root))
    exclude_lease(path)
    return path


def exclude_lease(path: Path):
    """Thẻ lease không được lọt vào commit — ghi vào info/exclude RIÊNG của worktree,
    để không phụ thuộc việc .gitignore đã commit hay chưa."""
    # Worktree phụ KHÔNG có info/exclude riêng — git đọc từ common dir. Ghi sai chỗ là
    # luật ignore không có tác dụng và .tal-lease.json lọt vào `git status`.
    gd = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
             cwd=str(path), check=False).stdout.strip()
    if not gd:
        return
    ex = Path(gd) / "info" / "exclude"
    ex.parent.mkdir(parents=True, exist_ok=True)
    cur = ex.read_text() if ex.is_file() else ""
    if LEASE_FILE not in cur:
        ex.write_text(cur.rstrip("\n") + f"\n{LEASE_FILE}\n")


def remove_orphan_tree(path: Path) -> bool:
    """Xoá cây đã tách khỏi git, kể cả ACL `deny delete` do Composer để lại.

    `shutil.rmtree(ignore_errors=True)` từng vừa bỏ sót vỏ `vendor/` trên macOS,
    vừa khai thành công. Gỡ ACL trước, bắt lỗi, rồi đọc ngược lại đường dẫn — chỉ
    khi nó thật sự biến mất mới trả True (#2364).
    """
    if sys.platform == "darwin":
        run(["chmod", "-RN", str(path)], cwd=str(path.parent), check=False)
    try:
        shutil.rmtree(path)
    except OSError as e:
        print(f"  ⚠️ không xoá được {path}: {e}")
    if path.exists():
        print(f"  ⚠️ đã chạy xoá nhưng {path} vẫn còn — KHÔNG báo thành công (#2364).")
        return False
    return True


def cleanup_orphan_worktrees(dry: bool = False) -> list[dict]:
    """Thu gom cả vỏ `.orphan-*` rò từ những lượt gc trước."""
    acts = []
    for path in sorted(C.worktrees_dir.glob("issue-*.orphan-*")):
        m = re.match(r"issue-(\d+)\.orphan-", path.name)
        issue = int(m.group(1)) if m else None
        if dry:
            acts.append({"issue": issue, "action": f"xoá vỏ orphan {path.name}"})
        elif remove_orphan_tree(path):
            acts.append({"issue": issue, "action": f"xoá vỏ orphan {path.name} (đã kiểm biến mất)"})
        else:
            acts.append({"issue": issue, "action": f"KHÔNG xoá được vỏ orphan {path.name} — xem cảnh báo"})
    return acts


def listed_worktrees() -> list[tuple[Path, str | None]]:
    """Parse `git worktree list --porcelain` → (path, branch-or-None).

    #2710 — gc từng chỉ nhìn `.claude/worktrees/issue-N`. Worktree đứng chỗ khác
    (`~/Herd/dxs-product-issue-2696`, `/private/tmp/rev-*`) thì nó khai "đã xoá"
    trong khi `git worktree list` vẫn còn.
    """
    out = run(["git", "worktree", "list", "--porcelain"],
              cwd=str(C.main_worktree), check=False)
    if getattr(out, "returncode", 1) != 0:
        return []
    items: list[tuple[Path, str | None]] = []
    path = None
    branch = None
    def flush():
        nonlocal path, branch
        if path is not None:
            items.append((Path(path), branch))
        path = None
        branch = None
    for line in (out.stdout or "").splitlines():
        if line.startswith("worktree "):
            flush()
            path = line.split(" ", 1)[1]
        elif line.startswith("branch "):
            ref = line.split(" ", 1)[1]
            branch = ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else ref
        elif line == "":
            flush()
    flush()
    return items


def worktree_paths_for_issue(issue: int) -> list[Path]:
    """Mọi worktree đang checkout `issue-N`, không đoán thư mục (#2710)."""
    want = f"issue-{issue}"
    found: list[Path] = []
    seen: set[str] = set()
    for p, br in listed_worktrees():
        if br != want:
            continue
        key = str(p)
        try:
            key = str(p.resolve())
        except OSError:
            pass
        if key not in seen:
            found.append(p)
            seen.add(key)
    conventional = C.worktrees_dir / want
    if conventional.exists():
        key = str(conventional)
        try:
            key = str(conventional.resolve())
        except OSError:
            pass
        if key not in seen:
            found.append(conventional)
    return found


def remove_worktree(issue: int) -> bool:
    """Xoá worktree của một issue — KHÔNG tin `git worktree remove`.

    Cùng hình dạng lỗi đã sửa ở `drop_batch_worktree` (#1355), nhưng chỗ này bị
    bỏ sót: `remove --force` từ chối trong đúng những ca cây dễ nặng nhất
    (submodule đã init bên trong, `vendor/`/`node_modules` untracked to), rồi
    `check=False` nuốt thất bại, và `prune` chỉ bỏ ĐĂNG KÝ chứ không xoá thư mục.

    Hậu quả quan sát được: `tal gc` in "xoá worktree + branch cục bộ (PR đã
    merge)" **mỗi lần chạy**, mãi không hội tụ, vì thư mục vẫn còn nguyên (#1349).
    Nhẹ hơn ca `_batch` — ở đó lần chạy sau chết hẳn — nhưng cùng một gốc: một
    lệnh báo đã làm xong việc nó chưa làm.

    #2177 — thứ tự bên trong là DỜI trước, XOÁ sau, và đó là điểm mấu chốt.
    `rmtree` thẳng vào chỗ cũ mà chết dở dang (permission, hardlink vendor) thì
    có thể mất `.git` trong khi phần còn lại của cây vẫn đứng; `prune` sau đó gỡ
    đăng ký ⇒ **worktree mồ côi**: `cd` vào vẫn được, và mọi lệnh git từ đó im
    lặng giải về repo cha — 4 sự cố ghi trên cây chính trong một phiên. Nên:
    (1) dời nguyên thư mục sang `<tên>.orphan-<ts>` — git hết trỏ vào đường dẫn
    cũ, prune từ đây là an toàn; (2) rồi mới rmtree bản đã dời, xoá sót cũng vô
    hại vì tên nó tự khai là rác. Không dời được thì GIỮ NGUYÊN đăng ký (không
    prune, không xoá branch) và trả False — worktree nửa-chết tệ hơn worktree
    chưa dọn.
    """
    paths = worktree_paths_for_issue(issue)
    root = str(C.main_worktree)
    cleaned = True
    for path in paths:
        # #2782 vòng 2 — `worktree_paths_for_issue` hỏi `git worktree list` (#2710)
        # nên khi branch `issue-N` đang checkout ở CÂY CHÍNH, chính cây chính lọt
        # vào danh sách. `git worktree remove` từ chối ("is a main working tree")
        # nhưng nhánh orphan-fallback bên dưới thì KHÔNG hỏi lại — nó rename cả
        # repo thành `<tên>.orphan-<ts>` rồi rmtree: mất toàn bộ repo, mọi branch
        # cục bộ và sổ đăng ký worktree. Chặn TRƯỚC mọi hành động, và không bao
        # giờ khai thành công.
        try:
            hits_main = path.resolve() == C.main_worktree.resolve()
        except OSError:
            hits_main = path == C.main_worktree
        if hits_main:
            print(f"  ⚠️ #{issue}: branch issue-{issue} đang checkout ở CÂY CHÍNH "
                  f"{path} — tal KHÔNG xoá cây chính (#2782 vòng 2). Chuyển cây "
                  f"chính sang branch khác rồi chạy lại `tal gc`.", file=sys.stderr)
            return False
        if path.exists():
            r = run(["git", "worktree", "remove", "--force", str(path)], cwd=root, check=False)
            if getattr(r, "returncode", 1) != 0:
                err = (getattr(r, "stderr", None) or getattr(r, "stdout", None) or "").strip()
                if err:
                    print(f"  ⚠️ #{issue}: git worktree remove {path}: {err}")
        if path.exists():
            orphan = path.with_name(f"{path.name}.orphan-{now().strftime('%Y%m%dT%H%M%SZ')}")
            try:
                path.rename(orphan)
            except OSError as e:
                print(f"  ⚠️ #{issue}: không dời được {path} ({e}) — GIỮ NGUYÊN đăng ký "
                      f"git worktree, không prune, không xoá branch (#2177). Dọn tay rồi "
                      f"chạy lại `tal gc`.")
                return False
            if not remove_orphan_tree(orphan):
                print(f"  ⚠️ #{issue}: xoá không hết, phần còn lại nằm ở {orphan} — "
                      f"git không còn trỏ vào đó; `tal gc` sẽ thử lại lượt sau.")
                cleaned = False
    run(["git", "worktree", "prune"], cwd=root, check=False)
    br = f"issue-{issue}"
    if branch_exists_local(br):
        r = run(["git", "branch", "-D", br], cwd=root, check=False)
        err = (getattr(r, "stderr", None) or getattr(r, "stdout", None) or "").strip()
        still = branch_exists_local(br)
        if getattr(r, "returncode", 1) != 0 or still:
            print(f"  ⚠️ #{issue}: không xoá được branch {br}"
                  + (f": {err}" if err else "")
                  + " — KHÔNG khai đã xoá (#2710).")
            return False
    leftover = worktree_paths_for_issue(issue)
    if leftover:
        print(f"  ⚠️ #{issue}: worktree vẫn còn: "
              f"{', '.join(str(p) for p in leftover)} — KHÔNG khai đã xoá (#2710).")
        return False
    return cleaned


def push_with_lease(cwd, branch: str, set_upstream: bool = True):
    """#2300 F5 — force-with-lease theo GIÁ TRỊ, không theo remote-tracking ref.

    `--force-with-lease` trần tin remote-tracking ref cục bộ, mà `git fetch
    --prune origin` (chạy ở MỌI lần claim, chung common-gitdir cho mọi worktree)
    làm tươi ref đó cho TẤT CẢ branch — lease thoái hoá thành `--force`, và một
    commit người khác vừa push lên `origin/issue-N` bị đè không một lời. Ghim
    giá trị: chỉ đè khi remote đang ở đúng sha mình vừa đọc; ls-remote hỏng thì
    expect-trống — push sẽ fail nếu branch tồn tại (hướng an toàn)."""
    r = run(["git", "ls-remote", "origin", f"refs/heads/{branch}"], cwd=str(cwd), check=False)
    remote_sha = ""
    if getattr(r, "returncode", 1) == 0 and (getattr(r, "stdout", "") or "").strip():
        remote_sha = r.stdout.split()[0]
    lease = f"--force-with-lease={branch}:{remote_sha}"
    args = ["git", "push", lease] + (["-u"] if set_upstream else []) + ["origin", branch]
    run(args, cwd=str(cwd))


def submodules() -> dict[str, dict]:
    txt = run(["git", "config", "-f", str(C.main_worktree / ".gitmodules"),
               "--get-regexp", r"^submodule\..*"], check=False).stdout
    subs: dict[str, dict] = {}
    for line in txt.splitlines():
        k, _, v = line.partition(" ")
        m = re.match(r"submodule\.(.+)\.(path|url|branch)$", k)
        if m:
            subs.setdefault(m.group(1), {})[m.group(2)] = v.strip()
    for name, s in subs.items():
        s["name"] = name
        s["repo"] = re.sub(r"(\.git)?$", "", re.sub(r"^.*[:/]([^/:]+/[^/]+?)$", r"\1", s.get("url", "")))
        s.setdefault("branch", "dev")   # .gitmodules là căn cứ, KHÔNG dùng default branch
    return subs


def cmd_submodule(a):
    st = do_assert(quiet=True)
    wt = Path(st["worktree"])
    subs = submodules()
    match = [s for s in subs.values() if s.get("path") == a.path or s["name"] == a.path]
    if not match:
        raise Fail(f"không có submodule {a.path!r}; có: {', '.join(sorted(s['path'] for s in subs.values()))}")
    s = match[0]
    p = wt / s["path"]
    run(["git", "submodule", "update", "--init", "--", s["path"]], cwd=str(wt))
    run(["git", "fetch", "-q", "origin"], cwd=str(p), check=False)
    br = f"issue-{st['issue']}"
    base = s["branch"]
    target = f"origin/{br}" if branch_exists_remote(br, p) else f"origin/{base}"
    # #2300 F1 — `checkout -B` là RESET: chạy lại lệnh này khi branch local đang
    # ôm commit chưa push từng làm commit thành dangling, exit 0. Có commit không
    # nằm trong đích ⇒ checkout GIỮ NGUYÊN, không reset.
    loc = run(["git", "rev-parse", "--verify", "-q", br], cwd=str(p), check=False)
    extra = ""
    if loc.returncode == 0:
        extra = run(["git", "log", "--oneline", f"{target}..{br}"],
                    cwd=str(p), check=False).stdout.strip()
    if extra:
        run(["git", "checkout", br], cwd=str(p))
        warn(f"{s['path']}: branch {br} có {len(extra.splitlines())} commit chưa nằm trong "
             f"{target} — checkout giữ nguyên, KHÔNG reset (#2300). Push bằng `tal submodule-pr`.")
    else:
        run(["git", "checkout", "-B", br, target], cwd=str(p))
    out = {"path": str(p), "repo": s["repo"], "branch": br, "base": base}
    if a.json:
        return emit(out, True)
    print(f"submodule {s['path']} → {p}\nrepo {s['repo']}, branch {br} từ origin/{base}")
    print(f"LƯU Ý: PR của submodule nhắm `{base}` (theo .gitmodules), KHÔNG nhắm default branch.")
    return out


def cmd_submodule_pr(a):
    st = do_assert(quiet=True)
    wt = Path(st["worktree"])
    subs = submodules()
    match = [s for s in subs.values() if s.get("path") == a.path or s["name"] == a.path]
    if not match:
        raise Fail(f"không có submodule {a.path!r}")
    s = match[0]
    p = wt / s["path"]
    br, base, repo = f"issue-{st['issue']}", s["branch"], s["repo"]

    dirty = run(["git", "status", "--porcelain"], cwd=str(p)).stdout.strip()
    if dirty:
        raise Fail(f"{s['path']} còn thay đổi chưa commit:\n{dirty}")
    push_with_lease(p, br)

    existing = gh_json_strict(["pr", "list", "-R", repo, "--head", br, "--json", "number,url"],
                              what=f"PR hiện có của {repo}#{br}")
    if existing:
        pr = existing[0]
        # #2300 F4 — bản sao #1335 từng nằm ở đây: PR con tồn tại thì --title/
        # --body-file bị NUỐT im lặng, thân PR kẹt ở vòng 1.
        if a.title or a.body_file:
            args = ["pr", "edit", str(pr["number"]), "-R", repo]
            if a.title:
                args += ["--title", a.title]
            body = Path(a.body_file).read_text() if a.body_file else None
            if body is not None:
                args += ["--body-file", "-"]
            gh(args, stdin=body)
            print(f"  · {repo}#{pr['number']}: đã CẬP NHẬT {'title ' if a.title else ''}"
                  f"{'body' if body is not None else ''} (#1335)")
    else:
        title = a.title or f"fix: #{st['issue']} ({s['path']})"
        body = (Path(a.body_file).read_text() if a.body_file else
                f"Phần {s['path']} của godx-jp/{C.repo.split('/')[-1]}#{st['issue']}.\n\n"
                f"Umbrella PR sẽ bump pointer sau khi PR này merge.")
        out = gh(["pr", "create", "-R", repo, "--base", base, "--head", br,
                  "--title", title, "--body", body]).stdout.strip()
        pr = {"url": out, "number": int(out.rstrip("/").split("/")[-1])}

    led, cid, _ = ledger_read(st["issue"])
    led.setdefault("sub_prs", {})[s["path"]] = {"repo": repo, "pr": pr["number"], "branch": br}
    ledger_write(led, cid, f"submodule PR {repo}#{pr['number']} ({s['path']})")
    sha = run(["git", "rev-parse", "HEAD"], cwd=str(p)).stdout.strip()
    print(f"{repo}#{pr['number']} → {pr.get('url','')}\nsha {sha[:12]} — nhớ bump pointer ở umbrella rồi commit.")
    return {"repo": repo, "pr": pr["number"], "sha": sha}


def auto_submodule_ritual(wt: Path, issue: int) -> list[dict]:
    """Làm TOÀN BỘ nghi thức submodule, tự động. Agent chỉ cần commit rồi `tal pr`.

    Vì sao là SCRIPT chứ không phải luật viết trong skill: luật viết ra
    có 161 dòng mô tả đúng nghi thức này, kèm bảng, kèm ví dụ — và nó **vẫn bị
    miss**. Một thay đổi gỡ tunnel sửa thẳng file trong 3 submodule, không branch,
    không PR, vì người viết chỉ nhớ "sửa file" chứ không nhớ nghi thức (#1438).

    Thêm dòng thứ 162 không sửa được chuyện đó. Thứ sửa được là **bỏ luôn cơ hội
    miss**: dò submodule bị chạm → tạo branch → push → mở PR → ghi ledger, không
    còn thứ tự nào để nhớ và không còn bước nào để quên.

    Ranh giới cố ý KHÔNG tự động: **nội dung commit**. Còn thay đổi chưa commit thì
    DỪNG và nói rõ — đoán hộ thông điệp commit của người là đoán sai.
    """
    done: list[dict] = []
    br = f"issue-{issue}"
    run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=str(wt), check=False)

    for s in submodules().values():
        path, repo, base = s["path"], s.get("repo"), s["branch"]
        p = wt / path
        if not (p / ".git").exists() or not repo:
            continue

        def ptr(ref: str) -> str | None:
            r = run(["git", "rev-parse", f"{ref}:{path}"], cwd=str(wt), check=False)
            return r.stdout.strip() if r.returncode == 0 else None

        dirty = run(["git", "status", "--porcelain"], cwd=str(p), check=False).stdout.strip()
        head = run(["git", "rev-parse", "HEAD"], cwd=str(p), check=False).stdout.strip()
        base_ptr = ptr(f"origin/{BASE_BRANCH}")
        # #2300 F3 — "đã chạm" so với pointer tại FORK-POINT, không phải pointer
        # dev HIỆN TẠI: dev bump submodule (realign làm ở mọi merge) từng biến một
        # repo con chỉ-init-để-đọc thành "đã chạm" với 3 lỗi giả chặn tal pr.
        mb0 = run(["git", "merge-base", "HEAD", f"origin/{BASE_BRANCH}"],
                  cwd=str(wt), check=False).stdout.strip()
        fork_ptr = ptr(mb0) if mb0 else None
        ref_ptr = fork_ptr if fork_ptr is not None else base_ptr
        if not dirty and head == ref_ptr:
            continue                                    # không chạm → bỏ qua

        if dirty:
            raise Fail(
                f"{path}: còn {len(dirty.splitlines())} file chưa commit.\n{dirty}\n"
                f"Commit TRONG repo con trước (nội dung commit là việc của bạn, tal "
                f"không đoán hộ), rồi chạy lại `tal pr` — phần còn lại nó tự làm.", 2)

        cur = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=str(p), check=False).stdout.strip()
        if cur != br:
            raise Fail(
                f"{path}: đang ở nhánh {cur!r}, commit của bạn nằm ngoài {br!r}.\n"
                f"Chạy `tal submodule {path}` TRƯỚC khi commit lần sau. Lần này: "
                f"`git -C {path} branch -f {br} HEAD && git -C {path} checkout {br}`.", 2)

        push_with_lease(p, br)
        existing = gh_json_strict(["pr", "list", "-R", repo, "--head", br, "--json", "number,url"],
                                  what=f"PR hiện có của {repo}#{br}")
        if existing:
            pr = existing[0]
            action = "đã có"
        else:
            out = gh(["pr", "create", "-R", repo, "--base", base, "--head", br,
                      "--title", f"fix: #{issue} ({path})",
                      "--body", f"Phần {path} của {C.repo}#{issue}.\n\n"
                                f"Pointer umbrella được căn lại lúc merge (#1435), "
                                f"PR này không cần bump gì."]).stdout.strip()
            pr = {"url": out, "number": int(out.rstrip("/").split("/")[-1])}
            action = "mở mới"
        print(f"  · {path}: {repo}#{pr['number']} ({action})")
        done.append({"path": path, "repo": repo, "pr": pr["number"], "branch": br})

    if done:
        led, cid, _ = ledger_read(issue)
        led.setdefault("sub_prs", {}).update(
            {d["path"]: {"repo": d["repo"], "pr": d["pr"], "branch": d["branch"]} for d in done})
        ledger_write(led, cid, "PR repo con: " + ", ".join(f"{d['repo']}#{d['pr']}" for d in done))
    return done


# ─────────────────────────────────────────────────────────────────────────────
# Cổng kiểm submodule — pointer sai là clone chết, phải chặn bằng máy
# ─────────────────────────────────────────────────────────────────────────────


def pointer_verdict(fork: str | None, base: str | None, committed: str | None, is_ancestor) -> str:
    """Quan hệ giữa pointer của PR và pointer của base — phần thuần tuý, để test được.

    `fork` = pointer tại điểm rẽ nhánh (merge-base). So với nó mới biết PR **có
    đụng** submodule này không; so với `base` (pointer hiện tại của dev) mà thôi
    thì mọi branch cũ đều bị tính là "đã đụng" chỉ vì dev đi tiếp.

    Trả về:
      skip       — chưa đủ dữ liệu (submodule mới, hoặc không đọc được pointer)
      untouched  — PR không đổi pointer; dev đi tiếp là chuyện của dev
      same       — PR bump tới đúng chỗ dev đang đứng
      descends   — PR đẩy pointer TIẾN LÊN từ chỗ dev đang đứng: merge là fast-forward
      behind     — pointer PR nằm phía sau pointer dev nhưng vẫn tới được
      diverged   — hai bên không bên nào với tới bên nào: merge sẽ conflict gitlink
    """
    if committed is None or base is None:
        return "skip"
    if committed == fork:
        return "untouched"
    if committed == base:
        return "same"
    if is_ancestor(base, committed):
        return "descends"
    if is_ancestor(committed, base):
        return "behind"
    return "diverged"


def submodule_audit(wt: Path, issue: int) -> list[dict]:
    """Soi từng submodule ĐÃ BỊ CHẠM. Mỗi phát hiện là một lỗi chặn PR.

    Bốn kiểu sai đều làm repo hỏng lặng lẽ, nên không có kiểu nào là cảnh báo suông:
      - pointer trỏ commit chưa push  → ai clone cũng chết ở `submodule update`
      - pointer khác HEAD của repo con → bump nhầm commit, hoặc quên bump
      - repo con không ở branch issue-N → mất dấu, không tra được PR nào sinh ra pointer
      - repo con còn thay đổi chưa commit → pointer chắc chắn sẽ lệch
    """
    problems: list[dict] = []
    br = f"issue-{issue}"
    run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=str(wt), check=False)

    for s in submodules().values():
        path = s["path"]
        p = wt / path
        if not (p / ".git").exists():
            continue                                    # chưa init = không chạm

        def ptr(ref: str) -> str | None:
            r = run(["git", "rev-parse", f"{ref}:{path}"], cwd=str(wt), check=False)
            return r.stdout.strip() if r.returncode == 0 else None

        committed, base = ptr("HEAD"), ptr(f"origin/{BASE_BRANCH}")
        head = run(["git", "rev-parse", "HEAD"], cwd=str(p), check=False).stdout.strip()
        cur_br = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=str(p), check=False).stdout.strip()
        dirty = run(["git", "status", "--porcelain"], cwd=str(p), check=False).stdout.strip()
        # #2300 F3 — mốc so sánh là pointer tại FORK-POINT (như pointer_verdict tự
        # dặn): so với pointer dev hiện tại thì dev cứ bump là mọi nhánh cũ thành
        # "đã chạm", audit đòi PR cho repo con không hề đụng.
        mb0 = run(["git", "merge-base", "HEAD", f"origin/{BASE_BRANCH}"],
                  cwd=str(wt), check=False).stdout.strip()
        fork0 = ptr(mb0) if mb0 else None
        refp = fork0 if fork0 is not None else base
        touched = bool(dirty) or (head and refp and head != refp) or (committed != refp)
        if not touched:
            continue

        def bad(kind: str, msg: str):
            problems.append({"path": path, "repo": s["repo"], "kind": kind, "msg": msg})

        if dirty:
            bad("dirty", f"{path}: còn {len(dirty.splitlines())} file chưa commit trong repo con")
        if cur_br != br:
            bad("branch", f"{path}: đang ở {cur_br!r}, phải là {br!r} — "
                          f"chạy `tal submodule {path}` để tạo/chuyển đúng branch")
        if committed != head:
            # #1353 đề xuất 3 + #1435 — POINTER KHÔNG CÒN BẮT BUỘC BUMP TRONG PR CODE.
            #
            # Luật cũ ("pointer phải bằng HEAD repo con, không thì QUÊN BUMP") biến
            # pointer thành ĐẦU VÀO CỦA MERGE: một ảnh chụp đông cứng lúc tạo nhánh.
            # Mà pointer là thứ bị đụng nhiều nhất, nên PR code kèm bump sẽ conflict
            # với MỌI PR bump khác — đo được: 3/5 PR trong một lô bị bỏ vì đúng chuyện
            # này, dù các commit repo con không đụng nhau một dòng nào.
            #
            # Giờ pointer được TÍNH LẠI ở lúc merge (`realign_pointers`, chạy sau khi
            # PR con merge), nên một pointer cũ ở đây là hợp lệ. Thứ TÍNH RA thì không
            # bao giờ conflict; thứ GHI VÀO NHÁNH thì luôn có thể.
            #
            # Vẫn chặn đúng thứ #1147 sinh ra để chặn: pointer KHÔNG với tới được.
            behind = committed and run(
                ["git", "merge-base", "--is-ancestor", committed, head], cwd=str(p), check=False
            ).returncode == 0
            if not committed:
                bad("pointer", f"{path}: commit đang push KHÔNG có gitlink nào cho {path}")
            elif behind:
                warn(f"{path}: pointer {committed[:12]} cũ hơn repo con ({head[:12]}) — "
                     f"KHÔNG chặn, nó sẽ được căn lại lúc merge. Muốn bump tay thì "
                     f"`git add {path} && git commit`")
            else:
                bad("pointer", f"{path}: pointer {committed[:12]} KHÔNG phải tổ tiên của "
                               f"{head[:12]} — đi trước hoặc đã rẽ nhánh, người clone không "
                               f"với tới được. Kiểm `git -C {path} log --oneline --graph "
                               f"{committed[:9]} {head[:9]}`")
        else:
            run(["git", "fetch", "-q", "origin", br], cwd=str(p), check=False)
            pushed = run(["git", "merge-base", "--is-ancestor", head, f"origin/{br}"],
                         cwd=str(p), check=False).returncode == 0
            if not pushed:
                bad("unpushed", f"{path}: pointer {head[:12]} CHƯA có trên origin/{br} — "
                                f"ai clone cũng chết. Chạy `tal submodule-pr {path}`")
        # Pointer của PR phải TỚI ĐƯỢC pointer của base. Phân kỳ ở đây là conflict
        # gitlink mà không máy nào giải hộ được — và nếu để lọt tới lúc merge thì nó
        # nổ hàng giờ sau, khi dev đã đi tiếp và không ai còn nhớ đã bump cái gì
        # (#1318 đúng kiểu đó). Bắt ngay lúc mở PR, lúc người viết còn nhớ (#1353).
        mb = run(["git", "merge-base", "HEAD", f"origin/{BASE_BRANCH}"], cwd=str(wt), check=False).stdout.strip()
        fork = ptr(mb) if mb else None
        run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=str(p), check=False)

        def sub_is_ancestor(a: str, b: str) -> bool:
            return run(["git", "merge-base", "--is-ancestor", a, b], cwd=str(p), check=False).returncode == 0

        if pointer_verdict(fork, base, committed, sub_is_ancestor) == "diverged":
            bad("diverged", f"{path}: pointer PR {committed[:12]} và pointer {BASE_BRANCH} {base[:12]} "
                            f"PHÂN KỲ — không bên nào với tới bên nào, merge sẽ conflict gitlink và "
                            f"máy không chọn hộ được. Chạy `git -C {path} log --oneline --graph "
                            f"{committed[:12]} {base[:12]}` rồi bump lại cho đúng hậu duệ")

        if s["repo"]:
            prs = gh_json(["pr", "list", "-R", s["repo"], "--head", br, "--state", "all",
                           "--json", "number,state,baseRefName"], default=[])
            if not prs:
                bad("no-pr", f"{path}: chưa có PR nào cho {br} ở {s['repo']} — "
                             f"chạy `tal submodule-pr {path}`")
            # PR con nhắm SAI BASE là cách con trỏ chết mà không ai thấy (#1465).
            # `customer-web#96` nhắm `info-customer`: PR merge, nhánh `issue-N` bị
            # `tal gc` xoá, và commit mà umbrella đang trỏ tới chỉ còn sống nhờ một
            # nhánh feature. Nhánh đó biến mất là MỌI CLONE MỚI hỏng ở
            # `submodule update`. Luật "PR con luôn nhắm dev" trước đây chỉ được
            # `submodule-pr` tôn trọng — PR mở tay thì không ai kiểm.
            want_base = s.get("branch") or BASE_BRANCH
            for pr_ in prs:
                b = pr_.get("baseRefName")
                # #2300 F6 — so với branch mà .gitmodules khai (chính là base
                # `submodule-pr` DÙNG để tạo PR); so cứng BASE_BRANCH của umbrella
                # là tal tự tạo PR ở base X rồi tự chặn chính PR đó.
                if b and b != want_base:
                    bad("wrong-base",
                        f"{path}: PR {s['repo']}#{pr_['number']} nhắm {b!r}, phải là "
                        f"{want_base!r} (theo .gitmodules). Merge vào nhánh khác thì commit "
                        f"mà umbrella trỏ tới không nằm trên {want_base} của repo con — xoá "
                        f"nhánh đó là mọi clone mới chết. Đổi base: "
                        f"`gh pr edit {pr_['number']} -R {s['repo']} --base {want_base}`")
    return problems


def cmd_submodule_check(a):
    st = do_assert(quiet=True)
    problems = submodule_audit(Path(st["worktree"]), st["issue"])
    if a.json:
        return emit({"issue": st["issue"], "problems": problems}, True)
    if not problems:
        print("submodule: không có vấn đề (hoặc không chạm submodule nào)")
        return 0
    print(f"submodule: {len(problems)} vấn đề CHẶN PR\n")
    for x in problems:
        print(f"  [{x['kind']}] {x['msg']}")
    return 1


# ─────────────────────────────────────────────────────────────────────────────
# PR umbrella + bàn giao review
# ─────────────────────────────────────────────────────────────────────────────


def with_issue_ref(body: str, group: list[int], closes: str) -> str:
    """Thân PR phải nhắc issue của nó — nhưng ĐỪNG ép `Closes`.

    Một PR làm xong một phần cố ý viết `Refs #N` để merge không đóng issue còn dở
    (đã dùng thật ở #1338 và #1312). Chèn `Closes` đè lên đó là đóng oan một việc
    chưa xong, nên chỉ chèn khi thân PR không nhắc issue nào của nhóm bằng bất kỳ
    từ khoá nào."""
    text = (body or "").rstrip()
    for n in group:
        if re.search(rf"\b(closes|close|closed|fixes|fix|fixed|resolves|resolve|resolved|refs|ref)\s+#{n}\b",
                     text, re.I):
            return text
    return (text + "\n\n" + closes).strip()


def cmd_pr(a):
    st = do_assert(quiet=True)           # fencing: chỉ chủ lease hợp lệ được ghi
    wt, lf = Path(st["worktree"]), lease_file()[1]
    issue, group, branch = lf["issue"], lf["group"], lf["branch"]

    cur = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=str(wt)).stdout.strip()
    assert_branch_name(cur, "worktree umbrella")
    if cur != branch:
        raise Fail(f"worktree đang ở branch {cur!r} nhưng lease là của {branch!r} — "
                   "quay về đúng branch của issue trước khi mở PR", 2)

    dirty = run(["git", "status", "--porcelain"], cwd=str(wt)).stdout.strip()
    if dirty and not a.allow_dirty:
        raise Fail(f"worktree còn thay đổi chưa commit:\n{dirty}")

    # Nghi thức submodule chạy TỰ ĐỘNG ở đây (#1438): dò repo con bị chạm → branch
    # `issue-N` → push → PR → ghi `sub_prs`. Agent không còn phải nhớ `tal submodule`
    # rồi `tal submodule-pr` cho từng repo, đúng thứ tự. Hai lệnh đó vẫn còn cho ca
    # đặc biệt, nhưng đường mặc định không cần tới chúng.
    if not a.skip_submodule_check:
        subs_opened = auto_submodule_ritual(wt, issue)
        if subs_opened:
            print(f"nghi thức submodule: {len(subs_opened)} repo con đã có PR")

    problems = submodule_audit(wt, issue)
    if problems and not a.skip_submodule_check:
        lines = "\n".join(f"  [{x['kind']}] {x['msg']}" for x in problems)
        raise Fail(
            f"CHẶN mở PR — {len(problems)} vấn đề submodule (pointer sai/quên bump là clone chết):\n"
            f"{lines}\nSửa xong rồi chạy lại. Chỉ dùng --skip-submodule-check nếu người yêu cầu.", 2
        )

    run(["git", "fetch", "-q", "origin", BASE_BRANCH], cwd=str(wt), check=False)
    ahead = run(["git", "rev-list", "--count", f"origin/{BASE_BRANCH}..HEAD"], cwd=str(wt)).stdout.strip()
    if ahead == "0":
        raise Fail(f"không có commit nào so với origin/{BASE_BRANCH} — chưa có gì để mở PR", 2)

    push_with_lease(wt, branch)

    # #2300 F9 — "PR đã tồn tại chưa" là phép đo cho quyết định create-vs-edit:
    # gh flake mà đọc thành "chưa có" là `pr create` trùng, lỗi trả về gây lạc hướng.
    existing = gh_json_strict(["pr", "list", "-R", C.repo, "--head", branch,
                               "--json", "number,url,state"], what=f"PR hiện có của {branch}")
    existing = [p for p in existing if p["state"] == "OPEN"]
    closes = "\n".join(f"Closes #{n}" for n in group)

    if existing:
        pr = existing[0]
        # #1335/#1348 — vòng SỬA luôn đi đường này, và trước đây nhánh này bỏ qua
        # `--body-file`/`--body`/`--title` trong im lặng: lệnh báo thành công, thân PR
        # kẹt ở vòng 1, reviewer đọc mô tả cũ rồi trả về một PR đã sửa. Cập nhật thật.
        if a.body_file or a.body:
            body = Path(a.body_file).read_text() if a.body_file else (a.body or "")
            gh(["pr", "edit", str(pr["number"]), "-R", C.repo, "--body-file", "-"],
               stdin=with_issue_ref(body, group, closes))
        if a.title:
            if not CONVENTIONAL.match(a.title):
                warn(f"tiêu đề PR không theo Conventional Commits: {a.title!r}")
            gh(["pr", "edit", str(pr["number"]), "-R", C.repo, "--title", a.title])
        # Bản mới làm MẤT HIỆU LỰC lần review trước — tháo nhãn pass khỏi PR, nếu không
        # nó sống sót và làm rào merge tưởng PR này đã được review.
        gh(["pr", "edit", str(pr["number"]), "-R", C.repo, "--remove-label", L_PASSED], check=False)
        gh(["pr", "comment", str(pr["number"]), "-R", C.repo, "-b",
            f"<!-- {REVIEW_MARKER}:push -->\nĐã đẩy bản sửa mới (epoch {st['epoch']}). "
            f"Nhãn `{L_PASSED}` đã được tháo — cần review lại."])
    else:
        title = a.title or issue_data(issue)["title"]
        if not CONVENTIONAL.match(title):
            warn(f"tiêu đề PR không theo Conventional Commits: {title!r}")
        body = Path(a.body_file).read_text() if a.body_file else (a.body or "")
        url = gh(["pr", "create", "-R", C.repo, "--base", BASE_BRANCH, "--head", branch,
                  "--title", title, "--body", with_issue_ref(body, group, closes)]).stdout.strip()
        pr = {"number": int(url.rstrip("/").split("/")[-1]), "url": url}

    # #1639 — cổng TÀI LIỆU chạy TRƯỚC khi nhả lease.
    #
    # Trước bản này `tal pr` nhả lease ngay khi PR mở, nên bước 6 của skill
    # `issue-work` (`tal docs-check <PR>` sau `tal pr`) rơi vào một worktree đã bị
    # hook chặn ghi: phát hiện được khoảng trống mà không sửa được. Cách duy nhất
    # để sửa trong lượt là `tal claim --force`, tức lách một cổng đang chặn —
    # luật cấm. Kết cục thực tế: mọi phát hiện của docs-check phải đi vòng qua
    # một lượt review, kể cả khi nó chỉ là thêm một đoạn vào CLAUDE.md.
    #
    # CHỈ các luật trong `docsRules` mới GIỮ lease. Hai kiểm chung ("đổi N file
    # code mà không chạm .md nào") kêu ở gần như mọi PR — biến chúng thành rào là
    # dạy người ta bỏ qua rào.
    docs_unavailable = None
    try:
        doc_gaps = docs_gate(pr["number"])
    except DocsFilesUnavailable as e:
        docs_unavailable = str(e)
        doc_gaps = []
        if not a.docs_ok:
            raise Fail(
                f"PR #{pr['number']} ĐÃ MỞ nhưng lease VẪN GIỮ — {docs_unavailable}\n\n"
                "Thử lại khi API lành. Nếu thay đổi này thật sự không cần kiểm docs: "
                "`tal pr --docs-ok` — lời khẳng định và việc cổng KHÔNG chạy sẽ được "
                "ghi vào PR để người review đọc được.", 2
            )
    if doc_gaps and not a.docs_ok:
        lines = "\n".join(
            f"  ✘ {' , '.join(g['expect'])}\n      vì: {g['why']}\n"
            f"      kích hoạt bởi: {', '.join(g['triggered_by'])}"
            for g in doc_gaps
        )
        raise Fail(
            f"PR #{pr['number']} ĐÃ MỞ nhưng lease VẪN GIỮ — {len(doc_gaps)} khoảng trống tài liệu:\n"
            f"{lines}\n\n"
            "Sửa tài liệu rồi commit và chạy lại `tal pr` (PR cập nhật tại chỗ).\n"
            "Nếu thay đổi này thật sự không cần doc: `tal pr --docs-ok` — lời khẳng định "
            "đó được ghi vào PR để người review đọc được.", 2
        )
    if doc_gaps and a.docs_ok:
        waived = ", ".join(" , ".join(g["expect"]) for g in doc_gaps)
        gh(["pr", "comment", str(pr["number"]), "-R", C.repo, "-b",
            f"<!-- {REVIEW_MARKER}:docs-waived -->\n"
            f"**Tài liệu: bỏ qua có chủ ý (`--docs-ok`)** — {len(doc_gaps)} luật kích hoạt "
            f"mà không cập nhật: {waived}.\n\n"
            "Người review: đây là lời khẳng định của session code rằng thay đổi này không "
            "đổi quy ước hay hành vi nào cần ghi lại. Nếu nó có đổi, đây là chỗ chặn."],
           check=False)
        warn(f"bỏ qua {len(doc_gaps)} khoảng trống tài liệu theo --docs-ok (đã ghi vào PR)")
    if docs_unavailable and a.docs_ok:
        gh(["pr", "comment", str(pr["number"]), "-R", C.repo, "-b",
            f"<!-- {REVIEW_MARKER}:docs-unchecked -->\n"
            "**Tài liệu: cổng KHÔNG chạy, bỏ qua có chủ ý (`--docs-ok`).**\n\n"
            f"{docs_unavailable}\n\n"
            "Session code khẳng định thay đổi này không cần cập nhật tài liệu dù không "
            "đo được `docsRules`. Người review phải đối chiếu claim này trước khi pass."],
           check=False)
        warn("cổng docs không chạy; --docs-ok đã được ghi vào PR")

    led, cid, _ = ledger_read(issue)
    led["pr"] = pr["number"]
    led["state"] = "review"
    led["lease"] = None
    # #2300 — attribution bền: trường `coders` không bị cắt như history.
    _sid8 = str(lf.get("session", ""))[:8]
    if _sid8 and _sid8 not in led.setdefault("coders", []):
        led["coders"].append(_sid8)
    # #2300 F10 — xoá REF trước, ghi SỔ sau: ref là nguồn chân lý CAS. Thứ tự cũ
    # (sổ lease=None rồi mới xoá ref) mà crash giữa hai bước là "sổ nói đã nhả,
    # ref còn sống" — mọi claim sau BUSY oan tới khi orphan-grace dọn. Chiều mới
    # crash giữa chừng chỉ để lại ref-đã-mất + sổ-còn-lease: lease_expired sẽ tự
    # giải theo TTL, không chặn ai.
    for k in lf["keys"]:
        ref_delete(k)
        local_unlock(k)
    ledger_write(led, cid, f"PR #{pr['number']} mở, bàn giao review (worker session {lf['session'][:8]}…)")
    # `tal pr` tự tháo lease chứ không đi qua release() — vẫn phải đánh dấu thẻ, để
    # worktree giữ lại cho vòng sửa sau không rơi vào trạng thái "không ai canh".
    mark_lease_released(wt)
    for n in group:
        set_state_labels(n, {L_REVIEWING, L_AWAIT})

    print(f"PR #{pr['number']} {pr.get('url','')}\nđã nhả lease, #{issue} → chờ review")
    print("worktree giữ lại để vòng sửa sau dùng lại; `tal gc` sẽ dọn khi PR merge.")
    return {"pr": pr["number"], "issue": issue}


