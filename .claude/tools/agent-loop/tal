def rank(it: dict) -> tuple:
    names = {l["name"] for l in it["labels"]}
    fix_first = 0 if L_CHANGES in names else 1
    sev = min([SEVERITY_RANK.get(x, 9) for x in names] + [9])
    return (fix_first, sev, it["number"])


# Từ khoá đóng issue mà GitHub công nhận. Dùng chung với `with_issue_ref()` —
# nó CỐ Ý chấp nhận cả `refs`/`ref` (PR làm một phần), nhưng ở đây thì KHÔNG:
# `Refs #N` nghĩa là "có chạm, chưa xong", tức issue vẫn còn việc và vẫn phải
# nằm trong hàng đợi. Chỉ từ khoá ĐÓNG mới rút nó ra.
CLOSING_KEYWORDS = r"clos(?:e|es|ed)|fix(?:|es|ed)|resolv(?:e|es|ed)"


def shipped_scope(led: dict, issue: int, pr_body: str | None) -> list[int]:
    """Mọi issue mà một PR đã merge thực sự ship (#2789).

    `led["group"]` là cơ chế cho parent/sub-issue. Nhưng từ #2178, gom CỤM —
    nhiều issue cùng vùng file → MỘT worktree, MỘT branch, MỘT PR — là MẶC ĐỊNH,
    và các issue trong cụm chỉ được nối với nhau bằng dòng `Closes #N` trong
    thân PR. Không đường nào đọc chúng lúc ship.

    Hậu quả đo được ở PR #2787: ledger ghi `"group": [2782]`, nên 6/7 issue đã
    ship giữ nguyên `agent:ready` và rơi lại vào hàng đợi — session kế tiếp nhặt
    một việc đã xong và làm lại từ đầu, đúng lỗi đắt nhất của vai này.

    `Closes` cũng không tự cứu: base là `dev` còn default branch là `main`, nên
    GitHub KHÔNG BAO GIỜ tự đóng (#1384).

    Ba cơ chế đều đúng phần của mình; cái rơi xuống khe là toàn bộ cụm. Hợp nhất
    ở đây, rồi vẫn để `closable()` phân xử TỪNG cái ở call-site (#1571 — gắn
    nhãn và đóng phải chịu chung điều kiện).
    """
    scope = {int(n) for n in led.get("group", [issue]) if n}
    scope |= issues_closed_by(pr_body)
    scope.add(int(issue))
    return sorted(scope)


def merged_pr_head_sha(branch: str) -> str | None:
    """SHA đầu branch của PR đã MERGED cho `branch`, hoặc None (#2792).

    Dùng cho gc: nếu HEAD của worktree BẰNG ĐÚNG sha mà GitHub ghi là đã merge
    thì mọi commit trên branch nằm trong bản đã merge — theo định nghĩa bản sao
    đó đang ở remote, nên `branch -D` không thể nuốt bản sao cuối cùng. Đây là
    phép so sha KHỚP TUYỆT ĐỐI, không phải suy đoán nội dung.

    Trả None khi không hỏi được, khi không có PR, hoặc khi PR chưa merge — mọi
    thứ ở đây là lý do để gc đi tiếp đường so nội dung hiện có, không phải lý do
    để nhả (#2300: không đo được KHÁC đo ra "sạch").
    """
    rows = gh_json(["pr", "list", "-R", C.repo, "--head", branch, "--state", "merged",
                    "--limit", "20", "--json", "mergedAt,headRefOid"], default=None)
    if not isinstance(rows, list):
        return None
    # Nhiều PR merged cùng một branch là chuyện có thật (mở lại, ship nhiều
    # vòng). Lấy cái merge SAU CÙNG: các vòng trước không mô tả HEAD hiện tại.
    best, best_at = None, ""
    for r in rows:
        if not isinstance(r, dict):
            continue
        sha, at = (r.get("headRefOid") or "").strip(), (r.get("mergedAt") or "")
        if sha and at >= best_at:
            best, best_at = sha, at
    return best


def issues_closed_by(body: str | None) -> set[int]:
    """Những issue mà thân PR này khai là sẽ ĐÓNG (#2769).

    Hàm thuần, tách khỏi phần gọi mạng để test được: đây là chỗ quyết định một
    issue có bị rút khỏi hàng đợi hay không, và sai ở đây thì hoặc là chôn việc
    thật, hoặc là mời người ta làm lại việc đã có — cả hai đều không hiện ra
    dưới dạng lỗi.
    """
    return {
        int(m.group(1))
        for m in re.finditer(rf"\b(?:{CLOSING_KEYWORDS})\s+#(\d+)\b", body or "", re.I)
    }


def issues_claimed_by_open_prs() -> dict[int, int]:
    """issue → số PR MỞ đang khai `Closes` nó (#2769).

    Vì sao cần: PR **cụm** (#2178 — skill `issue-work` khuyến khích) đóng nhiều
    issue nhưng `tal claim` chỉ giữ lease của issue CHÍNH, nên N−1 issue còn lại
    giữ nguyên `agent:ready` và ở lại `eligible` ngay sau khi PR mở. Session kế
    tiếp nhặt đúng chúng và dựng lại từ đầu.

    Vì sao đọc THÂN PR chứ không đọc tên nhánh: PR cụm mang nhánh của issue
    chính (`issue-2745`), nên tra theo `--head issue-2754` ra rỗng. Thân PR là
    chỗ DUY NHẤT ghi đủ cả nhóm — và `tal pr` đã tự chèn `Closes #N` cho cả nhóm
    vào đó, nên nguồn chân lý có sẵn, chỉ là chưa ai đọc.

    Chỉ xét PR **đang mở**: PR đóng-mà-không-merge biến mất khỏi map, nên issue
    tự quay lại hàng đợi. Không cần nhánh riêng cho ca đó, và cũng không được
    có — một PR bị bỏ mà chôn luôn issue thì tệ hơn hẳn việc làm trùng.

    `gh_json_required`, KHÔNG phải `gh_json`: đây là truy vấn quyết định "issue
    này còn việc hay không". Nuốt lỗi thành map rỗng sẽ dựng lại đúng cái bug
    đang sửa, im lặng — chính hình dạng #2151/#2152.

    `--limit 100` cắt ở trang đầu: repo có >100 PR mở thì phần dư không được
    quét. Hỏng theo chiều AN TOÀN — issue không bị nhận diện thì ở LẠI hàng đợi,
    tức cùng lắm là làm trùng, không bao giờ là chôn việc. Ngưỡng đó gấp ~20 lần
    số PR mở thường trực ở repo này; chạm trần thì phân trang, đừng nâng số.
    """
    prs = gh_json_required(
        ["pr", "list", "-R", C.repo, "--state", "open", "--limit", "100",
         "--json", "number,body"]
    )
    claimed: dict[int, int] = {}
    for p in prs:
        for n in issues_closed_by(p.get("body")):
            claimed.setdefault(n, p["number"])
    return claimed


def queue_skip_reason(names: set, has_lease: bool, closing_pr: int | None = None) -> str | None:
    """Vì sao một issue KHÔNG được nhặt, xét theo nhãn + lease. None = nhặt được.

    Tách khỏi `cmd_queue` để test được mà không cần mạng: chuỗi này quyết định
    session code làm gì tiếp theo, và một nhánh thiếu ở đây không hiện ra dưới
    dạng lỗi — nó hiện ra dưới dạng ai đó dựng lại việc đã có.
    """
    if not gate_open(names):
        return f"thiếu {L_READY} (chưa được người mở cổng)"
    if L_DEAD in names:
        return "dead-letter, chờ người"
    # #1384 — ĐÃ MERGE thì không quay lại hàng đợi nữa. Nhánh này từng thiếu, và
    # nó không tự lộ ra: `tal pr` chèn `Closes #N`, nhưng base là `dev` còn
    # default branch của repo là `main`, mà GitHub CHỈ auto-close issue khi PR
    # merge vào default branch. Nên mọi issue vòng lặp ship xong đều ở lại OPEN
    # kèm `agent:ready` — và không có dòng này thì chúng rơi thẳng về `eligible`
    # để session sau nhặt lại. Bốn cái đã như vậy cùng một lúc (#1382/#1151/
    # #1154/#1161) trước khi ai đó kịp nhìn thấy.
    if L_SHIPPED in names:
        return "đã ship (đã merge vào base), chờ người đóng issue"
    # #2769 — bản sửa đã tồn tại trong một PR ĐANG MỞ. Đặt TRƯỚC các nhãn còn
    # lại vì đây là trạng thái đo được từ GitHub, còn nhãn chỉ là ý định đã ghi
    # một lần rồi không ai đối chiếu lại. Với PR cụm thì nhãn của N−1 issue
    # KHÔNG BAO GIỜ được ghi, nên chờ nhãn là chờ một thứ không tới.
    #
    # `L_CHANGES` là NGOẠI LỆ, và thiếu nó thì bản vá này tự đào một hố sâu hơn
    # cái nó lấp (bắt ở review vòng 1 của #2769). Vòng rework LUÔN có PR mở —
    # `tal pr` chèn `Closes #N`, rework push lại cùng nhánh nên PR không đóng —
    # nên nếu không trừ ra, issue vừa bị trả về sẽ bị chôn với đúng câu "bản sửa
    # đã có, đừng làm lại", trong khi review vừa phán bản sửa CHƯA đạt.
    #
    # Và nó TỰ DUY TRÌ: không ai nhặt rework ⇒ PR mở mãi ⇒ issue chôn mãi. Đúng
    # họ với bug lịch sử ghi ở docstring `gate_open()`. `changes-requested` là
    # ưu tiên CAO NHẤT của hàng đợi (`rank`), nên biến nó thành mục bị bỏ qua là
    # đảo ngược chính xác thứ tự mà hàng đợi tồn tại để giữ.
    if closing_pr is not None and L_CHANGES not in names:
        return f"PR #{closing_pr} đang mở và khai `Closes` — bản sửa đã có, đừng làm lại"
    if L_BLOCKED in names:
        return "blocked"
    if L_REVIEWING in names or L_AWAIT in names:
        return "đang chờ review"
    if L_PASSED in names:
        return "review đạt, chờ người merge"
    if has_lease:
        return "đang có session giữ lease"
    return None


def cmd_queue(a):
    live = set(refs_all())
    items = open_issues()
    by_num = {i["number"]: i for i in items}
    claimed_by_pr = issues_claimed_by_open_prs()
    eligible, skipped = [], []

    for it in items:
        n = it["number"]
        names = {l["name"] for l in it["labels"]}
        why = queue_skip_reason(names, f"issue-{n}" in live, claimed_by_pr.get(n))
        if why is None:
            p = parent_of(n, it.get("body"))
            if p and p in by_num and group_claimable(p):
                why = f"là sub-issue của #{p}, và #{p} nhận cả nhóm — nhận cùng parent"
            elif any(f"issue-{x}" in live for x in [n] + children_of(n, it.get("body"))):
                why = "một thành viên trong nhóm đang bị giữ"
        (skipped if why else eligible).append(
            {"number": n, "title": it["title"], "labels": sorted(names),
             **({"skip": why} if why else {"rank": rank(it)})}
        )

    eligible.sort(key=lambda x: x["rank"])
    for e in eligible:
        e.pop("rank", None)
    out = {"role": "work", "repo": C.repo, "eligible": eligible,
           "skipped": skipped if a.verbose else len(skipped)}
    if a.json:
        return emit(out, True)
    if not eligible:
        print("hàng đợi rỗng — không có issue nào đủ điều kiện")
    for e in eligible[: a.limit]:
        flag = "  ⟵ SỬA THEO REVIEW" if L_CHANGES in e["labels"] else ""
        print(f"#{e['number']:<6} {e['title'][:78]}{flag}")
    if a.verbose:
        print("\n-- bỏ qua --")
        for s in skipped:
            print(f"#{s['number']:<6} {s['skip']}")
    return out


