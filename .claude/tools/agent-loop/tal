def normalize_agent_logins(raw) -> set[str]:
    """Chuẩn hoá `agentLogins` từ config thành tập so sánh được (#2762).

    Phải là HÀM, không phải biểu thức tại chỗ: bản #2760 build set bằng một
    set-comprehension ngay tại module scope, nên **không test nào với tới được
    bước đọc config** — mọi bài đều gán thẳng `tal.AGENT_LOGINS = {...}`, tức
    kiểm phép SO SÁNH mà bỏ trắng phép PHÂN GIẢI. Lỗi sống trong đúng khoảng
    trống đó: set giữ `" ecsol "` (chỉ `.lower()`) trong khi
    `pr_is_agent_authored` so `author.strip().lower()`, nên một dấu cách thừa
    trong `agent-loop.json` đẩy MỌI PR agent sang rổ `humans` — không ai dọn,
    không gì kêu.

    Chuẩn hoá cả hai đầu về cùng một dạng (`strip().lower()`) là cách duy nhất
    làm hai vế so được với nhau; sửa mỗi một đầu thì lệch lại theo chiều khác.

    Scalar string (thiếu `[]` trong JSON) từng bị iterate từng ký tự (#2768):
    `"ecsol"` → `{'c','e','l','o','s'}` → `pr_is_agent_authored("ecsol")` False
    → mọi PR agent rơi sang `humans` IM LẶNG. Bọc thành list một phần tử.
    Không từ chối: config viết nhầm vẫn phải chạy đúng — im lặng xếp sai tệ hơn
    một cảnh báo.
    """
    if raw is None:
        raw = []
    elif isinstance(raw, str):
        raw = [raw]
    elif isinstance(raw, (bytes, bytearray)):
        raw = [raw.decode()]
    elif not isinstance(raw, (list, tuple, set)):
        print(f"  ⚠️ agentLogins phải là list hoặc string, nhận {type(raw).__name__} "
              f"— bỏ qua (không iterate keys/ký tự)", file=sys.stderr)
        raw = []
    return {
        s
        for s in (str(x).strip().lower() for x in raw if x is not None)
        if s
    }


AGENT_LOGINS = normalize_agent_logins(_CFG.get("agentLogins"))


def pr_is_agent_authored(author: str | None) -> bool:
    """PR không-có-sổ này là của AGENT (mồ côi thật) hay của NGƯỜI? (#2760)

    Tách thành hàm thuần để test được CẢ HAI chiều — rào chỉ biết kêu mà không
    chứng minh được nó biết IM thì sẽ bị tắt, và lúc đó mất luôn phần canh đúng.

    `AGENT_LOGINS` rỗng ⇒ trả True cho mọi tác giả, tức giữ nguyên hành vi
    trước #2760. Repo chưa khai `agentLogins` không tự dưng đổi cách chạy.
    """
    if not AGENT_LOGINS:
        return True

    return (author or "").strip().lower() in AGENT_LOGINS

