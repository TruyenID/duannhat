def set_state_labels(issue: int, desired: set[str], drop: set[str] | None = None,
                     preserve: set[str] | None = None):
    """Ghi trọn bộ nhãn MANAGED, giữ nguyên phần không-managed.

    #2300 — hai sửa: (a) GET nhãn hỏng thì BỎ lần ghi này (trước đây `default=[]`
    làm PUT trên danh sách rỗng giả — một cú API chớp là mất sạch `critical`/
    `agent:ready`/… của issue); (b) `preserve`: nhãn MANAGED được GIỮ nếu đang
    gắn — claim dùng nó để không quét `agent:review-passed`/`awaiting-review`
    (trạng thái review chỉ được tháo ở `tal pr` khi có bản push mới)."""
    p = gh(["api", f"repos/{C.repo}/issues/{issue}", "-q", "[.labels[].name]"], check=False)
    if p is None or getattr(p, "returncode", 1) != 0 or not (p.stdout or "").strip():
        warn(f"không đọc được nhãn của #{issue} — BỎ lần ghi nhãn này "
             "(PUT trên danh sách rỗng giả sẽ xoá sạch nhãn không-managed)")
        return
    try:
        cur = json.loads(p.stdout.strip())
    except json.JSONDecodeError:
        warn(f"nhãn của #{issue} trả JSON hỏng — BỎ lần ghi nhãn này")
        return
    drop = drop or set()
    preserve = preserve or set()
    keep = [x for x in cur
            if (x not in MANAGED or x in preserve) and x not in drop]
    final = sorted(set(keep) | desired)
    if sorted(cur) == final:
        return
    payload = json.dumps({"labels": final})
    gh(
        ["api", f"repos/{C.repo}/issues/{issue}/labels", "-X", "PUT", "--input", "-"],
        stdin=payload,
    )


# ─────────────────────────────────────────────────────────────────────────────
# Nhóm issue: parent + sub-issue (API sub_issues, `Parent: #N`, task-list)
# ─────────────────────────────────────────────────────────────────────────────

PARENT_RE = re.compile(r"^\s*(?:parent|thuộc|part of)\s*[::]\s*#(\d+)", re.I | re.M)
TASK_RE = re.compile(r"^\s*[-*]\s*\[[ xX]\]\s*#(\d+)", re.M)


def issue_data(n: int) -> dict:
    d = gh_json(
        ["api", f"repos/{C.repo}/issues/{n}",
         "-q", "{number,title,body,state,labels:[.labels[].name],pull_request:(.pull_request!=null)}"],
        default=None,
    )
    if d is None:
        raise Fail(f"không đọc được issue #{n}")
    return d


def parent_of(n: int, body: str | None = None) -> int | None:
    api = gh_json(["api", f"repos/{C.repo}/issues/{n}/parent"], default=None)
    if isinstance(api, dict) and api.get("number"):
        return api["number"]
    if body is None:
        body = issue_data(n).get("body") or ""
    m = PARENT_RE.search(body or "")
    return int(m.group(1)) if m else None


def children_of(n: int, body: str | None = None) -> list[int]:
    kids: list[int] = []
    api = gh_json(["api", f"repos/{C.repo}/issues/{n}/sub_issues", "--paginate"], default=[])
    if isinstance(api, list):
        kids += [c["number"] for c in api if c.get("number")]
    if body is None:
        body = issue_data(n).get("body") or ""
    kids += [int(x) for x in TASK_RE.findall(body or "")]
    seen, out = set(), []
    for k in kids:
        if k != n and k not in seen:
            seen.add(k)
            out.append(k)
    return out


def group_claimable(n: int) -> bool:
    """Parent có tự nhận cả nhóm được không.

    Parent mở cổng `ready` = "làm cả cụm trong một branch". Parent KHÔNG mở cổng thì nó là
    một tracker: việc thật nằm ở các sub-issue, mỗi cái tự nhận với branch issue-<số của
    nó>. Không phân biệt hai vai này thì chia tầng thành vô nghĩa — mọi sub-issue bị gom
    lại về đúng một branch của parent."""
    names = set(issue_data(n)["labels"])
    return gate_open(names) and not ({L_BLOCKED, L_DEAD} & names)


def gate_open(names: set) -> bool:
    """Cổng "người cho phép bot nhặt" đã mở chưa.

    `agent:ready` là cách người mở cổng. `agent:changes-requested` cũng tính —
    và đó là toàn bộ nội dung #1515.

    Vì sao: nhãn đó CHỈ do `review-verdict` gắn, tức issue đã từng đi qua cổng
    `ready` một lần rồi (không claim được thì không có PR, không có PR thì không
    có review). Đòi người mở cổng LẦN NỮA cho một vòng sửa là bắt người phê
    duyệt lại thứ họ đã phê duyệt.

    Mâu thuẫn cũ đo được: `tal status` xếp `changes-requested` là **ưu tiên cao
    nhất**, `tal queue` thì không liệt kê nó, và `tal claim` từ chối thẳng — nên
    điểm blocking của review kẹt lại, không session nào nhặt được mà không
    `--force`, trong khi skill `issue-work` cấm `--force` để vượt cổng. Đúng thứ
    vòng lặp sinh ra để làm thì lại là thứ duy nhất nó không làm được.
    """
    return bool({L_READY, L_CHANGES} & names)


def resolve_group(n: int) -> tuple[int, list[int]]:
    """→ (issue chính, cả nhóm).

    Chỉ leo lên parent khi parent thật sự nhận-cả-nhóm được (xem group_claimable).
    Parent là tracker → sub-issue đứng một mình, branch riêng theo số của chính nó."""
    d = issue_data(n)
    p = parent_of(n, d.get("body"))
    root = n
    hops = 0
    while p and hops < 5 and group_claimable(p):
        root = p
        p = parent_of(root)
        hops += 1
    if root == n and not group_claimable(n):
        return n, [n]          # tự nó chưa mở cổng: --force sẽ nhận lẻ, không gom con
    kids = [k for k in children_of(root)
            if issue_data(k)["state"] == "open" and not group_claimable(k)]
    return root, [root] + kids


