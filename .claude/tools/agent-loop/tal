class Fail(Exception):
    """Lỗi có thông điệp cho người đọc; exit code mang ý nghĩa."""

    def __init__(self, msg: str, code: int = 1):
        super().__init__(msg)
        self.code = code


BUSY = 75  # EX_TEMPFAIL — "người khác đang giữ", không phải lỗi


class Gone(Fail):
    """#2300 — "đối tượng KHÔNG TỒN TẠI (404 thật)" phải là một loại lỗi KHÁC
    "không đo được". reap từng gộp hai cái: quota cạn ⇒ `pr_issue` Fail ⇒ bị đọc
    thành "PR không còn" ⇒ xoá ref lease review đang SỐNG."""


def run(cmd: list[str], cwd: str | None = None, check: bool = True, stdin: str | None = None):
    # GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE ĐÈ cả `-C` và cwd. Nếu tal được gọi từ trong
    # một git hook, các biến này bị kế thừa và mọi lệnh git ở đây sẽ chạy sai repo —
    # đúng cái bẫy đã làm .githooks/pre-commit báo pointer đã push là dangling.
    env = {k: v for k, v in os.environ.items()
           if k not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")}
    p = subprocess.run(
        cmd, cwd=cwd, input=stdin, capture_output=True, text=True, env=env
    )
    if check and p.returncode != 0:
        raise Fail(f"lệnh thất bại: {' '.join(cmd)}\n{p.stderr.strip() or p.stdout.strip()}")
    return p


def gh(args: list[str], check: bool = True, stdin: str | None = None):
    return run(["gh"] + args, check=check, stdin=stdin)


def gh_json_required(args: list[str]):
    """Như `gh_json` nhưng KHÔNG có đường im lặng — thất bại thì RAISE.

    Dùng cho các truy vấn **khám phá việc**, nơi một danh sách RỖNG là câu trả
    lời mang nghĩa: "không còn gì để làm". `gh_json` trả `default` cho MỌI thất
    bại (điều kiện thật là `returncode != 0`, không phải 404/422 như docstring
    của nó nói), nên chỗ gọi không phân biệt được **"đo được, không có gì"** với
    **"không đo được"** — rồi in ra câu trấn an kèm exit 0.

    Đó là #2151, tái hiện được: khi hạn mức GraphQL cạn, `tal queue` in
    "hàng đợi rỗng — không có issue nào đủ điều kiện" và thoát 0, trong khi ba
    issue `agent:ready` vẫn đang mở (đo lại qua REST).

    Nó nói dối theo hướng ĐÁNG TIN NHẤT: skill `issue-work` dạy "hàng đợi rỗng →
    nói rõ, kết thúc lượt", nên một session làm ĐÚNG LUẬT sẽ báo hết việc trong
    khi backlog vẫn đầy. Một `/loop` chạy nền thì idle im lặng qua mọi lần cạn
    quota.

    Hình dạng này đã được ghi ra một lần ở docblock `Ctx` ("`gh` lỗi,
    `gh_json(default=[])` nuốt lỗi thành sổ trắng") nhưng chỉ cho một ngữ cảnh.
    Đây là chỗ tổng quát hoá nó cho ba hàng đợi.
    """
    p = gh(args, check=False)
    if p.returncode != 0:
        detail = (p.stderr or "").strip() or (p.stdout or "").strip() or f"gh thoát {p.returncode}"
        raise Fail(
            "KHÔNG ĐO ĐƯỢC hàng đợi — truy vấn GitHub thất bại, nên KHÔNG kết luận "
            "được là hết việc.\n"
            f"  lệnh: gh {' '.join(args)}\n"
            f"  lỗi:  {detail}\n"
            "Hay gặp nhất: cạn hạn mức API (`gh api rate_limit --jq .resources`)."
        )

    out = p.stdout.strip()
    if not out:
        # `gh … --json` thành công luôn in ít nhất `[]`. Rỗng ở đây là bất thường,
        # và im lặng coi nó là "không có gì" chính là lỗi đang sửa.
        raise Fail(f"KHÔNG ĐO ĐƯỢC hàng đợi — `gh {' '.join(args)}` trả về rỗng dù thoát 0.")

    try:
        return json.loads(out)
    except json.JSONDecodeError as e:
        raise Fail(f"KHÔNG ĐO ĐƯỢC hàng đợi — `gh {' '.join(args)}` trả JSON hỏng: {e}")


def gh_json(args: list[str], default=None):
    """Không bao giờ raise — 404/422 trả `default`. Người gọi tự quyết coi None là lỗi hay không.

    #2300 — CHỈ dành cho đường mà "không đọc được" và "không có" dẫn tới CÙNG một
    hành vi an toàn (no-op). Đường nào dùng kết quả để QUYẾT ĐỊNH PHÁ HUỶ (xoá ref,
    xoá worktree, ghi đè nhãn, kết luận hết việc) phải đi `gh_json_strict`/
    `gh_json_required` — nuốt lỗi ở đó là nguồn của cả họ bug #2151/#2152."""
    p = gh(args, check=False)
    if p.returncode != 0:
        return default
    out = p.stdout.strip()
    if not out:
        return default
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return default


def _json_pages(text: str):
    """`gh api --paginate` KHÔNG gộp trang: >100 phần tử là nhiều mảng JSON nối nhau,
    `json.loads` chết ⇒ trước #2300 chỗ nào bọc `gh_json(default=[])` sẽ âm thầm coi
    một issue nhiều comment là KHÔNG có sổ. Ghép mọi trang thành một list."""
    dec = json.JSONDecoder()
    idx, n, out = 0, len(text), []
    while idx < n:
        while idx < n and text[idx] in " \t\r\n":
            idx += 1
        if idx >= n:
            break
        obj, end = dec.raw_decode(text, idx)
        out.extend(obj if isinstance(obj, list) else [obj])
        idx = end
    return out


def gh_json_strict(args: list[str], what: str):
    """Đường ĐO ĐẠC cho quyết định có hệ quả: API hỏng ⇒ RAISE, không bao giờ trả
    'rỗng' thay cho 'không đo được' (#2300, tổng quát hoá #2151). Chịu được
    --paginate nhiều trang."""
    p = gh(args, check=False)
    if p is None or getattr(p, "returncode", 0) != 0:
        detail = "" if p is None else ((getattr(p, "stderr", "") or "").strip()
                                       or (getattr(p, "stdout", "") or "").strip())
        detail = detail or (f"gh thoát {p.returncode}" if p is not None else "gh không chạy")
        raise Fail(f"KHÔNG ĐO ĐƯỢC {what} — gh {' '.join(args[:4])}… thất bại:\n  {detail}\n"
                   "Đừng hành động như thể kết quả là rỗng; thử lại khi API lành.")
    out = p.stdout.strip()
    if not out:
        return []
    try:
        return _json_pages(out)
    except (json.JSONDecodeError, ValueError) as e:
        raise Fail(f"KHÔNG ĐO ĐƯỢC {what} — JSON hỏng từ gh: {e}")


def now() -> datetime:
    return datetime.now(timezone.utc)


def iso(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s: str) -> datetime:
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


def human_delta(sec: float) -> str:
    sec = int(sec)
    sign = "-" if sec < 0 else ""
    sec = abs(sec)
    if sec < 60:
        return f"{sign}{sec}s"
    if sec < 3600:
        return f"{sign}{sec // 60}m"
    return f"{sign}{sec // 3600}h{(sec % 3600) // 60:02d}m"


def emit(obj, as_json: bool):
    if as_json:
        print(json.dumps(obj, ensure_ascii=False, indent=2))
    return obj


def warn(msg: str):
    print(f"[tal] {msg}", file=sys.stderr)


