            "delete": {
                "tags": [
                    "Me - Notifications"
                ],
                "summary": "GDPR right-to-be-forgotten — wipe own inbox",
                "description": "GDPR right-to-be-forgotten endpoint (issue #179 part C).\n\nPurges every NotificationRecipient row addressed to the caller plus\nthe cascading NotificationDelivery children. Other recipients of the\nsame parent Notification are NOT affected — a stock alert sent to 5\nmanagers stays visible to the other 4 if one purges their inbox.\n\nIdempotent — second call returns count=0. Always 200, never 204, so\nthe count is observable to the caller (UI can confirm \"wiped 87 rows\").",
                "operationId": "0089efc33a2dfb0d6e0392553a6891a6",
                "responses": {
                    "200": {
                        "description": "Wiped count",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "wiped_count": {
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
