APP_NAME=Laravel
APP_ENV=local
APP_KEY=

# Absolute server-only path outside the repository/web root; see plan-047 secret-store runbook.
# REQUIRED for "Xác minh kết nối" / "Luân chuyển thông tin xác thực" on the HQ
# payment screen — with it empty both buttons fail (500 / 503). Create the file
# with `php artisan payments:generate-gateway-keyring --path=<abs path>`; the key
# is independent of APP_KEY, so back it up — losing it makes every stored gateway
# secret undecryptable. Docker stack: /var/keyring/payment-gateway-keyring.json
PAYMENT_GATEWAY_KEYRING_PATH=
APP_DEBUG=true
APP_URL=http://localhost
SERVER_PORT=5400

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_DEFAULT_BRANCH_TIMEZONE=Asia/Tokyo
# Nhịp của scheduled job (giờ head-office). KHÔNG phải nguồn business time —
# mọi quyết định theo ngày nghiệp vụ phải đi qua BusinessClock::forBranch().
# Set TƯỜNG MINH: bỏ trống thì config/app.php fallback vào
# APP_DEFAULT_BRANCH_TIMEZONE, nên đổi timezone chi nhánh mặc định sẽ vô tình
# dịch nhịp cron theo (#1161).
APP_OPERATIONS_TIMEZONE=Asia/Tokyo
# Fallback HQ timezone by organization operating_country. The branch timezone
# still wins; these only cover missing/invalid branch data (#2838).
APP_OPERATIONS_TIMEZONE_JP=Asia/Tokyo
APP_OPERATIONS_TIMEZONE_VN=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
# Giữ 14 ngày. `single` không bao giờ xoay: production chạy 1 tháng ra file 175MB.
LOG_DAILY_DAYS=14

# Mức log của channel bằng chứng vận hành (plan-055 Gate 6). TÁCH khỏi LOG_LEVEL
# toàn cục có chủ đích: điều kiện ra của Gate 6 là đếm hai dòng warning về 0, nên
# siết LOG_LEVEL=error sẽ làm phép đếm ra 0 vì KHÔNG GHI — xanh vì im lặng (#1871).
PAYMENT_ORCHESTRATION_LOG_LEVEL=info

# #1806 S4 — ban phat hanh may tram ma HQ mong doi. DE TRONG = khong canh bao gi
# (fail-safe: mot quan mat duong toi HQ van phai ban duoc hang). Muc nghiem trong
# do NOI DUNG ban va quyet dinh, khong phai khoang cach phien ban.
WORKSTATION_EXPECTED_VERSION=
WORKSTATION_EXPECTED_SEVERITY=info
WORKSTATION_EXPECTED_REASON=
# Đường ĐỌC manifest phát hành máy trạm. Trống = public/downloads/workstation/
# manifest.json (mặc định sản xuất). Chỉ đặt khi phục vụ catalog từ nơi khác;
# test dùng nó để khỏi ghi vào file đang track (#2428).
WORKSTATION_DOWNLOADS_MANIFEST_PATH=
# Trang tải máy trạm nay là một trang Next trên admin-web; `GET /downloads` ở
# backend chỉ 301 tới đây. URL ĐẦY ĐỦ, ví dụ https://tempo.godx.jp/downloads.
# Trống = route trả 503 kèm đường dẫn file trực tiếp — KHÔNG đoán một domain,
# vì 301 sai thì trình duyệt nhớ rất lâu. File binary không đổi chỗ.
WORKSTATION_DOWNLOADS_PAGE_URL=

# Ngày (YYYY-MM-DD) xác nhận MỌI workstation đã lên build sau cutover. Để trống
# = chưa xác nhận, và cổng gỡ shim PaymentStatusCompatibility sẽ không bao giờ
# báo DELETE NOW (#1822). Vế này không đo được từ Cloud — workstation phát tán
# thủ công, không có tự cập nhật.
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dxs_product
DB_USERNAME=root
DB_PASSWORD=password

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# #2893 — the Stripe account STRIPE_SECRET authenticates as (acct_…). Platform
# webhooks (events with no `account` field) are attributed to the connection
# carrying this id, and that connection is called WITHOUT a Stripe-Account
# header. Empty = pre-#2893 behaviour (synthetic fallback connection).
STRIPE_ACCOUNT_ID=
# #815 — the charge currency is resolved per-order from the branch's
# shop_order_settings.currency_code. This value is ONLY the fallback for a branch
# with no currency configured; it never overrides the branch currency.
STRIPE_CURRENCY=jpy
# Master kill-switch for live Stripe card refunds. Default false: real card
# refunds are blocked (403) until explicitly enabled. Cash refunds unaffected.
STRIPE_LIVE_REFUNDS_ENABLED=false
# PayPay OPA PreAuth & Capture (godx-jp/paypayopa-php-sdk; see docs/guide/payment-gateway-paypay-certification.md).
# Which PayPay host the SDK talks to: sandbox | test | live. EXPLICIT on purpose,
# never derived from APP_ENV — PayPay keys carry no live/test marker, so
# APP_ENV=production while holding sandbox credentials (the normal posture during
# a pilot) would otherwise call the LIVE endpoint with sandbox keys. Refused as
# `live` outside production. Omitting it means sandbox.
PAYPAY_ENVIRONMENT=sandbox
PAYPAY_API_KEY=
PAYPAY_API_SECRET=
PAYPAY_MERCHANT_ID=
# Optional — HMAC simulation in tests/local only. Live OPA webhooks verify PayPay source IPs.
PAYPAY_WEBHOOK_SECRET=
# TEMPORARY hubsupport egress proxy (remove after PayPay allowlists Tempo IP).
PAYPAY_EGRESS_PROXY_URL=
PAYPAY_EGRESS_PROXY_TOKEN=
# Per-refund ceiling for a single card refund (order-currency, minor-unit-agnostic).
MAX_CARD_REFUND_AMOUNT=1000000

# Plan-047 orchestrator routing (default ON — single payment path via PaymentOrchestrator).
# Set PAYMENT_ORCHESTRATOR_RUNTIME=false to roll back to direct ledger writes.
# plan-055 — require gateway_option_id on every payment (422 POLICY_OPTION_REQUIRED).
# Leave false until every branch has a policy revision AND >=1 effective option,
# and until the offline-replay boundary is resolved: enabling early refuses money
# already in the till. See docs/guide/payment-go-live.md.
PAYMENT_POLICY_ENFORCEMENT_REQUIRED=false
PAYMENT_ORCHESTRATOR_RUNTIME=true
PAYMENT_ORCHESTRATOR_TRANSPORTS=pos,kiosk,workstation,customer_web
PAYMENT_ORCHESTRATOR_TRANSPORT_POS=true
PAYMENT_ORCHESTRATOR_TRANSPORT_KIOSK=true
PAYMENT_ORCHESTRATOR_TRANSPORT_WORKSTATION=true
PAYMENT_ORCHESTRATOR_TRANSPORT_CUSTOMER_WEB=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Reverb bootstrap creds — fallback for brands with null reverb_app_id (dev only).
# Prod brands use their own per-brand creds provisioned on Brand::created.
REVERB_APP_ID=bootstrap
REVERB_APP_KEY=bootstrap-key
REVERB_APP_SECRET=bootstrap-secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

# Driver swap — flip BROADCAST_CONNECTION to `pusher` or `ably` and fill in
# matching creds. No code changes required (issue #103).
#
# Pusher (shared account, scoped via channel name `user.{id}.notifications`):
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
#
# Ably (shared account):
# ABLY_KEY=

# Framework default disk. `local` is private (storage/app/private) — correct for
# internal artifacts, WRONG for anything a browser must fetch.
FILESYSTEM_DISK=local
# Where user uploads go. Must stay publicly servable — see config/filesystems.php
# and #2101, where UPLOADS_DISK riding FILESYSTEM_DISK 404'd every product image
# in production without logging a thing.
UPLOADS_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# plan-023 M4 — inbound mail webhook driver. Default `postmark`; SES /
# Mailgun / SendGrid are additive (register a driver implementing
# MailWebhookContract from a service provider, then flip this var).
MAIL_WEBHOOK_DRIVER=postmark

# HMAC secret used to verify Postmark's X-Postmark-Signature header on
# inbound webhook posts. Generated in the Postmark dashboard:
#   Server → Settings → Webhooks → Webhook validation token.
# Leave blank in local-only dev — EmailChannel still works, only the
# /api/v1/webhooks/mail/postmark endpoint is gated.
POSTMARK_WEBHOOK_SECRET=

# plan-023 M7 — workflow rule engine. When false (default), matched
# rules log shadow firings without dispatching; flip to true after the
# `notifications:rule-shadow-compare` parity report comes back clean.
NOTIFICATION_USE_RULES=false

# plan-023 M8 — device offline detection (T8.4).
# NOTIFICATION_DEVICE_OFFLINE_THRESHOLD_MINUTES: silence window before a
#   device is considered offline (default 15 min). DeviceOfflineDetectionJob
#   runs every 5 minutes and queries devices with last_seen_at older than now
#   minus this threshold.
# NOTIFICATION_DEVICE_OFFLINE_COOLDOWN_MINUTES: minimum gap between repeat
#   offline notifications for the same device (default 60 min). Prevents
#   notification floods during prolonged outages.
NOTIFICATION_DEVICE_OFFLINE_THRESHOLD_MINUTES=15
NOTIFICATION_DEVICE_OFFLINE_COOLDOWN_MINUTES=60

# plan-023 M8 — coupon expiration scanner (T8.5).
# HH:MM in Asia/Tokyo timezone. CouponExpirationScannerJob dispatches two
# notification passes: one for coupons expiring within 72 h (custom.coupon.expiring)
# and one for coupons that expired within the last 28 h (custom.coupon.expired).
NOTIFICATION_COUPON_SCAN_TIME=08:00

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Customer Web — nơi trả khách về sau khi bấm link xác nhận email (#1680).
# Bỏ trống thì `GET /customer/auth/verify/...` trả JSON thay vì chuyển hướng;
# KHÔNG đặt mặc định localhost, một URL sai mà "chạy được" sẽ lặng lẽ đưa khách
# thật ra ngoài hệ thống. Xem docs/guide/customer-email-verification.md.
CUSTOMER_WEB_URL=

# Platform SSO — Authorization Code + PKCE through the Laravel BFF.
SSO_ISSUER=https://platform.test
SSO_PUBLIC_URL=https://tempo-web.test
SSO_SERVICE_SLUG=tempo-local
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:5430/auth/callback
SSO_ORGANIZATION_CONTEXT_ID=
SSO_ALLOW_ORGANIZATION_SWITCHING=true
SSO_AFTER_LOGIN=/select-context
SSO_AFTER_LOGOUT=/login
SSO_FAILURE_REDIRECT=/login
SSO_FAILURE_QUERY_PARAMETER=error
SSO_TOKEN_COOKIE=token
SSO_REFRESH_ENABLED=true

# Platform authorization catalog sync (`php artisan dxs:sync-authz`).
SSO_SERVICE_ID=tempo
SSO_ADMIN_TOKEN=
SSO_SYNC_AUTHZ_AUTO=false
