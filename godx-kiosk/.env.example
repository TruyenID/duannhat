# TempoFast Kiosk App — Environment Variables
# Copy to .env and fill in values:
#   cp .env.example .env

# API base URL (backend server)
EXPO_PUBLIC_API_URL=http://localhost:5400

# =========================================================================
# Sentry — error tracking + lifecycle audit (PCI Req 10.2)
# =========================================================================
# DSN identifies the Sentry project. NOT a server secret (it just lets
# anyone write to the project; standard public client identifier per
# Sentry docs). Unset = SDK is a no-op + no events ship.
#
# Each restaurant deploys the kiosk independently — one DSN per
# environment tier (dev / staging / prod), NOT per restaurant, so the
# Sentry dashboard stays manageable. Use the `environment` tag below
# to separate.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry environment tag (dev / staging / prod). Falls back to
# NODE_ENV when unset.
EXPO_PUBLIC_SENTRY_ENV=

# Release identifier — set at CI build time (e.g. git SHA + Expo build
# number) so Sentry can attach the right source map.
EXPO_PUBLIC_RELEASE=
